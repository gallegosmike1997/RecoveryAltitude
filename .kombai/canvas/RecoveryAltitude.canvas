      "html": "<style>\n    body { background-color: #fbfaf2; }\n</style>\n<div class=\"relative mx-auto aspect-square w-full max-w-[768px] overflow-hidden bg-[#fbfaf2]\" data-kid=\"1\" data-name=\"image container\">\n    <img alt=\"Recovery Altitude concept logo\" class=\"block h-full w-full object-contain\" data-kid=\"1-1\" data-name=\"recovery altitude concept logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/.kombai/canvas/assets/46e0ab9b748cbb2216d689a6ff64efa3e9c519ebdac355d9316e40df16a013c1.jpg\"/>\n</div>\n",
