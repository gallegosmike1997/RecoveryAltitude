      },
      "html": "<style>\n  :root{\n    --bg: #f5f2ea;\n    --surface: #ffffff;\n    --surface-2: #efece3;\n    --ink: #1b2624;\n    --muted: #64726d;\n    --line: #e1ddd0;\n\n    --teal-900: #142f2d;\n    --teal-800: #1c433f;\n    --teal-700: #245550;\n    --teal-500: #4c8177;\n    --teal-300: #9dc2b7;\n    --teal-100: #e2ede9;\n\n    --accent: #e07a3f;\n    --accent-soft: #fbe9d2;\n\n    --radius-lg: 20px;\n    --radius-md: 14px;\n    --radius-sm: 10px;\n    --radius-round: 999px;\n\n    --ease-out: cubic-bezier(0.16,1,0.3,1);\n    --shadow-lift: 0 18px 32px -18px rgba(20,47,45,0.35);\n\n    --font: -apple-system, \"SF Pro Text\", BlinkMacSystemFont, \"Segoe UI\", system-ui, sans-serif;\n  }\n\n  *,*::before,*::after{ box-sizing: border-box; }\n  html,body{ margin:0; padding:0; }\n  body{\n    font-family: var(--font);\n    background: var(--bg);\n    color: var(--ink);\n    -webkit-font-smoothing: antialiased;\n    overflow-x: hidden;\n  }\n  img{ max-width:100%; display:block; }\n  a{ color: inherit; text-decoration:none; }\n  button{ font-family: inherit; cursor:pointer; }\n  ul{ list-style:none; margin:0; padding:0; }\n  svg{ display:block; flex-shrink:0; }\n\n  /* ---------- Header ---------- */\n  .topbar{\n    display:flex;\n    align-items:center;\n    gap:28px;\n    padding: 16px 32px;\n    background: var(--bg);\n    border-bottom: 1px solid var(--line);\n  }\n  .brand{\n    display:flex;\n    align-items:center;\n    gap:10px;\n    font-size: 1.4rem;\n    font-weight: 800;\n    color: var(--teal-900);\n    letter-spacing: -0.02em;\n    white-space: nowrap;\n  }\n  .brand .mark{\n    width: 34px; height:34px;\n    border-radius: 9px;\n    background: var(--teal-800);\n    display:flex; align-items:center; justify-content:center;\n  }\n\n  .mode-select{\n    display:flex; align-items:center; gap:6px;\n    padding: 10px 12px;\n    border-radius: var(--radius-round);\n    border: 1px solid var(--line);\n    background: var(--surface);\n    color: var(--ink);\n  }\n\n  .search{\n    flex:1;\n    max-width: 420px;\n    display:flex;\n    align-items:center;\n    gap:10px;\n    padding: 11px 18px;\n    background: var(--surface);\n    border: 1px solid var(--line);\n    border-radius: var(--radius-round);\n    color: var(--muted);\n    font-size: 0.95rem;\n  }\n\n  .nav-links{\n    display:flex;\n    align-items:center;\n    gap:26px;\n    font-weight: 600;\n    font-size: 0.98rem;\n    color: var(--ink);\n    margin-left: 6px;\n  }\n  .nav-links a{ display:flex; align-items:center; gap:4px; }\n  .nav-links a:hover{ color: var(--teal-700); }\n\n  .spacer{ flex:1; }\n\n  .btn-new{\n    display:flex; align-items:center; gap:8px;\n    background: var(--teal-800);\n    color:#fff;\n    font-weight:700;\n    padding: 11px 18px;\n    border-radius: var(--radius-round);\n    border:none;\n    font-size:0.95rem;\n    transition: background 0.2s var(--ease-out), transform 0.2s var(--ease-out);\n  }\n  .btn-new:hover{ background: var(--teal-900); }\n  .btn-new:active{ transform: translateY(1px); }\n\n  .icon-btn{\n    width:40px; height:40px;\n    border-radius:50%;\n    display:flex; align-items:center; justify-content:center;\n    background: transparent;\n    border:none;\n    position:relative;\n  }\n  .icon-btn .dot{\n    position:absolute; top:8px; right:9px;\n    width:7px; height:7px; border-radius:50%;\n    background: var(--accent);\n    border: 2px solid var(--bg);\n  }\n\n  .avatar-chip{\n    display:flex; align-items:center; gap:6px;\n  }\n  .avatar-sm{\n    width:34px; height:34px; border-radius:50%;\n    background: linear-gradient(135deg,var(--teal-500),var(--teal-800));\n  }\n\n  /* ---------- Layout ---------- */\n  .layout{\n    display:grid;\n    grid-template-columns: 300px 1fr;\n    gap: 40px;\n    max-width: 1440px;\n    margin: 0 auto;\n    padding: 40px 32px 64px;\n  }\n\n  @media (max-width: 900px){\n    .layout{ grid-template-columns: 1fr; }\n  }\n\n  /* ---------- Sidebar ---------- */\n  .profile-card{ position:relative; }\n\n  .avatar-wrap{ position:relative; width:96px; height:96px; margin-bottom:20px; }\n  .avatar-lg{\n    width:96px; height:96px; border-radius:50%;\n    background: linear-gradient(135deg, var(--teal-300), var(--teal-700));\n    box-shadow: 0 0 0 4px var(--surface);\n  }\n  .avatar-edit{\n    position:absolute; bottom:0; right:-2px;\n    width:30px; height:30px; border-radius:50%;\n    background: var(--surface);\n    border: 1px solid var(--line);\n    display:flex; align-items:center; justify-content:center;\n  }\n\n  .display-name{\n    display:flex; align-items:center; gap:8px;\n    font-size: 1.7rem;\n    font-weight: 800;\n    letter-spacing: -0.02em;\n    margin: 0 0 8px;\n  }\n  .badge-verified{\n    width:20px; height:20px; border-radius:6px;\n    background: var(--accent);\n    display:flex; align-items:center; justify-content:center;\n    flex-shrink:0;\n  }\n  .edit-pencil{ margin-left:auto; opacity:0.55; }\n\n  .bio{ color: var(--ink); font-size: 1rem; margin: 0 0 10px; }\n\n  .site-link{\n    display:flex; align-items:center; gap:6px;\n    color: var(--accent);\n    font-weight:600;\n    font-size: 0.95rem;\n    margin-bottom: 18px;\n  }\n\n  .stats-row{\n    display:flex;\n    align-items:center;\n    gap: 26px;\n    margin-bottom: 18px;\n  }\n  .stat-block{ display:flex; flex-direction:column; gap:2px; }\n  .stat-block .label{ font-size:0.85rem; color: var(--muted); }\n  .stat-block .value{ font-size:1.15rem; font-weight:800; }\n  .stat-search{\n    margin-left:auto;\n    width:44px; height:44px;\n    border-radius: var(--radius-md);\n    background: var(--surface-2);\n    border:none;\n    display:flex; align-items:center; justify-content:center;\n  }\n\n  .streak-card{\n    display:flex;\n    gap:14px;\n    align-items:flex-start;\n    background: var(--accent-soft);\n    border-radius: var(--radius-md);\n    padding: 16px 18px;\n    margin-bottom: 24px;\n  }\n  .streak-icon{\n    width:34px; height:34px; border-radius:50%;\n    background: var(--accent);\n    display:flex; align-items:center; justify-content:center;\n    flex-shrink:0;\n  }\n  .streak-card h4{ margin:0 0 4px; font-size:1rem; font-weight:800; }\n  .streak-card p{ margin:0; font-size:0.9rem; color: var(--ink); opacity:0.85; line-height:1.4; }\n\n  .nav-list{ display:flex; flex-direction:column; gap:6px; margin-bottom:34px; }\n  .nav-row{\n    display:flex; align-items:center; gap:14px;\n    padding: 14px 16px;\n    border-radius: var(--radius-md);\n    background: var(--surface-2);\n    font-weight: 700;\n    font-size: 0.98rem;\n    cursor:pointer;\n    transition: background 0.2s var(--ease-out), transform 0.2s var(--ease-out);\n  }\n  .nav-row:hover{ background: var(--teal-100); }\n  .nav-row:active{ transform: scale(0.99); }\n  .nav-row.active{ background: var(--teal-100); color: var(--teal-900); }\n  .nav-row .row-icon{ display:flex; align-items:center; justify-content:center; width:20px; }\n  .nav-row .count{ margin-left:auto; margin-right:8px; color: var(--muted); font-weight:700; }\n  .nav-row.active .count{ color: var(--teal-800); }\n\n  .section-title{ font-size:1.4rem; font-weight:800; margin: 0 0 16px; letter-spacing:-0.01em; }\n\n  .stat-preview{\n    border-radius: var(--radius-md);\n    background: linear-gradient(160deg, var(--teal-700), var(--teal-900));\n    padding: 18px;\n    color:#fff;\n    position:relative;\n    overflow:hidden;\n    height:120px;\n  }\n  .stat-preview .chart{\n    position:absolute; left:18px; right:18px; bottom:18px; top:52px;\n    display:flex; align-items:flex-end; gap:8px;\n  }\n  .stat-preview .chart span{\n    flex:1; background: rgba(255,255,255,0.35); border-radius:4px 4px 0 0;\n  }\n  .stat-preview .chart span:nth-child(1){ height:40%; }\n  .stat-preview .chart span:nth-child(2){ height:70%; }\n  .stat-preview .chart span:nth-child(3){ height:55%; }\n  .stat-preview .chart span:nth-child(4){ height:90%; background:#fff; }\n  .stat-preview .chart span:nth-child(5){ height:35%; }\n  .stat-preview .chart span:nth-child(6){ height:60%; }\n  .stat-preview .label-sm{ font-size:0.85rem; font-weight:700; opacity:0.9; }\n\n  /* ---------- Main content ---------- */\n  .main-head{\n    display:flex; align-items:center; gap:14px;\n    margin-bottom: 22px;\n  }\n  .back-btn{\n    width:40px; height:40px; border-radius:50%;\n    background: var(--surface);\n    border: 1px solid var(--line);\n    display:flex; align-items:center; justify-content:center;\n  }\n  .main-head h1{ font-size: 2rem; font-weight:800; margin:0; letter-spacing:-0.02em; }\n\n  .tabs{ display:flex; gap:12px; margin-bottom: 22px; flex-wrap:wrap; }\n  .tab{\n    display:flex; align-items:center; gap:10px;\n    padding: 12px 18px;\n    border-radius: var(--radius-round);\n    border: 1px solid var(--line);\n    background: var(--surface);\n    font-weight:700;\n    font-size:0.98rem;\n    cursor:pointer;\n    transition: border-color 0.2s var(--ease-out), background 0.2s var(--ease-out);\n  }\n  .tab:hover{ border-color: var(--teal-300); }\n  .tab .radio{\n    width:16px; height:16px; border-radius:50%;\n    border: 2px solid var(--line);\n    display:flex; align-items:center; justify-content:center;\n  }\n  .tab.active{\n    background: var(--teal-100);\n    border-color: var(--teal-300);\n    color: var(--teal-900);\n  }\n  .tab.active .radio{\n    border-color: var(--teal-700);\n    background: var(--teal-700);\n    position:relative;\n  }\n  .tab.active .radio::after{\n    content:\"\";\n    width:6px; height:6px; border-radius:50%;\n    background:#fff;\n  }\n\n  .add-btn{\n    width:100%;\n    padding: 16px;\n    border-radius: var(--radius-md);\n    background: var(--teal-800);\n    color:#fff;\n    border:none;\n    font-weight:800;\n    font-size: 1.05rem;\n    margin-bottom: 20px;\n    box-shadow: 0 12px 24px -14px rgba(20,47,45,0.55);\n    transition: background 0.2s var(--ease-out), transform 0.2s var(--ease-out);\n  }\n  .add-btn:hover{ background: var(--teal-900); }\n  .add-btn:active{ transform: translateY(1px); }\n  .add-btn:focus-visible{ outline: 2px solid var(--teal-500); outline-offset: 2px; }\n\n  .contrib-grid{\n    display:grid;\n    grid-template-columns: 1.7fr 1fr;\n    grid-template-rows: auto auto auto;\n    gap: 18px;\n  }\n  @media (max-width: 640px){\n    .contrib-grid{ grid-template-columns: 1fr; }\n  }\n\n  .swirl{\n    background-image: url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><path d='M10 20 Q30 0 50 20 T90 20 T130 20 T170 20' stroke='rgba(255,255,255,0.18)' stroke-width='9' fill='none'/><path d='M0 60 Q20 40 40 60 T80 60 T120 60 T160 60' stroke='rgba(255,255,255,0.16)' stroke-width='9' fill='none'/><path d='M10 100 Q30 80 50 100 T90 100 T130 100 T170 100' stroke='rgba(255,255,255,0.18)' stroke-width='9' fill='none'/><path d='M0 140 Q20 120 40 140 T80 140 T120 140 T160 140' stroke='rgba(255,255,255,0.16)' stroke-width='9' fill='none'/></svg>\");\n    background-repeat: repeat;\n  }\n\n  .card{\n    border-radius: var(--radius-lg);\n    padding: 26px;\n    position:relative;\n    overflow:hidden;\n    display:flex;\n    flex-direction:column;\n    justify-content:space-between;\n    min-height: 150px;\n    transition: transform 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out);\n  }\n  .card:hover{ transform: translateY(-3px); box-shadow: var(--shadow-lift); }\n  .card .top-icon{\n    align-self:flex-end;\n    width:44px; height:44px;\n    border-radius:50%;\n    background: rgba(255,255,255,0.16);\n    display:flex; align-items:center; justify-content:center;\n  }\n  .card .num{ font-size:3.6rem; font-weight:800; line-height:1; letter-spacing:-0.02em; }\n  .card .cap{ font-size:1.3rem; font-weight:800; margin-top:6px; }\n\n  .card-big{\n    grid-row: 1 / 4;\n    background: var(--teal-900);\n    color: var(--teal-100);\n    min-height: 420px;\n  }\n  .card-big .num{ font-size:5.5rem; color: var(--teal-300); }\n  .card-big .cap{ font-size:2rem; color:#fff; }\n\n  .card-highlights{\n    background: var(--teal-500);\n    color: var(--teal-100);\n  }\n  .card-highlights .num{ color: var(--teal-100); }\n  .card-highlights .cap{ color:#fff; }\n  .card-highlights .top-icon svg{ color:var(--teal-900); }\n\n  .card-photo{\n    padding:0;\n    background: linear-gradient(180deg,#bcd9d0 0%, #8bb8ac 55%, #5f8f83 100%);\n    justify-content:flex-end;\n    min-height: 150px;\n  }\n  .card-photo .photo-caption{\n    background: linear-gradient(0deg, rgba(10,25,22,0.75), rgba(10,25,22,0));\n    padding: 34px 16px 14px;\n    color:#fff;\n  }\n  .photo-caption .place{ font-weight:800; font-size:1rem; margin-bottom:4px; }\n  .photo-caption .likes{ display:flex; align-items:center; gap:6px; font-size:0.85rem; opacity:0.9; }\n\n  .card-upvotes{\n    background: var(--teal-300);\n    color: var(--teal-900);\n  }\n  .card-upvotes .num{ color: var(--teal-900); }\n  .card-upvotes .cap{ color: var(--teal-900); }\n  .card-upvotes .top-icon{ background: rgba(20,47,45,0.12); }\n\n  /* ---------- Footer ---------- */\n  .footer-bar{\n    display:flex;\n    align-items:center;\n    justify-content:space-between;\n    padding: 18px 32px;\n    background: var(--teal-900);\n    color:#fff;\n  }\n  .footer-brand{\n    display:flex; align-items:center; gap:10px;\n    font-weight:800;\n    font-size:1.05rem;\n  }\n  .footer-brand .mark{\n    width:28px; height:28px; border-radius:8px;\n    background: var(--teal-700);\n    display:flex; align-items:center; justify-content:center;\n  }\n  .footer-note{ font-size:0.9rem; opacity:0.8; font-weight:600; }\n</style>\n\n\n  <header class=\"topbar\" data-kid=\"0\">\n    <div class=\"brand\" data-kid=\"1\">\n      <span class=\"mark\" data-kid=\"2\">\n        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" data-kid=\"3\"><path d=\"M3 20L9 8L13 15L16 10L21 20H3Z\" fill=\"#dcebe6\" data-kid=\"4\"></path></svg>\n      </span>\n      Ridgeline\n    </div>\n\n    <div class=\"mode-select\" data-kid=\"5\">\n      <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" data-kid=\"6\"><circle cx=\"12\" cy=\"5\" r=\"2\" data-kid=\"7\"></circle><path d=\"M9 22l1-8-3-2 2-6 3 1 2 3 3-1v4l-3 1 1 8\" data-kid=\"8\"></path></svg>\n      <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" data-kid=\"9\"><path d=\"M6 9l6 6 6-6\" data-kid=\"10\"></path></svg>\n    </div>\n\n    <div class=\"search\" data-kid=\"11\">\n      <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" data-kid=\"12\"><circle cx=\"11\" cy=\"11\" r=\"7\" data-kid=\"13\"></circle><path d=\"M21 21l-4.3-4.3\" data-kid=\"14\"></path></svg>\n      Search trails, journeys, people\n    </div>\n\n    <nav class=\"nav-links\" data-kid=\"15\">\n      <a href=\"#\" data-kid=\"16\">Home</a>\n      <a href=\"#\" data-kid=\"17\">Trails</a>\n      <a href=\"#\" data-kid=\"18\">Updates</a>\n      <a href=\"#\" data-kid=\"19\">Saved</a>\n      <a href=\"#\" data-kid=\"20\">Plus\n        <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" data-kid=\"21\"><path d=\"M6 9l6 6 6-6\" data-kid=\"22\"></path></svg>\n      </a>\n    </nav>\n\n    <div class=\"spacer\" data-kid=\"23\"></div>\n\n    <button class=\"btn-new\" data-kid=\"24\">\n      Log\n      <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" data-kid=\"25\"><path d=\"M6 9l6 6 6-6\" data-kid=\"26\"></path></svg>\n    </button>\n\n    <button class=\"icon-btn\" data-kid=\"27\">\n      <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" data-kid=\"28\"><path d=\"M18 8a6 6 0 10-12 0c0 7-3 9-3 9h18s-3-2-3-9\" data-kid=\"29\"></path><path d=\"M13.7 21a2 2 0 01-3.4 0\" data-kid=\"30\"></path></svg>\n      <span class=\"dot\" data-kid=\"31\"></span>\n    </button>\n\n    <div class=\"avatar-chip\" data-kid=\"32\">\n      \n      <div class=\"avatar-sm\" role=\"img\" aria-label=\"Profile photo of mira.trailwild — Jake Nackos on Unsplash\" style=\"background-image:url('https://images.unsplash.com/photo-1580489944761-15a19d654956?q=80&amp;w=200');background-size:cover;background-position:center;\" data-kid=\"33\"></div>\n      <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" data-kid=\"34\"><path d=\"M6 9l6 6 6-6\" data-kid=\"35\"></path></svg>\n    </div>\n  </header>\n\n  <div class=\"layout\" data-kid=\"36\">\n    \n    <aside class=\"profile-card\" data-kid=\"37\">\n      <div class=\"avatar-wrap\" data-kid=\"38\">\n        \n        <div class=\"avatar-lg\" role=\"img\" aria-label=\"Profile photo of mira.trailwild — Jake Nackos on Unsplash\" style=\"background-image:url('https://images.unsplash.com/photo-1580489944761-15a19d654956?q=80&amp;w=280');background-size:cover;background-position:center;\" data-kid=\"39\"></div>\n        <div class=\"avatar-edit\" data-kid=\"40\">\n          <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" data-kid=\"41\"><path d=\"M12 20h9\" data-kid=\"42\"></path><path d=\"M16.5 3.5a2.1 2.1 0 013 3L7 19l-4 1 1-4L16.5 3.5z\" data-kid=\"43\"></path></svg>\n        </div>\n      </div>\n\n      <h1 class=\"display-name\" data-kid=\"44\">\n        mira.trailwild\n        <span class=\"badge-verified\" data-kid=\"45\">\n          <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"3\" data-kid=\"46\"><path d=\"M12 2l2.4 2.4 3.3-.5.9 3.3 3.1 1.4-1.4 3.1.5 3.3-3.3.9-1.4 3.1-3.1-1.4-3.1 1.4-1.4-3.1-3.3-.9.5-3.3-1.4-3.1 3.1-1.4.9-3.3 3.3.5z\" data-kid=\"47\"></path></svg>\n        </span>\n        <span class=\"edit-pencil\" data-kid=\"48\">\n          <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" data-kid=\"49\"><path d=\"M12 20h9\" data-kid=\"50\"></path><path d=\"M16.5 3.5a2.1 2.1 0 013 3L7 19l-4 1 1-4L16.5 3.5z\" data-kid=\"51\"></path></svg>\n        </span>\n      </h1>\n\n      <p class=\"bio\" data-kid=\"52\">Chasing ridgelines and sunrise summits</p>\n\n      <a class=\"site-link\" href=\"#\" data-kid=\"53\">\n        <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" data-kid=\"54\"><circle cx=\"12\" cy=\"12\" r=\"10\" data-kid=\"55\"></circle><path d=\"M2 12h20M12 2a15 15 0 010 20 15 15 0 010-20z\" data-kid=\"56\"></path></svg>\n        miratrailwild.co\n      </a>\n\n      <div class=\"stats-row\" data-kid=\"57\">\n        <div class=\"stat-block\" data-kid=\"58\">\n          <span class=\"label\" data-kid=\"59\">Followers</span>\n          <span class=\"value\" data-kid=\"60\">86</span>\n        </div>\n        <div class=\"stat-block\" data-kid=\"61\">\n          <span class=\"label\" data-kid=\"62\">Following</span>\n          <span class=\"value\" data-kid=\"63\">41</span>\n        </div>\n        <div class=\"stat-block\" data-kid=\"64\">\n          <span class=\"label\" data-kid=\"65\">Crew</span>\n          <span class=\"value\" data-kid=\"66\">5</span>\n        </div>\n        <button class=\"stat-search\" data-kid=\"67\">\n          <svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" data-kid=\"68\"><circle cx=\"11\" cy=\"11\" r=\"7\" data-kid=\"69\"></circle><path d=\"M21 21l-4.3-4.3\" data-kid=\"70\"></path></svg>\n        </button>\n      </div>\n\n      <div class=\"streak-card\" data-kid=\"71\">\n        <span class=\"streak-icon\" data-kid=\"72\">\n          <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"#fff\" data-kid=\"73\"><path d=\"M12 2c1 4-3 5-3 9a4 4 0 008 0c1.5 1 2 3 2 4.5A6.5 6.5 0 016.5 15.5C6.5 9 12 7 12 2z\" data-kid=\"74\"></path></svg>\n        </span>\n        <div data-kid=\"75\">\n          <h4 data-kid=\"76\">Keep your streak going</h4>\n          <p data-kid=\"77\">Log 20 minutes outdoors this week to hold your streak.</p>\n        </div>\n      </div>\n\n      <ul class=\"nav-list\" data-kid=\"78\">\n        <li class=\"nav-row\" data-kid=\"79\">\n          <span class=\"row-icon\" data-kid=\"80\">\n            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" data-kid=\"81\"><path d=\"M19 21l-7-5-7 5V5a2 2 0 012-2h10a2 2 0 012 2z\" data-kid=\"82\"></path></svg>\n          </span>\n          Saved trails\n          <span class=\"count\" data-kid=\"83\">1</span>\n          <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" data-kid=\"84\"><path d=\"M9 18l6-6-6-6\" data-kid=\"85\"></path></svg>\n        </li>\n        <li class=\"nav-row\" data-kid=\"86\">\n          <span class=\"row-icon\" data-kid=\"87\">\n            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" data-kid=\"88\"><path d=\"M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z\" data-kid=\"89\"></path><path d=\"M4 22V15\" data-kid=\"90\"></path></svg>\n          </span>\n          Completed hikes\n          <span class=\"count\" data-kid=\"91\">6</span>\n          <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" data-kid=\"92\"><path d=\"M9 18l6-6-6-6\" data-kid=\"93\"></path></svg>\n        </li>\n        <li class=\"nav-row\" data-kid=\"94\">\n          <span class=\"row-icon\" data-kid=\"95\">\n            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" data-kid=\"96\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\" data-kid=\"97\"></rect><circle cx=\"9\" cy=\"9\" r=\"2\" d