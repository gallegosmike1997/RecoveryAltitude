      "html": "<style>\n  :root{\n    --bg:#0a0b0c;\n    --bg-soft:#101214;\n    --surface:#16191b;\n    --surface-2:#1e2225;\n    --surface-3:#272c30;\n    --line:rgba(255,255,255,.09);\n    --line-strong:rgba(255,255,255,.16);\n    --text:#f1f4f3;\n    --muted:#98a2a0;\n    --muted-dim:#6f7876;\n    --accent:#54cfb6;\n    --accent-deep:#1f9c85;\n    --accent-ink:#04231e;\n    --radius-sm:8px;\n    --radius-md:14px;\n    --radius-lg:20px;\n    --sp-1:4px; --sp-2:8px; --sp-3:12px; --sp-4:16px; --sp-5:24px;\n    --sp-6:32px; --sp-7:48px; --sp-8:64px;\n    --gutter:28px;\n    --shadow-soft:0 18px 40px -22px rgba(0,0,0,.85);\n    --ease:cubic-bezier(.16,1,.3,1);\n  }\n  *,*::before,*::after{box-sizing:border-box}\n  html,body{margin:0;padding:0}\n  body{\n    background:var(--bg);\n    color:var(--text);\n    font-family:system-ui,-apple-system,\"Segoe UI\",Roboto,\"Helvetica Neue\",Arial,sans-serif;\n    -webkit-font-smoothing:antialiased;\n    font-size:14px;\n    line-height:1.5;\n    overflow-x:hidden;\n  }\n  img{max-width:100%;display:block}\n  button{font:inherit;color:inherit;background:none;border:0;padding:0;cursor:pointer}\n  a{color:inherit;text-decoration:none}\n  :focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:4px}\n\n  /* ---------- top bar ---------- */\n  .topbar{\n    display:grid;\n    grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);\n    align-items:center;\n    gap:var(--sp-5);\n    padding:14px var(--gutter);\n    background:linear-gradient(180deg,#0e1113 0%,#0a0b0c 100%);\n    border-bottom:1px solid rgba(255,255,255,.05);\n  }\n  .bar-left{display:flex;align-items:center;gap:var(--sp-5);min-width:0}\n  .brand{display:flex;align-items:center;gap:9px;flex:0 0 auto}\n  .brand svg{display:block}\n  .brand-name{\n    font-size:17px;font-weight:640;letter-spacing:-.025em;\n  }\n  .brand-name em{font-style:normal;color:var(--accent)}\n\n  .search{\n    position:relative;display:flex;align-items:center;gap:9px;\n    min-width:0;flex:1 1 260px;max-width:300px;\n    height:38px;padding:0 6px 0 13px;\n    background:var(--surface);\n    border:1px solid var(--line);\n    border-radius:999px;\n    transition:border-color .25s var(--ease),background .25s var(--ease);\n  }\n  .search:hover{border-color:var(--line-strong)}\n  .search input{\n    flex:1 1 auto;min-width:0;height:100%;\n    background:none;border:0;outline:none;color:var(--text);\n    font:inherit;font-size:13.5px;\n  }\n  .search input::placeholder{color:var(--muted-dim)}\n  .search .icon-btn{\n    flex:0 0 auto;width:26px;height:26px;border-radius:7px;\n    display:grid;place-items:center;color:var(--muted);\n    background:var(--surface-2);\n    transition:color .2s var(--ease),background .2s var(--ease);\n  }\n  .search .icon-btn:hover{color:var(--text);background:var(--surface-3)}\n\n  .nav{\n    display:flex;align-items:center;gap:2px;\n    padding:4px;border-radius:999px;\n    background:var(--surface);\n    border:1px solid var(--line);\n  }\n  .nav a{\n    padding:7px 17px;border-radius:999px;\n    font-size:13.5px;font-weight:520;color:var(--muted);\n    white-space:nowrap;\n    transition:color .2s var(--ease),background .2s var(--ease);\n  }\n  .nav a:hover{color:var(--text)}\n  .nav a.is-active{\n    background:var(--surface-3);color:var(--text);\n    box-shadow:inset 0 1px 0 rgba(255,255,255,.07);\n  }\n\n  .bar-right{display:flex;align-items:center;justify-content:flex-end;gap:10px;min-width:0}\n  .pill{\n    height:38px;padding:0 20px;border-radius:999px;\n    font-size:13.5px;font-weight:600;white-space:nowrap;\n    display:inline-flex;align-items:center;\n    transition:transform .25s var(--ease),box-shadow .25s var(--ease),background .25s var(--ease);\n  }\n  .pill:active{transform:translateY(1px)}\n  .pill-ghost{\n    background:var(--surface-2);color:var(--text);\n    border:1px solid var(--line-strong);\n  }\n  .pill-ghost:hover{background:var(--surface-3)}\n  .pill-accent{\n    background:linear-gradient(140deg,#7de3cb 0%,var(--accent) 45%,var(--accent-deep) 100%);\n    color:var(--accent-ink);\n    box-shadow:0 8px 22px -12px rgba(84,207,182,.8);\n  }\n  .pill-accent:hover{box-shadow:0 12px 26px -12px rgba(84,207,182,.95)}\n  .avatar{\n    flex:0 0 auto;width:38px;height:38px;border-radius:50%;\n    background:radial-gradient(120% 120% at 30% 20%,#3b4247,#22262a);\n    border:1px solid var(--line-strong);\n    display:grid;place-items:center;color:var(--muted);\n  }\n\n  /* ---------- mini player ---------- */\n  .player{\n    display:flex;align-items:center;gap:var(--sp-4);\n    padding:10px var(--gutter);\n    background:var(--bg-soft);\n    border-bottom:1px solid rgba(255,255,255,.05);\n  }\n  .player-art{\n    flex:0 0 auto;width:52px;height:52px;border-radius:10px;\n    background:\n      radial-gradient(90% 80% at 25% 20%,rgba(125,227,203,.55),transparent 60%),\n      linear-gradient(150deg,#16333a,#0d1a1f 60%,#101a1c);\n    border:1px solid var(--line);\n    position:relative;overflow:hidden;\n  }\n  .player-art::after{\n    content:\"\";position:absolute;inset:0;\n    background:radial-gradient(50% 60% at 70% 75%,rgba(255,255,255,.22),transparent 70%);\n  }\n  .play-btn{\n    flex:0 0 auto;width:32px;height:32px;border-radius:50%;\n    display:grid;place-items:center;color:var(--text);\n    background:var(--surface-2);border:1px solid var(--line);\n    transition:transform .25s var(--ease),background .25s var(--ease);\n  }\n  .play-btn:hover{background:var(--surface-3);transform:scale(1.06)}\n  .track{min-width:0;flex:0 1 300px}\n  .track-title{\n    font-size:14px;font-weight:560;color:var(--text);\n    white-space:nowrap;overflow:hidden;text-overflow:ellipsis;\n  }\n  .track-artist{\n    font-size:12.5px;color:var(--muted-dim);\n    white-space:nowrap;overflow:hidden;text-overflow:ellipsis;\n  }\n  .track-tags{\n    min-width:0;flex:0 1 190px;font-size:12.5px;color:var(--muted-dim);\n    white-space:nowrap;overflow:hidden;text-overflow:ellipsis;\n  }\n  .track-time{flex:0 0 auto;font-size:12.5px;color:var(--muted-dim);font-variant-numeric:tabular-nums}\n  .wave{flex:1 1 auto;min-width:0;height:34px;color:var(--muted-dim)}\n  .wave svg{width:100%;height:100%;display:block}\n  .wave .played{color:var(--accent)}\n  .player-tools{display:flex;align-items:center;gap:2px;flex:0 0 auto}\n  .tool{\n    width:32px;height:32px;border-radius:8px;display:grid;place-items:center;\n    color:var(--muted);transition:color .2s var(--ease),background .2s var(--ease);\n  }\n  .tool:hover{color:var(--text);background:var(--surface-2)}\n\n  /* ---------- promo ---------- */\n  main{padding:var(--sp-7) var(--gutter) var(--sp-8)}\n  .promo{\n    position:relative;overflow:hidden;\n    border-radius:var(--radius-lg);\n    background:linear-gradient(120deg,#111417,#0d1013);\n    border:1px solid var(--line);\n    width:100%;\n    aspect-ratio:64/10;\n    display:flex;align-items:center;\n    box-shadow:var(--shadow-soft);\n  }\n  .promo-media{position:absolute;inset:0;overflow:hidden}\n  .promo-media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}\n  .promo-fallback{\n    position:absolute;inset:0;\n    background:\n      radial-gradient(70% 120% at 62% 55%,rgba(255,206,120,.85),transparent 62%),\n      radial-gradient(50% 90% at 88% 40%,rgba(255,171,64,.45),transparent 70%),\n      linear-gradient(90deg,#0b0d0e,#141110 45%,#1c1712);\n  }\n  .promo-scrim{\n    position:absolute;inset:0;\n    background:linear-gradient(90deg,#0a0b0c 0%,#0a0b0c 24%,rgba(10,11,12,.88) 36%,rgba(10,11,12,.35) 52%,rgba(10,11,12,0) 66%);\n  }\n  .promo-body{position:relative;z-index:2;padding:0 var(--sp-7);max-width:min(52%,560px);min-width:0}\n  .promo-title{\n    margin:0 0 26px;\n    font-family:\"Iowan Old Style\",\"Palatino Linotype\",Palatino,Georgia,\"Times New Roman\",serif;\n    font-weight:500;\n    font-size:clamp(26px,2.55vw,37px);\n    line-height:1.16;\n    letter-spacing:-.015em;\n    color:#fbfdfc;\n  }\n  .promo-cta{\n    height:46px;padding:0 26px;border-radius:999px;\n    background:#f7faf9;color:#0c1110;\n    font-size:14.5px;font-weight:640;\n    display:inline-flex;align-items:center;\n    box-shadow:0 14px 30px -18px rgba(0,0,0,.9);\n    transition:transform .3s var(--ease),background .3s var(--ease);\n  }\n  .promo-cta:hover{transform:translateY(-1px);background:#fff}\n\n  /* ---------- shelf ---------- */\n  .shelf{margin-top:var(--sp-8)}\n  .shelf-head{\n    display:flex;align-items:baseline;justify-content:space-between;gap:var(--sp-5);\n    margin-bottom:var(--sp-5);min-width:0;\n  }\n  .shelf-head h2{\n    margin:0;font-size:21px;font-weight:620;letter-spacing:-.02em;min-width:0;\n  }\n  .shelf-more{\n    display:inline-flex;align-items:center;gap:7px;flex:0 0 auto;\n    font-size:14px;font-weight:520;color:var(--muted);\n    transition:color .2s var(--ease),gap .3s var(--ease);\n  }\n  .shelf-more:hover{color:var(--text);gap:10px}\n\n  .rail-wrap{overflow:hidden;margin:0 calc(var(--gutter)*-1);padding:0 var(--gutter)}\n  .rail{display:flex;gap:20px;align-items:stretch}\n  .tile{\n    position:relative;flex:0 0 auto;height:270px;\n    border-radius:var(--radius-md);overflow:hidden;\n    background:var(--surface);\n    border:1px solid var(--line);\n    isolation:isolate;\n    box-shadow:0 16px 34px -24px rgba(0,0,0,.9);\n    transition:transform .4s var(--ease),box-shadow .4s var(--ease);\n  }\n  .tile:hover{\n    transform:translateY(-3px);\n    box-shadow:0 24px 46px -22px rgba(0,0,0,.95);\n  }\n  .tile-wide{flex:0 0 482px}\n  .tile-tall{flex:0 0 181px}\n  .tile-media{position:absolute;inset:0;overflow:hidden;z-index:0}\n  .tile-media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}\n  .tile-media .ph{position:absolute;inset:0}\n  .ph-a{background:linear-gradient(160deg,#8fa4c2,#4d5f7d 55%,#2c3446)}\n  .ph-b{background:linear-gradient(170deg,#d9a45c,#9b5f31 60%,#3c2317)}\n  .ph-c{background:linear-gradient(170deg,#b9a6d6,#6f6493 55%,#2f2c44)}\n  .ph-d{background:linear-gradient(170deg,#c78d6d,#6d4331 60%,#2a1a15)}\n  .ph-e{background:linear-gradient(170deg,#7fa8cd,#3d5f83 55%,#1b2a3b)}\n  .ph-f{background:linear-gradient(170deg,#d6807f,#8a3f41 55%,#341a1c)}\n  .tile-veil{\n    position:absolute;inset:0;z-index:1;\n    background:linear-gradient(180deg,rgba(6,8,9,.42) 0%,rgba(6,8,9,0) 32%,rgba(6,8,9,0) 62%,rgba(6,8,9,.55) 100%);\n  }\n  .badge{\n    position:absolute;top:12px;left:12px;z-index:3;\n    padding:5px 10px;border-radius:7px;\n    font-size:11px;font-weight:620;letter-spacing:.02em;\n    background:rgba(10,12,13,.72);color:#eef2f1;\n    border:1px solid rgba(255,255,255,.14);\n    backdrop-filter:blur(8px);\n  }\n  .badge-new{\n    background:linear-gradient(140deg,#7de3cb,var(--accent-deep));\n    color:var(--accent-ink);border-color:rgba(255,255,255,.28);\n    letter-spacing:.06em;\n  }\n  .byline{\n    position:absolute;left:16px;bottom:14px;right:80px;z-index:3;\n    font-size:13px;font-weight:520;letter-spacing:.05em;\n    color:rgba(245,248,247,.92);\n    text-transform:uppercase;\n    white-space:nowrap;overflow:hidden;text-overflow:ellipsis;\n  }\n  .tile-actions{\n    position:absolute;right:14px;top:16px;z-index:3;\n    display:flex;flex-direction:column;gap:9px;\n  }\n  .act{\n    width:36px;height:36px;border-radius:50%;\n    display:grid;place-items:center;\n    background:rgba(14,17,18,.66);\n    border:1px solid rgba(255,255,255,.14);\n    color:#eef2f1;\n    backdrop-filter:blur(10px);\n    transition:background .25s var(--ease),transform .25s var(--ease);\n  }\n  .act:hover{background:rgba(28,33,35,.9);transform:scale(1.06)}\n\n  .rail-controls{\n    display:grid;grid-template-columns:auto 1fr auto;align-items:center;\n    margin-top:var(--sp-5);\n  }\n  .arrow{\n    width:44px;height:44px;border-radius:50%;\n    display:grid;place-items:center;color:var(--muted);\n    border:1px solid var(--line-strong);background:transparent;\n    transition:color .25s var(--ease),background .25s var(--ease),border-color .25s var(--ease);\n  }\n  .arrow:hover{color:var(--text);background:var(--surface-2);border-color:transparent}\n  .dots{display:flex;justify-content:center;gap:8px}\n  .dot{width:7px;height:7px;border-radius:50%;background:var(--surface-3);transition:background .25s var(--ease)}\n  .dot.is-active{background:var(--accent)}\n  .arrow-next{justify-self:end}\n\n  @media (max-width:900px){\n    :root{--gutter:18px}\n    .topbar{grid-template-columns:1fr auto;row-gap:12px}\n    .nav{grid-column:1/-1;order:3;justify-content:center;overflow-x:auto}\n    .search{display:none}\n    .promo{aspect-ratio:auto;min-height:260px}\n    .promo-body{max-width:none;padding:0 var(--sp-5)}\n    .promo-scrim{background:linear-gradient(90deg,rgba(10,11,12,.95) 0%,rgba(10,11,12,.8) 55%,rgba(10,11,12,.35) 100%)}\n    .track-tags,.wave{display:none}\n  }\n</style>\n\n\n<header class=\"topbar\">\n  <div class=\"bar-left\">\n    <a class=\"brand\" href=\"#\" aria-label=\"Rhumbline home\">\n      <svg width=\"26\" height=\"26\" viewBox=\"0 0 26 26\" fill=\"none\" aria-hidden=\"true\">\n        <circle cx=\"13\" cy=\"13\" r=\"11.2\" stroke=\"#54cfb6\" stroke-width=\"1.5\"/>\n        <path d=\"M13 2.6 L15.6 10.4 L23.4 13 L15.6 15.6 L13 23.4 L10.4 15.6 L2.6 13 L10.4 10.4 Z\" fill=\"#54cfb6\"/>\n        <circle cx=\"13\" cy=\"13\" r=\"2.1\" fill=\"#0a0b0c\"/>\n      </svg>\n      <span class=\"brand-name\">Rhumb<em>line</em></span>\n    </a>\n    <div class=\"search\">\n      <svg width=\"15\" height=\"15\" viewBox=\"0 0 16 16\" fill=\"none\" aria-hidden=\"true\">\n        <circle cx=\"7\" cy=\"7\" r=\"5.1\" stroke=\"#98a2a0\" stroke-width=\"1.5\"/>\n        <path d=\"M10.8 10.8 L14.2 14.2\" stroke=\"#98a2a0\" stroke-width=\"1.5\" stroke-linecap=\"round\"/>\n      </svg>\n      <input type=\"text\" placeholder=\"Search footage, sound, presets\" aria-label=\"Search the library\">\n      <button class=\"icon-btn\" aria-label=\"Search by reference clip\">\n        <svg width=\"14\" height=\"14\" viewBox=\"0 0 16 16\" fill=\"none\" aria-hidden=\"true\">\n          <path d=\"M2 5.6V3.4A1.4 1.4 0 0 1 3.4 2h2.2M10.4 2h2.2A1.4 1.4 0 0 1 14 3.4v2.2M14 10.4v2.2a1.4 1.4 0 0 1-1.4 1.4h-2.2M5.6 14H3.4A1.4 1.4 0 0 1 2 12.6v-2.2\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/>\n          <path d=\"M5.4 8h5.2\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/>\n        </svg>\n      </button>\n    </div>\n  </div>\n\n  <nav class=\"nav\" aria-label=\"Primary\">\n    <a href=\"#\" class=\"is-active\">Home</a>\n    <a href=\"#\">AI Bench</a>\n    <a href=\"#\">Library</a>\n    <a href=\"#\">Sessions</a>\n  </nav>\n\n  <div class=\"bar-right\">\n    <button class=\"pill pill-ghost\">Add Credits</button>\n    <button class=\"pill pill-accent\">Get Library Pass</button>\n    <span class=\"avatar\" aria-label=\"Account\">\n      <svg width=\"17\" height=\"17\" viewBox=\"0 0 18 18\" fill=\"none\" aria-hidden=\"true\">\n        <circle cx=\"9\" cy=\"6.4\" r=\"3.1\" stroke=\"currentColor\" stroke-width=\"1.5\"/>\n        <path d=\"M3.2 15.2c.9-2.9 3.1-4.4 5.8-4.4s4.9 1.5 5.8 4.4\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/>\n      </svg>\n    </span>\n  </div>\n</header>\n\n<div class=\"player\">\n  <div class=\"player-art\" aria-hidden=\"true\"></div>\n  <button class=\"play-btn\" aria-label=\"Play\">\n    <svg width=\"12\" height=\"13\" viewBox=\"0 0 12 13\" fill=\"none\" aria-hidden=\"true\">\n      <path d=\"M2 1.6 10.4 6.5 2 11.4Z\" fill=\"currentColor\"/>\n    </svg>\n  </button>\n  <div class=\"track\">\n    <div class=\"track-title\">Deep Current — Slow Hull Groan</div>\n    <div class=\"track-artist\">Rhumbline Field Unit</div>\n  </div>\n  <div class=\"track-tags\">Marine, Long Drones</div>\n  <div class=\"track-time\">00:11</div>\n  <div class=\"wave\" aria-hidden=\"true\">\n    <svg viewBox=\"0 0 440 34\" preserveAspectRatio=\"none\">\n      <g fill=\"currentColor\" opacity=\".55\">\n        <rect x=\"0\" y=\"13\" width=\"3\" height=\"8\" rx=\"1.5\"/><rect x=\"6\" y=\"10\" width=\"3\" height=\"14\" rx=\"1.5\"/>\n        <rect x=\"12\" y=\"6\" width=\"3\" height=\"22\" rx=\"1.5\"/><rect x=\"18\" y=\"12\" width=\"3\" height=\"10\" rx=\"1.5\"/>\n        <rect x=\"24\" y=\"3\" width=\"3\" height=\"28\" rx=\"1.5\"/><rect x=\"30\" y=\"9\" width=\"3\" height=\"16\" rx=\"1.5\"/>\n        <rect x=\"36\" y=\"14\" width=\"3\" height=\"6\" rx=\"1.5\"/><rect x=\"42\" y=\"7\" width=\"3\" height=\"20\" rx=\"1.5\"/>\n        <rect x=\"48\" y=\"11\" width=\"3\" height=\"12\" rx=\"1.5\"/><rect x=\"54\" y=\"4\" width=\"3\" height=\"26\" rx=\"1.5\"/>\n        <rect x=\"60\" y=\"12\" width=\"3\" height=\"10\" rx=\"1.5\"/><rect x=\"66\" y=\"8\" width=\"3\" height=\"18\" rx=\"1.5\"/>\n        <rect x=\"72\" y=\"14\" width=\"3\" height=\"7\" rx=\"1.5\"/><rect x=\"78\" y=\"5\" width=\"3\" height=\"24\" rx=\"1.5\"/>\n        <rect x=\"84\" y=\"10\" width=\"3\" height=\"14\" rx=\"1.5\"/><rect x=\"90\" y=\"13\" width=\"3\" height=\"8\" rx=\"1.5\"/>\n        <rect x=\"96\" y=\"6\" width=\"3\" height=\"22\" rx=\"1.5\"/><rect x=\"102\" y=\"11\" width=\"3\" height=\"12\" rx=\"1.5\"/>\n        <rect x=\"108\" y=\"2\" width=\"3\" height=\"30\" rx=\"1.5\"/><rect x=\"114\" y=\"9\" width=\"3\" height=\"16\" rx=\"1.5\"/>\n        <rect x=\"120\" y=\"14\" width=\"3\" height=\"6\" rx=\"1.5\"/><rect x=\"126\" y=\"8\" width=\"3\" height=\"18\" rx=\"1.5\"/>\n        <rect x=\"132\" y=\"12\" width=\"3\" height=\"10\" rx=\"1.5\"/><rect x=\"138\" y=\"5\" width=\"3\" height=\"24\" rx=\"1.5\"/>\n        <rect x=\"144\" y=\"13\" width=\"3\" height=\"8\" rx=\"1.5\"/><rect x=\"150\" y=\"7\" width=\"3\" height=\"20\" rx=\"1.5\"/>\n        <rect x=\"156\" y=\"11\" width=\"3\" height=\"13\" rx=\"1.5\"/><rect x=\"162\" y=\"3\" width=\"3\" height=\"28\" rx=\"1.5\"/>\n        <rect x=\"168\" y=\"12\" width=\"3\" height=\"10\" rx=\"1.5\"/><rect x=\"174\" y=\"9\" width=\"3\" height=\"16\" rx=\"1.5\"/>\n        <rect x=\"180\" y=\"14\" width=\"3\" height=\"6\" rx=\"1.5\"/><rect x=\"186\" y=\"6\" width=\"3\" height=\"22\" rx=\"1.5\"/>\n        <rect x=\"192\" y=\"10\" width=\"3\" height=\"14\" rx=\"1.5\"/><rect x=\"198\" y=\"13\" width=\"3\" height=\"9\" rx=\"1.5\"/>\n        <rect x=\"204\" y=\"4\" width=\"3\" height=\"26\" rx=\"1.5\"/><rect x=\"210\" y=\"11\" width=\"3\" height=\"12\" rx=\"1.5\"/>\n        <rect x=\"216\" y=\"8\" width=\"3\" height=\"18\" rx=\"1.5\"/><rect x=\"222\" y=\"14\" width=\"3\" height=\"7\" rx=\"1.5\"/>\n        <rect x=\"228\" y=\"5\" width=\"3\" height=\"24\" rx=\"1.5\"/><rect x=\"234\" y=\"12\" width=\"3\" height=\"10\" rx=\"1.5\"/>\n        <rect x=\"240\" y=\"9\" width=\"3\" height=\"16\" rx=\"1.5\"/><rect x=\"246\" y=\"13\" width=\"3\" height=\"8\" rx=\"1.5\"/>\n        <rect x=\"252\" y=\"2\" width=\"3\" height=\"30\" rx=\"1.5\"/><rect x=\"258\" y=\"10\" width=\"3\" height=\"14\" rx=\"1.5\"/>\n        <rect x=\"264\" y=\"14\" width=\"3\" height=\"6\" rx=\"1.5\"/><rect x=\"270\" y=\"7\" width=\"3\" height=\"20\" rx=\"1.5\"/>\n        <rect x=\"276\" y=\"11\" width=\"3\" height=\"12\" rx=\"1.5\"/><rect x=\"282\" y=\"4\" width=\"3\" height=\"26\" rx=\"1.5\"/>\n        <rect x=\"288\" y=\"13\" width=\"3\" height=\"8\" rx=\"1.5\"/><rect x=\"294\" y=\"8\" width=\"3\" height=\"18\" rx=\"1.5\"/>\n        <rect x=\"300\" y=\"12\" width=\"3\" height=\"10\" rx=\"1.5\"/><rect x=\"306\" y=\"6\" width=\"3\" height=\"22\" rx=\"1.5\"/>\n        <rect x=\"312\" y=\"14\" width=\"3\" height=\"7\" rx=\"1.5\"/><rect x=\"318\" y=\"9\" width=\"3\" height=\"16\" rx=\"1.5\"/>\n        <rect x=\"324\" y=\"3\" width=\"3\" height=\"28\" rx=\"1.5\"/><rect x=\"330\" y=\"12\" width=\"3\" height=\"10\" rx=\"1.5\"/>\n        <rect x=\"336\" y=\"10\" width=\"3\" height=\"14\" rx=\"1.5\"/><rect x=\"342\" y=\"13\" width=\"3\" height=\"8\" rx=\"1.5\"/>\n        <rect x=\"348\" y=\"5\" width=\"3\" height=\"24\" rx=\"1.5\"/><rect x=\"354\" y=\"11\" width=\"3\" height=\"12\" rx=\"1.5\"/>\n        <rect x=\"360\" y=\"14\" width=\"3\" height=\"6\" rx=\"1.5\"/><rect x=\"366\" y=\"7\" width=\"3\" height=\"20\" rx=\"1.5\"/>\n        <rect x=\"372\" y=\"12\" width=\"3\" height=\"10\" rx=\"1.5\"/><rect x=\"378\" y=\"4\" width=\"3\" height=\"26\" rx=\"1.5\"/>\n        <rect x=\"384\" y=\"13\" width=\"3\" height=\"8\" rx=\"1.5\"/><rect x=\"390\" y=\"9\" width=\"3\" height=\"16\" rx=\"1.5\"/>\n        <rect x=\"396\" y=\"14\" width=\"3\" height=\"6\" rx=\"1.5\"/><rect x=\"402\" y=\"8\" width=\"3\" height=\"18\" rx=\"1.5\"/>\n        <rect x=\"408\" y=\"11\" width=\"3\" height=\"12\" rx=\"1.5\"/><rect x=\"414\" y=\"6\" width=\"3\" height=\"22\" rx=\"1.5\"/>\n        <rect x=\"420\" y=\"13\" width=\"3\" height=\"8\" rx=\"1.5\"/><rect x=\"426\" y=\"10\" width=\"3\" height=\"14\" rx=\"1.5\"/>\n        <rect x=\"432\" y=\"14\" width=\"3\" height=\"6\" rx=\"1.5\"/>\n      </g>\n      <g fill=\"currentColor\" class=\"played\" opacity=\".95\">\n        <rect x=\"0\" y=\"13\" width=\"3\" height=\"8\" rx=\"1.5\"/><rect x=\"6\" y=\"10\" width=\"3\" height=\"14\" rx=\"1.5\"/>\n        <rect x=\"12\" y=\"6\" width=\"3\" height=\"22\" rx=\"1.5\"/><rect x=\"18\" y=\"12\" width=\"3\" height=\"10\" rx=\"1.5\"/>\n        <rect x=\"24\" y=\"3\" width=\"3\" height=\"28\" rx=\"1.5\"/><rect x=\"30\" y=\"9\" width=\"3\" height=\"16\" rx=\"1.5\"/>\n        <rect x=\"36\" y=\"14\" width=\"3\" height=\"6\" rx=\"1.5\"/><rect x=\"42\" y=\"7\" width=\"3\" height=\"20\" rx=\"1.5\"/>\n        <rect x=\"48\" y=\"11\" width=\"3\" height=\"12\" rx=\"1.5\"/><rect x=\"54\" y=\"4\" width=\"3\" height=\"26\" rx=\"1.5\"/>\n        <rect x=\"60\" y=\"12\" width=\"3\" height=\"10\" rx=\"1.5\"/><rect x=\"66\" y=\"8\" width=\"3\" height=\"18\" rx=\"1.5\"/>\n      </g>\n    </svg>\n  </div>\n  <div class=\"player-tools\">\n    <button class=\"tool\" aria-label=\"Download\">\n      <svg width=\"17\" height=\"17\" viewBox=\"0 0 18 18\" fill=\"none\" aria-hidden=\"true\">\n        <path d=\"M9 2.6v9.2M5.4 8.4 9 12l3.6-3.6M3.4 15h11.2\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n      </svg>\n    </button>\n    <button class=\"tool\" aria-label=\"Save to collection\">\n      <svg width=\"17\" height=\"17\" viewBox=\"0 0 18 18\" fill=\"none\" aria-hidden=\"true\">\n        <path d=\"M9 2.2 11.1 6.6l4.7.6-3.4 3.3.85 4.8L9 13l-4.25 2.3.85-4.8L2.2 7.2l4.7-.6Z\" fill=\"currentColor\"/>\n      </svg>\n    </button>\n    <button class=\"tool\" aria-label=\"More options\">\n      <svg width=\"17\" height=\"17\" viewBox=\"0 0 18 18\" fill=\"none\" aria-hidden=\"true\">\n        <circle cx=\"9\" cy=\"4\" r=\"1.5\" fill=\"currentColor\"/><circle cx=\"9\" cy=\"9\" r=\"1.5\" fill=\"currentColor\"/><circle cx=\"9\" cy=\"14\" r=\"1.5\" fill=\"currentColor\"/>\n      </svg>\n    </button>\n  </div>\n</div>\n\n<main>\n  <section class=\"promo\">\n    <div class=\"promo-media\">\n      <div class=\"promo-fallback\"></div>\n      <img src=\"https://images.pexels.com/photos/35930744/pexels-photo-35930744.jpeg?auto=compress&cs=tinysrgb&w=1600\" alt=\"Shimmering golden water texture — photo by wal_ 172619 on Pexels\" onerror=\"__crawlAsset&&__crawlAsset(this)\">\n    </div>\n    <div class=\"promo-scrim\"></div>\n    <div class=\"promo-body\">\n      <h1 class=\"promo-title\">Footage and sound<br>for every cut you<br>are about to make</h1>\n      <a class=\"promo-cta\" href=\"#\">Upgrade to Atlas</a>\n    </div>\n  </section>\n\n  <section class=\"shelf\">\n    <div class=\"shelf-head\">\n      <h2>Fresh from the field this week</h2>\n      <a class=\"shelf-more\" href=\"#\">\n        Browse the full library\n        <svg width=\"15\" height=\"15\" viewBox=\"0 0 16 16\" fill=\"none\" aria-hidden=\"true\">\n          <path d=\"M6 3.2 10.8 8 6 12.8\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n        </svg>\n      </a>\n    </div>\n\n    <div class=\"rail-wrap\">\n      <div class=\"rail\">\n\n        <article class=\"tile tile-wide\">\n          <div class=\"tile-media\"><div class=\"ph ph-a\"></div><img src=\"https://images.pexels.com/photos/24770280/pexels-photo-24770280.jpeg?auto=compress&cs=tinysrgb&w=1000\" alt=\"Aerial view of mountains shrouded in fog — photo by Q. Hưng Phạm on Pexels\" onerror=\"__crawlAsset&&__crawlAsset(this)\"></div>\n          <div class=\"tile-veil\"></div>\n          <span class=\"badge\">Synth Render</span>\n          <div class=\"tile-actions\">\n            <button class=\"act\" aria-label=\"Download clip\">\n              <svg width=\"15\" height=\"15\" viewBox=\"0 0 18 18\" fill=\"none\" aria-hidden=\"true\">\n                <path d=\"M9 2.6v9.2M5.4 8.4 9 12l3.6-3.6M3.4 15h11.2\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n              </svg>\n            </button>\n            <button class=\"act\" aria-label=\"Save clip\">\n              <svg width=\"15\" height=\"15\" viewBox=\"0 0 18 18\" fill=\"none\" aria-hidden=\"true\">\n                <path d=\"M9 2.2 11.1 6.6l4.7.6-3.4 3.3.85 4.8L9 13l-4.25 2.3.85-4.8L2.2 7.2l4.7-.6Z\" fill=\"currentColor\"/>\n              </svg>\n            </button>\n            <button class=\"act\" aria-label=\"Toggle sound\">\n              <svg width=\"15\" height=\"15\" viewBox=\"0 0 18 18\" fill=\"none\" aria-hidden=\"true\">\n                <path d=\"M4 7h2.6L10 4v10L6.6 11H4Z\" fill=\"currentColor\"/>\n                <path d=\"M12.4 6.5c1.1 1.4 1.1 3.6 0 5\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/>\n              </svg>\n            </button>\n            <button class=\"act\" aria-label=\"More options\">\n              <svg width=\"15\" height=\"15\" viewBox=\"0 0 18 18\" fill=\"none\" aria-hidden=\"true\">\n                <circle cx=\"9\" cy=\"4\" r=\"1.4\" fill=\"currentColor\"/><circle cx=\"9\" cy=\"9\" r=\"1.4\" fill=\"currentColor\"/><circle cx=\"9\" cy=\"14\" r=\"1.4\" fill=\"currentColor\"/>\n              </svg>\n            </button>\n          </div>\n          <div class=\"byline\">By Noor Haddad</div>\n        </article>\n\n        <article class=\"tile tile-tall\">\n          <div class=\"tile-media\"><div class=\"ph ph-b\"></div><img src=\"https://images.pexels.com/photos/13198303/pexels-photo-13198303.jpeg?auto=compress&cs=tinysrgb&w=500\" alt=\"Birds crossing a pastel sunset sky — photo by Fermin Rodriguez Penelas on Pexels\" onerror=\"__crawlAsset&&__crawlAsset(this)\"></div>\n          <div class=\"tile-veil\"></div>\n        </article>\n\n        <article class=\"tile tile-tall\">\n          <div class=\"tile-media\"><div class=\"ph ph-c\"></div><img src=\"https://images.pexels.com/photos/28883533/pexels-photo-28883533.jpeg?auto=compress&cs=tinysrgb&w=500\" alt=\"Aurora borealis over a dark horizon — photo by Humam Musawwir on Pexels\" onerror=\"__crawlAsset&&__crawlAsset(this)\"></div>\n          <div class=\"tile-veil\"></div>\n        </article>\n\n        <article class=\"tile tile-tall\">\n          <div class=\"tile-media\"><div class=\"ph ph-d\"></div><img src=\"https://images.pexels.com/photos/11377054/pexels-photo-11377054.jpeg?auto=compress&cs=tinysrgb&w=500\" alt=\"Sunlit Saharan sand dunes — photo by raouf bedrani on Pexels\" onerror=\"__crawlAsset&&__crawlAsset(this)\"></div>\n          <div class=\"tile-veil\"></div>\n          <span class=\"badge badge-new\">NEW</span>\n        </article>\n\n        <article class=\"tile tile-tall\">\n          <div class=\"tile-media\"><div class=\"ph ph-e\"></div><img src=\"https://images.pexels.com/photos/5631314/pexels-photo-5631314.jpeg?auto=compress&cs=tinysrgb&w=500\" alt=\"Misty autumn forest — photo by Intens Media on Pexels\" onerror=\"__crawlAsset&&__crawlAsset(this)\"></div>\n          <div class=\"tile-veil\"></div>\n        </article>\n\n        <article class=\"tile tile-tall\">\n          <div class=\"tile-media\"><div class=\"ph ph-f\"></div><img src=\"https://images.pexels.com/photos/14025443/pexels-photo-14025443.jpeg?auto=compress&cs=tinysrgb&w=500\" alt=\"Long-exposure waterfall in a forest — photo by Selman Arif Golbasi on Pexels\" onerror=\"__crawlAsset&&__crawlAsset(this)\"></div>\n          <div class=\"tile-veil\"></div>\n          <span class=\"badge badge-new\">NEW</span>\n        </article>\n\n        <article class=\"tile tile-tall\">\n          <div class=\"tile-media\"><div class=\"ph ph-c\"></div><img src=\"https://images.pexels.com/photos/30498709/pexels-photo-30498709.jpeg?auto=compress&cs=tinysrgb&w=500\" alt=\"Misty evergreen forest on a winter morning — photo by AX on Pexels\" onerror=\"__crawlAsset&&__crawlAsset(this)\"></div>\n          <div class=\"tile-veil\"></div>\n        </article>\n\n      </div>\n    </div>\n\n    <div class=\"rail-controls\">\n      <button class=\"arrow\" aria-label=\"Previous\">\n        <svg width=\"17\" height=\"17\" viewBox=\"0 0 18 18\" fill=\"none\" aria-hidden=\"true\">\n          <path d=\"M11 3.4 5.4 9 11 14.6\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n        </svg>\n      </button>\n      <div class=\"dots\">\n        <span class=\"dot is-active\"></span><span class=\"dot\"></span><span class=\"dot\"></span>\n      </div>\n      <button class=\"arrow arrow-next\" aria-label=\"Next\">\n        <svg width=\"17\" height=\"17\" viewBox=\"0 0 18 18\" fill=\"none\" aria-hidden=\"true\">\n          <path d=\"M7 3.4 12.6 9 7 14.6\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n        </svg>\n      </button>\n    </div>\n  </section>\n</main>\n\n",
