    "var_2d12f68727fa": {
      "type": "variant",
      "label": "Recovery Altitude — Two-Rail Trailhead Header",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 868,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&family=Barlow+Condensed:wght@500;600;700&display=swap');\n\n  body {\n    margin: 0;\n    background: #fbfaf2;\n    color: #10232e;\n    font-family: 'Atkinson Hyperlegible', Arial, sans-serif;\n  }\n\n  .ra-shell {\n    min-height: 260px;\n    background: #fbfaf2;\n  }\n\n  .ra-header {\n    position: relative;\n    z-index: 10;\n    background: #fbfaf2;\n    border-top: 4px solid #10232e;\n    border-bottom: 1px solid #10232e;\n  }\n\n  .ra-desktop-rail {\n    height: 92px;\n  }\n\n  .ra-brand {\n    position: relative;\n    display: flex;\n    align-items: center;\n    height: 92px;\n    width: 248px;\n    flex: 0 0 248px;\n    overflow: visible;\n    border-right: 1px solid #4b817e;\n  }\n\n  .ra-brand::after {\n    content: '';\n    position: absolute;\n    right: -1px;\n    bottom: -8px;\n    width: 9px;\n    height: 16px;\n    background: #f1b34c;\n    clip-path: polygon(0 0, 100% 0, 100% 100%, 0 62%);\n  }\n\n  .ra-logo-window {\n    position: relative;\n    display: block;\n    width: 184px;\n    height: 78px;\n    overflow: hidden;\n    background: #fbfaf2;\n  }\n\n  .ra-logo-window img {\n    position: absolute;\n    left: 0;\n    top: -29px;\n    display: block;\n    width: 184px;\n    height: 184px;\n    max-width: none;\n    object-fit: contain;\n  }\n\n  .ra-descriptor {\n    font-family: 'Atkinson Hyperlegible', Arial, sans-serif;\n    font-size: 13px;\n    line-height: 1.1;\n    letter-spacing: 0.02em;\n    color: #10232e;\n  }\n\n  .ra-ui {\n    font-family: 'Barlow Condensed', Arial Narrow, sans-serif;\n    font-weight: 600;\n    letter-spacing: 0.045em;\n  }\n\n  .ra-nav-link {\n    position: relative;\n    display: inline-flex;\n    min-height: 44px;\n    align-items: center;\n    white-space: nowrap;\n    color: #10232e;\n    text-decoration: none;\n  }\n\n  .ra-nav-link::after {\n    content: '';\n    position: absolute;\n    left: 0;\n    right: 0;\n    bottom: 0;\n    height: 2px;\n    background: #10232e;\n    transform: scaleX(0);\n    transform-origin: left center;\n  }\n\n  .ra-nav-link:hover::after,\n  .ra-nav-link:focus-visible::after {\n    transform: scaleX(1);\n  }\n\n  .ra-nav-link[data-current='true']::before,\n  .ra-nav-link[data-current='true']::after {\n    content: '';\n    position: absolute;\n    bottom: -3px;\n    width: 5px;\n    height: 5px;\n    border-radius: 999px;\n    background: #f1b34c;\n    transform: none;\n  }\n\n  .ra-nav-link[data-current='true']::before {\n    left: 50%;\n    margin-left: -7px;\n  }\n\n  .ra-nav-link[data-current='true']::after {\n    left: 50%;\n    margin-left: 3px;\n  }\n\n  .ra-focus:focus-visible,\n  .ra-nav-link:focus-visible,\n  .ra-menu-button:focus-visible {\n    outline: 2px solid #10232e;\n    outline-offset: 3px;\n  }\n\n  .ra-cta {\n    display: inline-flex;\n    min-height: 44px;\n    align-items: center;\n    justify-content: center;\n    gap: 12px;\n    background: #f1b34c;\n    color: #10232e;\n    text-decoration: none;\n    clip-path: polygon(0 0, calc(100% - 9px) 0, 100% 9px, 100% 100%, 0 100%);\n  }\n\n  .ra-cta:hover {\n    background: #d99a32;\n  }\n\n  .ra-cta-arrow {\n    position: relative;\n    display: inline-block;\n    width: 18px;\n    height: 12px;\n    flex: 0 0 18px;\n  }\n\n  .ra-cta-arrow::before {\n    content: '';\n    position: absolute;\n    left: 0;\n    top: 5px;\n    width: 14px;\n    height: 2px;\n    background: #10232e;\n  }\n\n  .ra-cta-arrow::after {\n    content: '';\n    position: absolute;\n    right: 0;\n    top: 1px;\n    width: 8px;\n    height: 8px;\n    border-top: 2px solid #10232e;\n    border-right: 2px solid #10232e;\n    transform: rotate(45deg);\n  }\n\n  .ra-menu-button {\n    position: relative;\n    display: inline-flex;\n    height: 44px;\n    width: 44px;\n    align-items: center;\n    justify-content: center;\n    border: 1px solid #205f67;\n    background: #10232e;\n    color: #fbfaf2;\n    cursor: pointer;\n  }\n\n  .ra-menu-icon {\n    position: relative;\n    display: block;\n    width: 18px;\n    height: 14px;\n  }\n\n  .ra-menu-icon::before,\n  .ra-menu-icon::after,\n  .ra-menu-icon span {\n    content: '';\n    position: absolute;\n    left: 0;\n    width: 18px;\n    height: 2px;\n    background: #fbfaf2;\n  }\n\n  .ra-menu-icon::before { top: 0; }\n  .ra-menu-icon span { top: 6px; }\n  .ra-menu-icon::after { top: 12px; }\n\n  .ra-menu-button[data-open='true'] .ra-menu-icon::before {\n    top: 6px;\n    transform: rotate(45deg);\n  }\n\n  .ra-menu-button[data-open='true'] .ra-menu-icon span {\n    opacity: 0;\n  }\n\n  .ra-menu-button[data-open='true'] .ra-menu-icon::after {\n    top: 6px;\n    transform: rotate(-45deg);\n  }\n\n  .ra-mobile-menu[data-open='true'] {\n    display: block;\n  }\n\n  .ra-mobile-link {\n    display: flex;\n    min-height: 52px;\n    align-items: center;\n    border-bottom: 1px solid #4b817e;\n    color: #10232e;\n    text-decoration: none;\n  }\n\n  .ra-mobile-link:hover,\n  .ra-mobile-link:focus-visible {\n    background: #ffffff;\n  }\n\n  .ra-mobile-link[data-current='true'] .ra-mobile-dot {\n    background: #f1b34c;\n  }\n\n  .ra-mobile-dot {\n    display: inline-block;\n    width: 6px;\n    height: 6px;\n    margin-right: 12px;\n    border-radius: 999px;\n    background: #4b817e;\n  }\n\n  @media (max-width: 767px) {\n    .ra-header {\n      border-top-width: 4px;\n    }\n\n    .ra-logo-window {\n      width: 142px;\n      height: 58px;\n    }\n\n    .ra-logo-window img {\n      top: -23px;\n      width: 142px;\n      height: 142px;\n    }\n  }\n\n  @media (max-width: 389px) {\n    .ra-mobile-top-cta {\n      display: none;\n    }\n  }\n</style>\n<div class=\"ra-shell\" data-kid=\"1\" data-name=\"site shell container\">\n    <header aria-label=\"Recovery Altitude site header\" class=\"ra-header\" data-kid=\"1-1\" data-name=\"site header\">\n        <div class=\"ra-desktop-rail hidden md:block\" data-kid=\"1-1-1\" data-name=\"desktop navigation container\">\n            <div class=\"mx-auto flex h-full max-w-[1240px] px-8\" data-kid=\"1-1-1-1\" data-name=\"desktop inner layout container\">\n                <a aria-label=\"Recovery Altitude home\" class=\"ra-brand ra-focus\" data-kid=\"1-1-1-1-1\" data-name=\"site logo link\" href=\"#top\">\n                    <span aria-hidden=\"true\" class=\"ra-logo-window\" data-kid=\"1-1-1-1-1-1\" data-name=\"logo image mask container\">\n                        <img alt=\"Recovery Altitude\" data-kid=\"1-1-1-1-1-1-1\" data-name=\"logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/.kombai/canvas/assets/46e0ab9b748cbb2216d689a6ff64efa3e9c519ebdac355d9316e40df16a013c1.jpg\"/>\n                    </span>\n                </a>\n                <div class=\"min-w-0 flex-1\" data-kid=\"1-1-1-1-2\" data-name=\"desktop navigation and content wrapper\">\n                    <div class=\"flex h-[30px] items-center border-b border-[#4b817e] px-7\" data-kid=\"1-1-1-1-2-1\" data-name=\"descriptor text container\">\n                        <p class=\"ra-descriptor m-0\" data-kid=\"1-1-1-1-2-1-1\" data-name=\"site descriptor text\">\n                            Outdoor recovery & altitude wellness\n                        </p>\n                    </div>\n                    <div class=\"flex h-[62px] items-end gap-7 px-7\" data-kid=\"1-1-1-1-2-2\" data-name=\"navigation and CTA wrapper\">\n                        <nav aria-label=\"Primary navigation\" class=\"min-w-0 flex-1\" data-kid=\"1-1-1-1-2-2-1\" data-name=\"primary navigation menu\">\n                            <ul class=\"ra-ui m-0 flex h-[54px] items-end gap-8 p-0 text-[17px]\" data-kid=\"1-1-1-1-2-2-1-1\" data-name=\"navigation link list\">\n                                <li class=\"list-none\" data-kid=\"1-1-1-1-2-2-1-1-1\" data-name=\"navigation list item\">\n                                    <a aria-current=\"page\" class=\"ra-nav-link ra-focus pb-3\" data-current=\"true\" data-kid=\"1-1-1-1-2-2-1-1-1-1\" data-name=\"navigation link\" href=\"#programs\">\n                                        Programs\n                                    </a>\n                                </li>\n                                <li class=\"list-none\" data-kid=\"1-1-1-1-2-2-1-1-2\" data-name=\"navigation list item\">\n                                    <a class=\"ra-nav-link ra-focus pb-3\" data-kid=\"1-1-1-1-2-2-1-1-2-1\" data-name=\"navigation link\" href=\"#altitude-wellness\">\n                                        Altitude wellness\n                                    </a>\n                                </li>\n                                <li class=\"list-none\" data-kid=\"1-1-1-1-2-2-1-1-3\" data-name=\"navigation list item\">\n                                    <a class=\"ra-nav-link ra-focus pb-3\" data-kid=\"1-1-1-1-2-2-1-1-3-1\" data-name=\"navigation link\" href=\"#recovery-support\">\n                                        Recovery support\n                                    </a>\n                                </li>\n                                <li class=\"list-none\" data-kid=\"1-1-1-1-2-2-1-1-4\" data-name=\"navigation list item\">\n                                    <a class=\"ra-nav-link ra-focus pb-3\" data-kid=\"1-1-1-1-2-2-1-1-4-1\" data-name=\"navigation link\" href=\"#resources\">\n                                        Resources\n                                    </a>\n                                </li>\n                                <li class=\"list-none\" data-kid=\"1-1-1-1-2-2-1-1-5\" data-name=\"navigation list item\">\n                                    <a class=\"ra-nav-link ra-focus pb-3\" data-kid=\"1-1-1-1-2-2-1-1-5-1\" data-name=\"navigation link\" href=\"#about\">\n                                        About\n                                    </a>\n                                </li>\n                            </ul>\n                        </nav>\n                        <a class=\"ra-cta ra-ui ra-focus mb-1 w-[205px] shrink-0 px-5 text-[16px]\" data-kid=\"1-1-1-1-2-2-2\" data-name=\"book a consultation button\" href=\"#consultation\">\n                            Book a consultation\n                            <span aria-hidden=\"true\" class=\"ra-cta-arrow\" data-kid=\"1-1-1-1-2-2-2-1\" data-name=\"button arrow icon\">\n                            </span>\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <div class=\"md:hidden\" data-kid=\"1-1-2\" data-name=\"mobile navigation container\">\n            <div class=\"flex h-[64px] items-center justify-between gap-2 px-3\" data-kid=\"1-1-2-1\" data-name=\"mobile header bar\">\n                <a aria-label=\"Recovery Altitude home\" class=\"ra-focus flex min-w-0 items-center\" data-kid=\"1-1-2-1-1\" data-name=\"mobile home link\" href=\"#top\">\n                    <span aria-hidden=\"true\" class=\"ra-logo-window\" data-kid=\"1-1-2-1-1-1\" data-name=\"mobile logo image mask container\">\n                        <img alt=\"Recovery Altitude\" data-kid=\"1-1-2-1-1-1-1\" data-name=\"mobile logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/.kombai/canvas/assets/46e0ab9b748cbb2216d689a6ff64efa3e9c519ebdac355d9316e40df16a013c1.jpg\"/>\n                    </span>\n                </a>\n                <div class=\"flex shrink-0 items-center gap-2\" data-kid=\"1-1-2-1-2\" data-name=\"mobile utility wrapper\">\n                    <a class=\"ra-mobile-top-cta ra-cta ra-ui ra-focus min-h-[44px] px-3 text-[14px]\" data-kid=\"1-1-2-1-2-1\" data-name=\"mobile book a consultation button\" href=\"#consultation\">\n                        Book a consultation\n                        <span aria-hidden=\"true\" class=\"ra-cta-arrow\" data-kid=\"1-1-2-1-2-1-1\" data-name=\"mobile button arrow icon\">\n                        </span>\n                    </a>\n                    <button aria-controls=\"recovery-altitude-mobile-menu\" aria-expanded=\"false\" aria-label=\"Menu\" class=\"ra-menu-button ra-focus\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2-2\" data-menu-toggle=\"\" data-name=\"mobile menu toggle button\" data-open=\"false\" data-reason=\"attributes (aria-expanded, data-open) and state toggled by script\" type=\"button\">\n                        <span aria-hidden=\"true\" class=\"ra-menu-icon\" data-kid=\"1-1-2-1-2-2-1\" data-name=\"hamburger menu icon\">\n                            <span data-kid=\"1-1-2-1-2-2-1-1\" data-name=\"hamburger middle bar\">\n                            </span>\n                        </span>\n                        <span class=\"sr-only\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2-2-2\" data-menu-label=\"\" data-name=\"toggle button label text\" data-reason=\"text replaced between 'Menu' and 'Close menu' by script\">\n                            Menu\n                        </span>\n                    </button>\n                </div>\n            </div>\n            <div class=\"ra-mobile-menu hidden border-t-2 border-[#205f67] bg-[#fbfaf2]\" data-dynamic=\"true\" data-kid=\"1-1-2-2\" data-menu-panel=\"\" data-name=\"mobile menu panel\" data-open=\"false\" data-reason=\"display state toggled by script\" id=\"recovery-altitude-mobile-menu\">\n                <div class=\"px-4 pb-3 pt-4\" data-kid=\"1-1-2-2-1\" data-name=\"mobile descriptor text container\">\n                    <p class=\"ra-descriptor m-0\" data-kid=\"1-1-2-2-1-1\" data-name=\"mobile descriptor text\">\n                        Outdoor recovery & altitude wellness\n                    </p>\n                </div>\n                <nav aria-label=\"Mobile primary navigation\" data-kid=\"1-1-2-2-2\" data-name=\"mobile navigation list container\">\n                    <ul class=\"ra-ui m-0 p-0 text-[18px]\" data-kid=\"1-1-2-2-2-1\" data-name=\"mobile navigation link list\">\n                        <li class=\"list-none\" data-kid=\"1-1-2-2-2-1-1\" data-name=\"mobile list item\">\n                            <a aria-current=\"page\" class=\"ra-mobile-link ra-focus px-4\" data-current=\"true\" data-kid=\"1-1-2-2-2-1-1-1\" data-name=\"mobile navigation link\" href=\"#programs\">\n                                <span class=\"ra-mobile-dot\" data-kid=\"1-1-2-2-2-1-1-1-1\" data-name=\"link active dot\">\n                                </span>\n                                Programs\n                            </a>\n                        </li>\n                        <li class=\"list-none\" data-kid=\"1-1-2-2-2-1-2\" data-name=\"mobile list item\">\n                            <a class=\"ra-mobile-link ra-focus px-4\" data-kid=\"1-1-2-2-2-1-2-1\" data-name=\"mobile navigation link\" href=\"#altitude-wellness\">\n                                <span class=\"ra-mobile-dot\" data-kid=\"1-1-2-2-2-1-2-1-1\" data-name=\"link active dot\">\n                                </span>\n                                Altitude wellness\n                            </a>\n                        </li>\n                        <li class=\"list-none\" data-kid=\"1-1-2-2-2-1-3\" data-name=\"mobile list item\">\n                            <a class=\"ra-mobile-link ra-focus px-4\" data-kid=\"1-1-2-2-2-1-3-1\" data-name=\"mobile navigation link\" href=\"#recovery-support\">\n                                <span class=\"ra-mobile-dot\" data-kid=\"1-1-2-2-2-1-3-1-1\" data-name=\"link active dot\">\n                                </span>\n                                Recovery support\n                            </a>\n                        </li>\n                        <li class=\"list-none\" data-kid=\"1-1-2-2-2-1-4\" data-name=\"mobile list item\">\n                            <a class=\"ra-mobile-link ra-focus px-4\" data-kid=\"1-1-2-2-2-1-4-1\" data-name=\"mobile navigation link\" href=\"#resources\">\n                                <span class=\"ra-mobile-dot\" data-kid=\"1-1-2-2-2-1-4-1-1\" data-name=\"link active dot\">\n                                </span>\n                                Resources\n                            </a>\n                        </li>\n                        <li class=\"list-none\" data-kid=\"1-1-2-2-2-1-5\" data-name=\"mobile list item\">\n                            <a class=\"ra-mobile-link ra-focus px-4\" data-kid=\"1-1-2-2-2-1-5-1\" data-name=\"mobile navigation link\" href=\"#about\">\n                                <span class=\"ra-mobile-dot\" data-kid=\"1-1-2-2-2-1-5-1-1\" data-name=\"link active dot\">\n                                </span>\n                                About\n                            </a>\n                        </li>\n                    </ul>\n                </nav>\n                <div class=\"p-4\" data-kid=\"1-1-2-2-3\" data-name=\"mobile button container\">\n                    <a class=\"ra-cta ra-ui ra-focus flex w-full px-5 text-[16px]\" data-kid=\"1-1-2-2-3-1\" data-name=\"mobile book a consultation button\" href=\"#consultation\">\n                        Book a consultation\n                        <span aria-hidden=\"true\" class=\"ra-cta-arrow\" data-kid=\"1-1-2-2-3-1-1\" data-name=\"mobile button arrow icon\">\n                        </span>\n                    </a>\n                </div>\n            </div>\n        </div>\n    </header>\n    <div aria-hidden=\"true\" class=\"h-[164px] border-b border-[#4b817e] bg-[#fbfaf2]\" data-kid=\"1-2\" data-name=\"spacer section\">\n    </div>\n</div>\n<script>\n    (() => {\n    const toggle = document.querySelector('[data-menu-toggle]');\n    const panel = document.querySelector('[data-menu-panel]');\n    const label = document.querySelector('[data-menu-label]');\n    if (!toggle || !panel || !label) return;\n\n    const setMenu = (open) => {\n      toggle.dataset.open = String(open);\n      panel.dataset.open = String(open);\n      toggle.setAttribute('aria-expanded', String(open));\n      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Menu');\n      label.textContent = open ? 'Close menu' : 'Menu';\n      panel.classList.toggle('hidden', !open);\n    };\n\n    toggle.addEventListener('click', () => setMenu(toggle.dataset.open !== 'true'));\n    document.addEventListener('keydown', (event) => {\n      if (event.key === 'Escape' && toggle.dataset.open === 'true') {\n        setMenu(false);\n        toggle.focus();\n      }\n    });\n    panel.querySelectorAll('a').forEach((link) => {\n      link.addEventListener('click', () => setMenu(false));\n    });\n  })();\n</script>\n",
