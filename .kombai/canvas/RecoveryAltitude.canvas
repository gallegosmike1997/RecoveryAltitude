      "html": "<style>\n  :root{\n    --bg:#eae7e2;\n    --panel:#fbfaf8;\n    --soft:#f3f0ec;\n    --card:#ffffff;\n    --ink:#191614;\n    --ink-2:#3f3a35;\n    --muted:#6b645d;\n    --line:#dbd6cf;\n    --line-soft:#e3ded7;\n    --accent:#9a4520;\n    --accent-hi:#b2582d;\n    --accent-wash:#f4e7e0;\n    --radius-panel:16px;\n    --radius-chip:10px;\n    --ease:cubic-bezier(0.16,1,0.3,1);\n    --shadow-card:0 1px 2px rgba(60,44,32,.05), 0 10px 24px -18px rgba(60,44,32,.35);\n  }\n\n  *,*::before,*::after{box-sizing:border-box}\n  html,body{height:100%}\n  body{\n    margin:0;\n    position:relative;\n    background:var(--bg);\n    color:var(--ink);\n    font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n    -webkit-font-smoothing:antialiased;\n    text-rendering:optimizeLegibility;\n  }\n  h1,h2,p,figure{margin:0}\n  a{color:inherit;text-decoration:none}\n  button{font:inherit;color:inherit;background:none;border:0;padding:0}\n  svg{display:block}\n  ::selection{background:var(--accent-wash);color:var(--ink)}\n  :focus-visible{outline:2px solid var(--accent);outline-offset:3px;border-radius:6px}\n  @media (prefers-reduced-motion:reduce){*{transition:none!important}}\n\n  /* ---------- shell ---------- */\n  .app{\n    display:flex;\n    align-items:stretch;\n    min-height:100vh;\n    padding-top:12px;\n    padding-bottom:12px;\n    padding-left:12px;\n    padding-right:0;\n  }\n\n  /* ---------- icon rail ---------- */\n  .rail{\n    flex:0 0 60px;\n    width:60px;\n    display:flex;\n    flex-direction:column;\n    align-items:center;\n    padding:8px;\n    background:var(--panel);\n    border-radius:var(--radius-panel);\n    box-shadow:inset 0 0 0 1px rgba(84,71,58,.05), 0 1px 2px rgba(60,44,32,.05);\n  }\n  .brand{\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    width:44px;\n    height:44px;\n    border-radius:13px;\n    background:var(--accent);\n    box-shadow:0 8px 18px -12px rgba(102,45,20,.65);\n  }\n  .rail-nav{\n    display:flex;\n    flex-direction:column;\n    align-items:center;\n    gap:6px;\n    margin-top:15px;\n    width:44px;\n  }\n  .rail-btn{\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    width:44px;\n    height:36px;\n    border-radius:var(--radius-chip);\n    color:var(--ink-2);\n    transition:background-color .18s var(--ease), color .18s var(--ease);\n  }\n  .rail-btn:hover{background:var(--soft);color:var(--ink)}\n  .rail-btn.is-current{background:var(--card);color:var(--ink);box-shadow:0 1px 2px rgba(60,44,32,.10), inset 0 0 0 1px rgba(84,71,58,.05)}\n  .rail-foot{margin-top:auto;width:44px;display:flex;justify-content:center}\n\n  /* ---------- main column ---------- */\n  .main{\n    flex:1 1 auto;\n    min-width:0;\n    display:flex;\n    flex-direction:column;\n    padding-top:12px;\n    padding-bottom:0;\n    padding-left:41px;\n    padding-right:42px;\n  }\n\n  /* ---------- project header ---------- */\n  .head{\n    display:flex;\n    align-items:center;\n    height:77px;\n    padding-left:13px;\n  }\n  .back{\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    width:18px;\n    height:18px;\n    color:var(--ink-2);\n    transition:transform .2s var(--ease), color .2s var(--ease);\n  }\n  .back:hover{color:var(--ink);transform:translateX(-2px)}\n  .crest{\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    width:29px;\n    height:29px;\n    margin-left:21px;\n    border:1.6px solid var(--ink);\n    border-radius:50%;\n    font-size:14px;\n    font-weight:700;\n    letter-spacing:.2px;\n    line-height:1;\n  }\n  .head h1{\n    margin-left:11px;\n    font-size:24px;\n    font-weight:700;\n    letter-spacing:-.35px;\n    line-height:1.1;\n  }\n\n  /* ---------- tab strip ---------- */\n  .tabs{\n    display:flex;\n    align-items:stretch;\n    height:48px;\n    border-bottom:1px solid var(--line);\n  }\n  .tab{\n    position:relative;\n    display:flex;\n    align-items:center;\n    gap:10px;\n    padding-left:22px;\n    padding-right:22px;\n    font-size:15px;\n    font-weight:600;\n    letter-spacing:-.1px;\n    color:var(--ink);\n    transition:color .18s var(--ease);\n  }\n  .tab svg{flex:0 0 auto}\n  .tab:hover{color:var(--accent-hi)}\n  .tab.is-active{color:var(--accent)}\n  .tab.is-active::after{\n    content:\"\";\n    position:absolute;\n    left:0;\n    right:0;\n    bottom:-1px;\n    height:2px;\n    border-radius:2px 2px 0 0;\n    background:var(--accent);\n  }\n\n  /* ---------- content pane ---------- */\n  .pane{\n    flex:1 1 auto;\n    min-height:0;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    padding-bottom:56px;\n  }\n  .empty{\n    display:flex;\n    flex-direction:column;\n    align-items:center;\n    text-align:center;\n    max-width:520px;\n  }\n  .empty-mark{\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    width:85px;\n    height:85px;\n    margin-bottom:17px;\n    border-radius:50%;\n    background:var(--soft);\n    color:var(--muted);\n    box-shadow:inset 0 0 0 1px rgba(101,90,80,.06);\n  }\n  .empty h2{\n    margin-bottom:9px;\n    font-size:24px;\n    font-weight:700;\n    letter-spacing:-.4px;\n    line-height:1.3;\n    color:var(--ink);\n  }\n  .empty p{\n    max-width:470px;\n    font-size:15px;\n    line-height:1.47;\n    color:var(--muted);\n  }\n\n  /* ---------- edge tab ---------- */\n  .edge-tab{\n    position:fixed;\n    top:50%;\n    right:0;\n    /* rotate the whole tab so vertical text reads bottom-to-top */\n    transform:translateY(-50%) rotate(180deg);\n    transform-origin:center;\n    display:flex;\n    flex-direction:row;      /* in vertical-rl this stacks children vertically */\n    align-items:center;\n    justify-content:center;\n    gap:13px;\n    width:41px;\n    height:145px;\n    border-radius:0 11px 11px 0;   /* becomes left-rounded after the rotation */\n    background:var(--accent);\n    color:#fdf7f3;\n    font-size:14px;\n    font-weight:600;\n    letter-spacing:.1px;\n    writing-mode:vertical-rl;\n    box-shadow:8px 0 22px -14px rgba(60,30,12,.7);\n    transition:background-color .2s var(--ease);\n  }\n  .edge-tab:hover{background:var(--accent-hi)}\n  .edge-tab svg{transform:rotate(180deg)}   /* keep the glyph upright inside the rotated tab */\n</style>\n\n\n<div class=\"app\">\n\n  <aside class=\"rail\">\n    <a class=\"brand\" href=\"#\" aria-label=\"Slatewick home\">\n      <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n        <path d=\"M12 3.1 5.3 7.5v9L12 20.9l6.7-4.4v-9z\" fill=\"#fdf7f3\"/>\n        <path d=\"M12 3.1 5.3 7.5 12 11.9l6.7-4.4z\" fill=\"#9a4520\" opacity=\".3\"/>\n        <path d=\"M12 11.9v9l6.7-4.4v-9z\" fill=\"#9a4520\" opacity=\".16\"/>\n      </svg>\n    </a>\n\n    <div class=\"rail-nav\">\n      <a class=\"rail-btn\" href=\"#\" aria-label=\"Schedule\">\n        <svg width=\"18\" height=\"18\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" aria-hidden=\"true\">\n          <rect x=\"2.6\" y=\"4.3\" width=\"14.8\" height=\"13.1\" rx=\"3\"/>\n          <path d=\"M6.4 2.4v3.4M13.6 2.4v3.4M2.6 8.4h14.8\"/>\n        </svg>\n      </a>\n      <a class=\"rail-btn is-current\" href=\"#\" aria-label=\"Projects\" aria-current=\"page\">\n        <svg width=\"18\" height=\"18\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n          <path d=\"M2.7 15.6V4.9a1.4 1.4 0 0 1 1.4-1.4h3.1l1.9 2.2h5a1.4 1.4 0 0 1 1.4 1.4v.9\"/>\n          <path d=\"M2.7 15.6 4.9 9.2h13.1l-2.2 6.4a1.4 1.4 0 0 1-1.3 1H4a1.4 1.4 0 0 1-1.3-1z\"/>\n        </svg>\n      </a>\n      <a class=\"rail-btn\" href=\"#\" aria-label=\"People\">\n        <svg width=\"18\" height=\"18\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n          <rect x=\"2.8\" y=\"3.3\" width=\"14.4\" height=\"13.4\" rx=\"3\"/>\n          <circle cx=\"10\" cy=\"8.4\" r=\"2.1\"/>\n          <path d=\"M6.6 13.9c.7-1.4 2-2.1 3.4-2.1s2.7.7 3.4 2.1\"/>\n        </svg>\n      </a>\n      <a class=\"rail-btn\" href=\"#\" aria-label=\"Assistant\">\n        <svg width=\"18\" height=\"18\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n          <rect x=\"3.1\" y=\"6.4\" width=\"13.8\" height=\"10.2\" rx=\"3.2\"/>\n          <path d=\"M10 3.1v3.3\"/>\n          <circle cx=\"10\" cy=\"2.7\" r=\"1\"/>\n          <path d=\"M7.5 10.7v1.6M12.5 10.7v1.6\"/>\n        </svg>\n      </a>\n    </div>\n\n    <div class=\"rail-foot\">\n      <a class=\"rail-btn\" href=\"#\" aria-label=\"Your account\">\n        <svg width=\"18\" height=\"18\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n          <circle cx=\"10\" cy=\"6.6\" r=\"3.1\"/>\n          <path d=\"M3.9 17c.8-3 3.2-4.6 6.1-4.6s5.3 1.6 6.1 4.6\"/>\n        </svg>\n      </a>\n    </div>\n  </aside>\n\n  <main class=\"main\">\n\n    <header class=\"head\">\n      <a class=\"back\" href=\"#\" aria-label=\"Back to projects\">\n        <svg width=\"18\" height=\"18\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n          <path d=\"M16.2 10H4.4M9.1 4.9 4 10l5.1 5.1\"/>\n        </svg>\n      </a>\n      <span class=\"crest\" aria-hidden=\"true\">D</span>\n      <h1>Driftwood</h1>\n    </header>\n\n    <nav class=\"tabs\" aria-label=\"Project sections\">\n      <a class=\"tab\" href=\"#\">\n        <svg width=\"18\" height=\"18\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n          <rect x=\"2.7\" y=\"3.4\" width=\"6\" height=\"13.2\" rx=\"2\"/>\n          <rect x=\"11.3\" y=\"3.4\" width=\"6\" height=\"8.4\" rx=\"2\"/>\n        </svg>\n        Board\n      </a>\n      <a class=\"tab\" href=\"#\">\n        <svg width=\"18\" height=\"18\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n          <rect x=\"6.6\" y=\"2.7\" width=\"10.7\" height=\"12.6\" rx=\"2.6\"/>\n          <path d=\"M13.4 17.3H5.3a2.6 2.6 0 0 1-2.6-2.6V6.6\"/>\n        </svg>\n        Assets\n      </a>\n      <a class=\"tab is-active\" href=\"#\" aria-current=\"page\">\n        <svg width=\"18\" height=\"18\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n          <path d=\"M17.1 9.5c0 3.4-3.2 6.1-7.1 6.1a8 8 0 0 1-2.4-.35L3.4 16.6l1.2-3.1A5.7 5.7 0 0 1 2.9 9.5c0-3.4 3.2-6.1 7.1-6.1s7.1 2.7 7.1 6.1z\"/>\n        </svg>\n        Threads\n      </a>\n      <a class=\"tab\" href=\"#\">\n        <svg width=\"18\" height=\"18\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n          <path d=\"M11.2 2.6H6.1a2.5 2.5 0 0 0-2.5 2.5v9.8a2.5 2.5 0 0 0 2.5 2.5h7.8a2.5 2.5 0 0 0 2.5-2.5V7.4z\"/>\n          <path d=\"M11.2 2.6v4.8h5.2M7 11.2h6M7 13.9h4\"/>\n        </svg>\n        Overview\n      </a>\n    </nav>\n\n    <section class=\"pane\">\n      <div class=\"empty\">\n        <figure class=\"empty-mark\">\n          <svg width=\"34\" height=\"34\" viewBox=\"0 0 34 34\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n            <path d=\"M29.3 16.2c0 5.8-5.5 10.5-12.3 10.5-1.4 0-2.8-.2-4.1-.6l-6.2 2.1 2-5.3c-2.5-1.9-4-4.7-4-6.7C4.7 10.4 10.2 5.7 17 5.7s12.3 4.7 12.3 10.5z\"/>\n          </svg>\n        </figure>\n        <h2>This project has no threads</h2>\n        <p>Open a thread to reason through Driftwood with the workspace assistant. It reads every brief and file pinned to this project.</p>\n      </div>\n    </section>\n\n  </main>\n</div>\n\n<a class=\"edge-tab\" href=\"#\">\n  <svg width=\"15\" height=\"15\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n    <path d=\"M16.9 12.2a1.9 1.9 0 0 1-1.9 1.9H6.6L2.8 17.9V5.1a1.9 1.9 0 0 1 1.9-1.9H15a1.9 1.9 0 0 1 1.9 1.9z\"/>\n  </svg>\n  <span class=\"edge-label\">Feedback</span>\n</a>\n\n",
