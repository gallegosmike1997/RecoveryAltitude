      "html": "<style>\n  :root{\n    --page:#fafbfb;\n    --panel:#fefefe;\n    --bar:#eff5f6;\n    --ink:#151c1d;\n    --ink-2:#505d60;\n    --ink-3:#788b8f;\n    --line:rgba(21,28,29,.10);\n    --line-soft:rgba(21,28,29,.055);\n    --accent:#16719c;\n    --accent-deep:#0f5c80;\n    --accent-soft:#e2f8fc;\n    --radius-s:8px;\n    --radius-l:14px;\n    --ease:cubic-bezier(0.16,1,0.3,1);\n    --shadow-panel:0 26px 46px -30px rgba(17,39,43,.38), 0 1px 0 0 rgba(21,28,29,.045);\n    --focus:0 0 0 2px var(--page), 0 0 0 4px rgba(22,113,156,.55);\n    --font:-apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Segoe UI\", Arial, sans-serif;\n    --mono:ui-monospace, \"SF Mono\", SFMono-Regular, Menlo, \"Roboto Mono\", monospace;\n  }\n\n  *{box-sizing:border-box}\n  html,body{margin:0;padding:0}\n  body{\n    position:relative;              /* containing block for the mega-menu */\n    background:var(--page);\n    color:var(--ink);\n    font-family:var(--font);\n    font-size:14.5px;\n    line-height:1.45;\n    -webkit-font-smoothing:antialiased;\n  }\n  a{color:inherit;text-decoration:none}\n  a:focus-visible{outline:none;box-shadow:var(--focus);border-radius:6px}\n  ul{list-style:none;margin:0;padding:0}\n  h1,h2,h3,p{margin:0}\n  button{font:inherit;color:inherit;border:0;background:none;cursor:pointer}\n\n  .wrap{width:1030px;margin:0 auto}\n\n  /* ---------- announcement ---------- */\n  .promo{\n    height:38px;background:var(--bar);\n    display:flex;align-items:center;justify-content:center;\n    font-size:13.5px;color:var(--ink);\n    border-bottom:1px solid var(--line-soft);\n  }\n  .promo b{font-weight:650;margin-right:5px}\n  .promo .promo-link{display:inline-flex;align-items:center;gap:6px;color:var(--ink);transition:opacity .3s var(--ease)}\n  .promo .promo-link:hover{opacity:.62}\n  .promo svg{display:block}\n\n  /* ---------- header ---------- */\n  .topbar{\n    height:56px;background:var(--panel);\n    border-bottom:1px solid transparent;\n    position:relative;z-index:60;\n  }\n  .topbar .wrap{height:100%;display:flex;align-items:center}\n\n  .brand{display:flex;align-items:center;gap:7px;margin-right:6px}\n  .brand-mark{display:block;width:23px;height:23px;flex:0 0 auto}\n  .brand-name{font-size:18px;font-weight:700;letter-spacing:-.03em}\n\n  .nav{display:flex;align-items:center;gap:4px}\n  .nav-item{\n    display:inline-flex;align-items:center;gap:5px;\n    padding:7px 11px;border-radius:var(--radius-s);\n    font-size:14.5px;font-weight:500;letter-spacing:-.006em;color:var(--ink);\n    transition:background-color .3s var(--ease), opacity .3s var(--ease);\n  }\n  .nav-item:hover{background:rgba(21,28,29,.045)}\n  .nav-item.is-open{background:#eaf1f2}\n  .nav-item .chev{display:block;opacity:.62}\n\n  .actions{margin-left:auto;display:flex;align-items:center;gap:9px}\n  .link-btn{padding:7px 4px;font-size:14.5px;font-weight:500;transition:opacity .3s var(--ease)}\n  .link-btn:hover{opacity:.6}\n  .pill-btn{\n    padding:6px 13px;border-radius:var(--radius-s);\n    background:#eaf1f2;font-size:14.5px;font-weight:650;\n    transition:transform .35s var(--ease), background-color .35s var(--ease);\n  }\n  .pill-btn:hover{background:#e0e8ea;transform:translateY(-1px)}\n  .dark-btn{\n    padding:6px 17px;border-radius:var(--radius-s);\n    background:var(--ink);color:#fafbfb;font-size:14.5px;font-weight:650;\n    box-shadow:0 8px 18px -12px rgba(16,29,32,.7);\n    transition:transform .35s var(--ease), background-color .35s var(--ease);\n  }\n  .dark-btn:hover{background:#222d2f;transform:translateY(-1px)}\n\n  /* ---------- open mega-menu ---------- */\n  .mega{\n    position:absolute;top:94px;left:0;right:0;z-index:50;\n    background:var(--panel);\n    box-shadow:var(--shadow-panel);\n  }\n  .mega .wrap{\n    display:grid;\n    grid-template-columns:214px 216px minmax(0,1fr);\n    padding:20px 0 53px;\n  }\n  .mega-col{min-width:0}\n  .col-label{\n    font-size:12px;font-weight:500;line-height:12px;\n    letter-spacing:.075em;text-transform:uppercase;color:var(--ink-3);\n  }\n  .mega-list{margin-top:16px;display:flex;flex-direction:column;gap:12px}\n  .mega-list a{\n    display:block;line-height:19px;font-size:14.5px;font-weight:500;\n    letter-spacing:-.008em;color:var(--ink);width:max-content;\n    transition:color .3s var(--ease), transform .3s var(--ease);\n  }\n  .mega-list a:hover{color:var(--accent);transform:translateX(2px)}\n\n  .kits{margin-top:15px;display:flex;flex-direction:column;gap:21px}\n  .kit{display:flex;align-items:flex-start;gap:8px;transition:transform .35s var(--ease)}\n  .kit:hover{transform:translateX(2px)}\n  .kit-ico{display:block;width:40px;height:40px;flex:0 0 auto;border-radius:11px}\n  .kit-txt{min-width:0;padding-top:1px}\n  .kit-txt h3{font-size:14.5px;font-weight:650;line-height:19px;letter-spacing:-.01em}\n  .kit-txt p{font-size:14.5px;line-height:19px;color:var(--ink-2);margin-top:2px}\n  .kits-more{\n    display:inline-block;margin-top:22px;\n    font-size:14.5px;font-weight:650;line-height:19px;\n    border-bottom:1px solid transparent;\n    transition:border-color .3s var(--ease)\n  }\n  .kits-more:hover{border-bottom-color:var(--ink)}\n\n  /* ---------- hero ---------- */\n  .hero{position:relative;overflow:hidden;background:var(--page)}\n  .hero .wrap{position:relative}\n  .hero-copy{position:relative;z-index:2;padding-top:86px;max-width:520px}\n  .hero h1{\n    font-size:44px;line-height:47px;font-weight:700;\n    letter-spacing:-.032em;color:var(--ink);max-width:9.6em;\n  }\n  .hero-sub{\n    margin-top:22px;max-width:472px;\n    font-size:18px;line-height:27px;color:var(--ink-2);letter-spacing:-.006em;\n  }\n\n  .cta-row{display:flex;align-items:flex-start;gap:14px;margin-top:20px}\n  .cta{\n    height:50px;padding:0 24px;border-radius:var(--radius-l);\n    background:var(--ink);color:#fafbfb;\n    font-size:20px;font-weight:700;letter-spacing:-.022em;\n    display:inline-flex;align-items:center;\n    box-shadow:0 18px 32px -20px rgba(16,29,32,.66);\n    transition:transform .4s var(--ease), background-color .4s var(--ease);\n  }\n  .cta:hover{background:#222d2f;transform:translateY(-2px)}\n  .cta-note{padding-top:5px;font-size:14.5px;line-height:22px;color:var(--ink-2)}\n\n  .eyebrow{\n    margin-top:48px;\n    font-family:var(--mono);font-size:11px;line-height:12px;\n    letter-spacing:.09em;text-transform:uppercase;color:var(--ink-2);\n  }\n\n  .chips{margin-top:19px;display:flex;flex-wrap:wrap;gap:7px;max-width:460px}\n  .chip{\n    position:relative;height:30px;padding:0 11px;border-radius:999px;\n    border:1px dashed rgba(21,28,29,.22);\n    display:inline-flex;align-items:center;\n    font-size:15px;font-weight:500;letter-spacing:-.01em;color:var(--ink);\n    background:var(--panel);\n    transition:border-color .35s var(--ease), transform .35s var(--ease);\n  }\n  .chip:hover{border-color:rgba(21,28,29,.42);transform:translateY(-1px)}\n  .chip.is-on{\n    border:1px solid var(--accent);background:var(--accent-soft);\n    color:var(--accent-deep);font-weight:650;\n  }\n  .chip-tick{\n    position:absolute;top:-6px;right:-6px;\n    width:17px;height:17px;border-radius:50%;\n    background:var(--accent);\n    display:flex;align-items:center;justify-content:center;\n    box-shadow:0 0 0 2.5px var(--page);\n  }\n  .chip-tick svg{display:block}\n\n  /* ---------- product mock ---------- */\n  .mock{\n    position:absolute;top:292px;left:558px;   /* offsets are relative to .hero .wrap */\n    width:626px;height:300px;\n    z-index:1;pointer-events:none;\n  }\n  .mock-fade{\n    position:absolute;inset:0;z-index:3;\n    background:linear-gradient(to bottom, rgba(250,251,251,0) 74%, var(--page) 99%);\n  }\n  .mock-inner{position:absolute;inset:0;display:flex;overflow:hidden}\n  .mock-rail{\n    width:42px;flex:0 0 auto;\n    background:linear-gradient(to bottom,#0b1213 0%,#0b1213 60%,#475457 80%, #d7ddde 97%);\n  }\n  .mock-side{\n    width:202px;flex:0 0 auto;background:#f3f8f9;\n    border-right:1px solid var(--line-soft);\n    padding:6px 12px 0;\n  }\n  .mock-main{flex:1 1 auto;min-width:0;background:var(--panel);padding:4px 0 0 34px}\n\n  .m-head{display:flex;align-items:center;gap:7px;height:22px;color:var(--ink-2);font-size:15px}\n  .m-head svg{display:block;flex:0 0 auto}\n  .m-row{display:flex;align-items:center;gap:9px;height:25.5px;font-size:15px;letter-spacing:-.01em}\n  .m-av{\n    display:block;width:20px;height:20px;border-radius:50%;flex:0 0 auto;\n    object-fit:cover;background:#d6ddde;\n  }\n  .m-name{font-weight:650;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}\n  .m-name.plain{font-weight:400;color:#394649}\n  .m-count{\n    margin-left:auto;flex:0 0 auto;\n    min-width:19px;height:19px;padding:0 5px;border-radius:999px;\n    background:#b8365f;color:#fff;font-size:11.5px;font-weight:650;\n    display:inline-flex;align-items:center;justify-content:center;\n  }\n  .m-label{margin-top:22px;font-size:14px;color:var(--ink-2)}\n  .m-space{\n    margin-top:6px;display:flex;align-items:center;gap:9px;height:27px;\n    padding:0 8px;margin-left:-8px;margin-right:-8px;\n    border-radius:7px;background:#e7edee;font-size:15px;font-weight:500;\n  }\n  .m-sq{display:block;width:19px;height:19px;border-radius:5px;flex:0 0 auto}\n  .m-sub{display:flex;align-items:center;gap:9px;height:26px;padding-left:20px;font-size:15px;color:#576467}\n  .m-sub.dim{color:#a5b2b5}\n  .m-sub.dimmer{color:#cdd4d5}\n\n  .t-row{\n    display:flex;align-items:center;gap:10px;height:31px;\n    border-bottom:1px solid var(--line-soft);\n    font-size:15px;letter-spacing:-.01em;color:#222e31;\n    padding-right:34px;\n  }\n  .t-row.no-line{border-bottom:0}\n  .t-av{display:block;width:22px;height:22px;border-radius:50%;flex:0 0 auto;object-fit:cover;background:#d6ddde}\n  .t-right{margin-left:auto;display:flex;align-items:center;gap:5px;flex:0 0 auto}\n  .t-muted{color:#97a4a7}\n  .t-group{display:flex;align-items:center;gap:8px;height:38px;margin-top:12px}\n  .t-chip{\n    display:inline-flex;align-items:center;gap:6px;height:24px;padding:0 11px;\n    border-radius:6px;background:var(--accent);color:#fff;\n    font-size:12.5px;font-weight:700;letter-spacing:.045em;\n  }\n  .t-meta{display:inline-flex;align-items:center;gap:3px;font-size:13px;color:#97a4a7}\n  .t-faded{opacity:.42}\n\n  /* ---------- logo band ---------- */\n  .logos{background:var(--page);padding-top:147px;padding-bottom:36px}\n  .logos .wrap{display:flex;align-items:center;justify-content:space-between;gap:24px}\n  .logos-label{\n    font-size:12px;line-height:12px;letter-spacing:.14em;\n    text-transform:uppercase;color:#77888b;white-space:nowrap;\n  }\n  .logo-mk{\n    color:#667376;display:flex;align-items:center;gap:6px;opacity:.9;\n    transition:opacity .4s var(--ease), transform .4s var(--ease);\n  }\n  .logo-mk:hover{opacity:1;transform:translateY(-1px)}\n  .logo-mk svg{display:block}\n  .lm-1{font-size:26px;font-weight:600;letter-spacing:-.045em}\n  .lm-2{font-size:19px;font-weight:800;letter-spacing:.04em}\n  .lm-3{font-size:25px;font-weight:500;letter-spacing:-.02em;font-style:italic}\n  .lm-4{font-size:23px;font-weight:700;letter-spacing:-.03em}\n  .lm-5{font-size:23px;font-weight:600;letter-spacing:-.01em}\n  .lm-6{font-size:12.5px;font-weight:600;letter-spacing:.1em;line-height:1.15;text-align:left}\n  .lm-6 span{display:block;font-size:9.5px;font-weight:500;letter-spacing:.16em;color:#97a4a7}\n</style>\n\n\n  <!-- announcement -->\n  <div class=\"promo\">\n    <a class=\"promo-link\" href=\"#\"><b>Marlbeck 3.4 is here:</b> quieter, quicker, less clicking. See what changed\n      <svg width=\"7\" height=\"11\" viewBox=\"0 0 7 11\" fill=\"none\" aria-hidden=\"true\"><path d=\"M1.2 1.2 5.4 5.5 1.2 9.8\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n    </a>\n  </div>\n\n  <!-- header -->\n  <header class=\"topbar\">\n    <div class=\"wrap\">\n      <a class=\"brand\" href=\"#\">\n        <svg class=\"brand-mark\" viewBox=\"0 0 25 25\" fill=\"none\" aria-hidden=\"true\">\n          <rect x=\"0\" y=\"0\" width=\"25\" height=\"25\" rx=\"7\" fill=\"#16719c\"/>\n          <path d=\"M6 17.6V8.2c0-.5.62-.73.94-.35l3.06 3.6a.7.7 0 0 0 1.06 0l3.06-3.6c.32-.38.94-.15.94.35v9.4\" stroke=\"#fafbfb\" stroke-width=\"2.1\" stroke-linecap=\"round\"/>\n          <circle cx=\"18.6\" cy=\"17\" r=\"1.7\" fill=\"#9fd2e6\"/>\n        </svg>\n        <span class=\"brand-name\">Marlbeck</span>\n      </a>\n\n      <nav class=\"nav\">\n        <a class=\"nav-item\" href=\"#\">AI Studio\n          <svg class=\"chev\" width=\"10\" height=\"6\" viewBox=\"0 0 10 6\" fill=\"none\" aria-hidden=\"true\"><path d=\"M1 1l4 4 4-4\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n        </a>\n        <a class=\"nav-item\" href=\"#\">Platform\n          <svg class=\"chev\" width=\"10\" height=\"6\" viewBox=\"0 0 10 6\" fill=\"none\" aria-hidden=\"true\"><path d=\"M1 1l4 4 4-4\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n        </a>\n        <a class=\"nav-item is-open\" href=\"#\">Solutions\n          <svg class=\"chev\" width=\"10\" height=\"6\" viewBox=\"0 0 10 6\" fill=\"none\" aria-hidden=\"true\"><path d=\"M1 1l4 4 4-4\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n        </a>\n        <a class=\"nav-item\" href=\"#\">Resources\n          <svg class=\"chev\" width=\"10\" height=\"6\" viewBox=\"0 0 10 6\" fill=\"none\" aria-hidden=\"true\"><path d=\"M1 1l4 4 4-4\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n        </a>\n        <a class=\"nav-item\" href=\"#\">Pricing</a>\n        <a class=\"nav-item\" href=\"#\">Enterprise</a>\n      </nav>\n\n      <div class=\"actions\">\n        <a class=\"link-btn\" href=\"#\">Talk to sales</a>\n        <a class=\"pill-btn\" href=\"#\">Sign in</a>\n        <a class=\"dark-btn\" href=\"#\">Start free</a>\n      </div>\n    </div>\n  </header>\n\n  <!-- open mega-menu (Solutions) -->\n  <div class=\"mega\">\n    <div class=\"wrap\">\n      <div class=\"mega-col\">\n        <p class=\"col-label\">By team</p>\n        <ul class=\"mega-list\">\n          <li><a href=\"#\">Delivery &amp; projects</a></li>\n          <li><a href=\"#\">Product design</a></li>\n          <li><a href=\"#\">Operations</a></li>\n          <li><a href=\"#\">IT &amp; security</a></li>\n          <li><a href=\"#\">Marketing</a></li>\n          <li><a href=\"#\">People ops</a></li>\n          <li><a href=\"#\">Revenue</a></li>\n        </ul>\n      </div>\n\n      <div class=\"mega-col\">\n        <p class=\"col-label\">By company</p>\n        <ul class=\"mega-list\">\n          <li><a href=\"#\">Enterprise</a></li>\n          <li><a href=\"#\">Scale-ups</a></li>\n          <li><a href=\"#\">Nonprofits</a></li>\n          <li><a href=\"#\">Education</a></li>\n          <li><a href=\"#\">Agencies</a></li>\n        </ul>\n      </div>\n\n      <div class=\"mega-col\">\n        <p class=\"col-label\">Starter kits</p>\n        <div class=\"kits\">\n          <a class=\"kit\" href=\"#\">\n            <svg class=\"kit-ico\" viewBox=\"0 0 40 40\" fill=\"none\" aria-hidden=\"true\">\n              <rect width=\"40\" height=\"40\" rx=\"11\" fill=\"#daf0f4\"/>\n              <rect x=\"8\" y=\"9\" width=\"9\" height=\"7\" rx=\"2.2\" fill=\"#7fa4cd\"/>\n              <rect x=\"19\" y=\"11\" width=\"13\" height=\"2.6\" rx=\"1.3\" fill=\"#a9c3de\"/>\n              <rect x=\"8\" y=\"18.5\" width=\"9\" height=\"7\" rx=\"2.2\" fill=\"#2f5f96\"/>\n              <rect x=\"19\" y=\"20.5\" width=\"13\" height=\"2.6\" rx=\"1.3\" fill=\"#a9c3de\"/>\n              <rect x=\"8\" y=\"28\" width=\"9\" height=\"6\" rx=\"2.2\" fill=\"#7fa4cd\"/>\n              <rect x=\"19\" y=\"29.5\" width=\"9\" height=\"2.6\" rx=\"1.3\" fill=\"#a9c3de\"/>\n            </svg>\n            <span class=\"kit-txt\">\n              <h3>Delivery board</h3>\n              <p>Track roadmaps, backlogs, defects, and release notes.</p>\n            </span>\n          </a>\n\n          <a class=\"kit\" href=\"#\">\n            <svg class=\"kit-ico\" viewBox=\"0 0 40 40\" fill=\"none\" aria-hidden=\"true\">\n              <rect width=\"40\" height=\"40\" rx=\"11\" fill=\"#f6d5bd\"/>\n              <circle cx=\"11.5\" cy=\"11\" r=\"2.3\" fill=\"#b9502a\"/>\n              <circle cx=\"20\" cy=\"13.5\" r=\"2.3\" fill=\"#8f3d1f\"/>\n              <circle cx=\"28.5\" cy=\"10\" r=\"2.3\" fill=\"#b9502a\"/>\n              <rect x=\"8\" y=\"19\" width=\"7\" height=\"14\" rx=\"2.2\" fill=\"#e8fbff\"/>\n              <rect x=\"16.5\" y=\"22.5\" width=\"7\" height=\"10.5\" rx=\"2.2\" fill=\"#e8fbff\"/>\n              <rect x=\"25\" y=\"17\" width=\"7\" height=\"16\" rx=\"2.2\" fill=\"#e8fbff\"/>\n            </svg>\n            <span class=\"kit-txt\">\n              <h3>Pipeline desk</h3>\n              <p>Track leads, renewals, and account history.</p>\n            </span>\n          </a>\n\n          <a class=\"kit\" href=\"#\">\n            <svg class=\"kit-ico\" viewBox=\"0 0 40 40\" fill=\"none\" aria-hidden=\"true\">\n              <rect width=\"40\" height=\"40\" rx=\"11\" fill=\"#daeff3\"/>\n              <path d=\"M8 9h7.5v10H8z\" fill=\"#4b4d97\"/>\n              <path d=\"M11.7 9h3.8v10h-3.8a5 5 0 0 1 0-10z\" fill=\"#daeff3\"/>\n              <rect x=\"19\" y=\"9\" width=\"13\" height=\"3\" rx=\"1.5\" fill=\"#4b4d97\"/>\n              <rect x=\"19\" y=\"14.5\" width=\"8.5\" height=\"3\" rx=\"1.5\" fill=\"#8a8bc4\"/>\n              <rect x=\"8\" y=\"23\" width=\"24\" height=\"9.5\" rx=\"2.4\" fill=\"#b6b7de\"/>\n              <rect x=\"11\" y=\"26.5\" width=\"5\" height=\"6\" rx=\"1.2\" fill=\"#4b4d97\"/>\n              <rect x=\"18\" y=\"26.5\" width=\"5\" height=\"6\" rx=\"1.2\" fill=\"#4b4d97\"/>\n            </svg>\n            <span class=\"kit-txt\">\n              <h3>Campaign room</h3>\n              <p>Plan launches, organise assets, and draft briefs.</p>\n            </span>\n          </a>\n        </div>\n        <a class=\"kits-more\" href=\"#\">Browse the full library</a>\n      </div>\n    </div>\n  </div>\n\n  <!-- hero -->\n  <section class=\"hero\">\n    <div class=\"wrap\">\n\n      <div class=\"mock\" aria-hidden=\"true\">\n        <div class=\"mock-inner\">\n          <div class=\"mock-rail\"></div>\n\n          <div class=\"mock-side\">\n            <div class=\"m-head\">\n              <svg width=\"15\" height=\"15\" viewBox=\"0 0 15 15\" fill=\"none\"><path d=\"M2 5.4h11M2 9.6h11M5.9 2 4.6 13M10.4 2 9.1 13\" stroke=\"#86979a\" stroke-width=\"1.4\" stroke-linecap=\"round\"/></svg>\n              Studio\n            </div>\n            <div class=\"m-row\"><img class=\"m-av\" src=\"https://images.pexels.com/photos/11357048/pexels-photo-11357048.jpeg?auto=compress&cs=tinysrgb&fit=crop&crop=faces&w=400&h=400\" alt=\"Team member portrait by Foto Sushi on Pexels\" onerror=\"__crawlAsset&&__crawlAsset(this)\"><span class=\"m-name\">Priya R.</span><span class=\"m-count\">1</span></div>\n            <div class=\"m-row\"><img class=\"m-av\" src=\"https://images.pexels.com/photos/20249686/pexels-photo-20249686.jpeg?auto=compress&cs=tinysrgb&fit=crop&crop=faces&w=400&h=400\" alt=\"Team member portrait by Korede Adenola on Pexels\" onerror=\"__crawlAsset&&__crawlAsset(this)\"><span class=\"m-name\">Ops Agent</span><span class=\"m-count\">3</span></div>\n            <div class=\"m-row\"><img class=\"m-av\" src=\"https://images.pexels.com/photos/37862665/pexels-photo-37862665.jpeg?auto=compress&cs=tinysrgb&fit=crop&crop=faces&w=400&h=400\" alt=\"Team member portrait by Ben Khatry on Pexels\" onerror=\"__crawlAsset&&__crawlAsset(this)\"><span class=\"m-name plain\">Tomas L.</span></div>\n            <div class=\"m-row\">\n              <svg class=\"m-sq\" viewBox=\"0 0 19 19\" fill=\"none\"><rect width=\"19\" height=\"19\" rx=\"5\" fill=\"#4a9fd0\"/><rect x=\"4.5\" y=\"5\" width=\"10\" height=\"1.6\" rx=\".8\" fill=\"#fff\"/><rect x=\"4.5\" y=\"8.7\" width=\"10\" height=\"1.6\" rx=\".8\" fill=\"#fff\"/><rect x=\"4.5\" y=\"12.4\" width=\"6\" height=\"1.6\" rx=\".8\" fill=\"#fff\"/></svg>\n              <span class=\"m-name plain\">Vision &amp; roadmap</span>\n            </div>\n\n            <p class=\"m-label\">Workspaces</p>\n            <div class=\"m-space\">\n              <svg class=\"m-sq\" viewBox=\"0 0 19 19\" fill=\"none\"><rect width=\"19\" height=\"19\" rx=\"5\" fill=\"#c4653c\"/><path d=\"M6 12.6 12.4 6.2M6 12.6l-.5 1.9 1.9-.5\" stroke=\"#fff\" stroke-width=\"1.5\" stroke-linecap=\"round\"/></svg>\n              Growth\n            </div>\n            <div class=\"m-sub\">\n              <svg width=\"15\" height=\"15\" viewBox=\"0 0 15 15\" fill=\"none\"><path d=\"M1.5 4.2 3 5.7l2.6-2.8M1.5 10.4 3 11.9l2.6-2.8M7.8 4.4h5.7M7.8 10.6h5.7\" stroke=\"#86979a\" stroke-width=\"1.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n              Launches\n            </div>\n            <div class=\"m-sub\">\n              <svg width=\"15\" height=\"15\" viewBox=\"0 0 15 15\" fill=\"none\"><path d=\"M1.5 4.2 3 5.7l2.6-2.8M1.5 10.4 3 11.9l2.6-2.8M7.8 4.4h5.7M7.8 10.6h5.7\" stroke=\"#86979a\" stroke-width=\"1.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n              Longform\n            </div>\n            <div class=\"m-sub dim\">\n              <svg width=\"15\" height=\"15\" viewBox=\"0 0 15 15\" fill=\"none\"><rect x=\"2\" y=\"1.6\" width=\"11\" height=\"11.8\" rx=\"2.4\" fill=\"#bcd9ec\"/><rect x=\"4.6\" y=\"4.4\" width=\"5.8\" height=\"1.3\" rx=\".65\" fill=\"#fff\"/><rect x=\"4.6\" y=\"7.2\" width=\"5.8\" height=\"1.3\" rx=\".65\" fill=\"#fff\"/></svg>\n              Brand kit\n            </div>\n            <div class=\"m-sub dimmer\">\n              <svg width=\"15\" height=\"15\" viewBox=\"0 0 15 15\" fill=\"none\"><rect x=\"2\" y=\"1.6\" width=\"11\" height=\"11.8\" rx=\"2.4\" fill=\"#cee4e9\"/></svg>\n              Design ops\n            </div>\n          </div>\n\n          <div class=\"mock-main\">\n            <div class=\"t-row t-faded\">\n              <svg width=\"17\" height=\"17\" viewBox=\"0 0 17 17\" fill=\"none\"><circle cx=\"8.5\" cy=\"8.5\" r=\"6.6\" stroke=\"#b3bec0\" stroke-width=\"1.5\" stroke-dasharray=\"2.6 2.4\"/></svg>\n              <span>Website assets</span>\n              <span class=\"t-right\"><img class=\"t-av\" src=\"https://images.pexels.com/photos/10816007/pexels-photo-10816007.jpeg?auto=compress&cs=tinysrgb&fit=crop&crop=faces&w=400&h=400\" alt=\"Team member portrait by Prince on Pexels\" onerror=\"__crawlAsset&&__crawlAsset(this)\"></span>\n            </div>\n            <div class=\"t-row\">\n              <svg width=\"17\" height=\"17\" viewBox=\"0 0 17 17\" fill=\"none\"><circle cx=\"8.5\" cy=\"8.5\" r=\"6.6\" stroke=\"#b3bec0\" stroke-width=\"1.5\" stroke-dasharray=\"2.6 2.4\"/></svg>\n              <span>Homepage refresh</span>\n              <span class=\"t-right\"><img class=\"t-av\" src=\"https://images.pexels.com/photos/20051635/pexels-photo-20051635.jpeg?auto=compress&cs=tinysrgb&fit=crop&crop=faces&w=400&h=400\" alt=\"Team member portrait by Thanh Xuan Nguyen Ly on Pexels\" onerror=\"__crawlAsset&&__crawlAsset(this)\"></span>\n            </div>\n            <div class=\"t-row\">\n              <svg width=\"17\" height=\"17\" viewBox=\"0 0 17 17\" fill=\"none\"><circle cx=\"8.5\" cy=\"8.5\" r=\"6.6\" stroke=\"#b3bec0\" stroke-width=\"1.5\" stroke-dasharray=\"2.6 2.4\"/></svg>\n              <span>Pricing page</span>\n              <span class=\"t-right\"><img class=\"t-av\" src=\"https://images.pexels.com/photos/11357048/pexels-photo-11357048.jpeg?auto=compress&cs=tinysrgb&fit=crop&crop=faces&w=400&h=400\" alt=\"Team member portrait by Foto Sushi on Pexels\" onerror=\"__crawlAsset&&__crawlAsset(this)\"></span>\n            </div>\n            <div class=\"t-row\">\n              <svg width=\"17\" height=\"17\" viewBox=\"0 0 17 17\" fill=\"none\"><circle cx=\"8.5\" cy=\"8.5\" r=\"7.3\" fill=\"#2f8f63\"/><path d=\"M5.2 8.7 7.5 11l4.2-4.6\" stroke=\"#fff\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n              <span>App store art</span>\n              <span class=\"t-right\"><img class=\"t-av\" src=\"https://images.pexels.com/photos/20249686/pexels-photo-20249686.jpeg?auto=compress&cs=tinysrgb&fit=crop&crop=faces&w=400&h=400\" alt=\"Team member portrait by Korede Adenola on Pexels\" onerror=\"__crawlAsset&&__crawlAsset(this)\"></span>\n            </div>\n            <div class=\"t-row no-line t-muted\">\n              <svg width=\"17\" height=\"17\" viewBox=\"0 0 17 17\" fill=\"none\"><circle cx=\"8.5\" cy=\"8.5\" r=\"7\" fill=\"#c6d0d2\"/><path d=\"M8.5 5.2v6.6M5.2 8.5h6.6\" stroke=\"#fff\" stroke-width=\"1.5\" stroke-linecap=\"round\"/></svg>\n              <span>New task</span>\n            </div>\n\n            <div class=\"t-group\">\n              <svg width=\"11\" height=\"11\" viewBox=\"0 0 11 11\" fill=\"none\"><path d=\"M1.6 3.4 5.5 7.6 9.4 3.4\" fill=\"#86979a\"/></svg>\n              <span class=\"t-chip\">\n                <svg width=\"13\" height=\"13\" viewBox=\"0 0 13 13\" fill=\"none\"><circle cx=\"6.5\" cy=\"6.5\" r=\"5.6\" stroke=\"#fff\" stroke-width=\"1.4\"/><path d=\"M6.5 3.6v3.1l2 1.2\" stroke=\"#fff\" stroke-width=\"1.4\" stroke-linecap=\"round\"/></svg>\n                IN FLIGHT\n              </span>\n              <span style=\"font-size:15px;color:#394649\">3</span>\n            </div>\n\n            <div class=\"t-row no-line\">\n              <svg width=\"17\" height=\"17\" viewBox=\"0 0 17 17\" fill=\"none\"><rect x=\"1.6\" y=\"1.6\" width=\"13.8\" height=\"13.8\" rx=\"3.6\" fill=\"#3f7fc4\"/><rect x=\"4.4\" y=\"8.4\" width=\"2.4\" height=\"4.4\" rx=\"1.1\" fill=\"#fff\"/><rect x=\"7.3\" y=\"5.8\" width=\"2.4\" height=\"7\" rx=\"1.1\" fill=\"#fff\"/><rect x=\"10.2\" y=\"4.2\" width=\"2.4\" height=\"8.6\" rx=\"1.1\" fill=\"#fff\"/></svg>\n              <span>Category research</span>\n              <span class=\"t-right\"><img class=\"t-av\" src=\"https://images.pexels.com/photos/37862665/pexels-photo-37862665.jpeg?auto=compress&cs=tinysrgb&fit=crop&crop=faces&w=400&h=400\" alt=\"Team member portrait by Ben Khatry on Pexels\" onerror=\"__crawlAsset&&__crawlAsset(this)\"></span>\n            </div>\n            <div class=\"t-row no-line\">\n              <svg width=\"11\" height=\"11\" viewBox=\"0 0 11 11\" fill=\"none\"><path d=\"M3.6 1.6 7.8 5.5 3.6 9.4\" fill=\"#a5b2b5\"/></svg>\n              <svg width=\"17\" height=\"17\" viewBox=\"0 0 17 17\" fill=\"none\"><circle cx=\"8.5\" cy=\"5.6\" r=\"2.9\" fill=\"#3f7fc4\"/><path d=\"M2.9 14.4c0-3 2.5-4.6 5.6-4.6s5.6 1.6 5.6 4.6z\" fill=\"#3f7fc4\"/></svg>\n              <span>Rival teardown</span>\n              <span class=\"t-meta\">\n                <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\"><path d=\"M5.6 8.4 8.4 5.6M4.4 9.6a2.3 2.3 0 0 1 0-3.2l1.3-1.3M9.6 4.4a2.3 2.3 0 0 1 0 3.2L8.3 8.9\" stroke=\"#97a4a7\" stroke-width=\"1.3\" stroke-linecap=\"round\"/></svg>1</span>\n              <span class=\"t-right\"><img class=\"t-av\" src=\"https://images.pexels.com/photos/10816007/pexels-photo-10816007.jpeg?auto=compress&cs=tinysrgb&fit=crop&crop=faces&w=400&h=400\" alt=\"Team member portrait by Prince on Pexels\" onerror=\"__crawlAsset&&__crawlAsset(this)\"><img class=\"t-av\" style=\"margin-left:-9px\" src=\"https://images.pexels.com/photos/20051635/pexels-photo-20051635.jpeg?auto=compress&cs=tinysrgb&fit=crop&crop=faces&w=400&h=400\" alt=\"Team member portrait by Thanh Xuan Nguyen Ly on Pexels\" onerror=\"__crawlAsset&&__crawlAsset(this)\"></span>\n            </div>\n            <div class=\"t-row no-line t-faded\">\n              <svg width=\"11\" height=\"11\" viewBox=\"0 0 11 11\" fill=\"none\"><path d=\"M3.6 1.6 7.8 5.5 3.6 9.4\" fill=\"#a5b2b5\"/></svg>\n              <svg width=\"17\" height=\"17\" viewBox=\"0 0 17 17\" fill=\"none\"><path d=\"M8.5 2.4 15 7.6h-1.9v6.2H3.9V7.6H2z\" fill=\"#5f9fd4\"/></svg>\n              <span>Positioning brief</span>\n              <svg width=\"13\" height=\"13\" viewBox=\"0 0 13 13\" fill=\"none\"><rect x=\"2.6\" y=\"5.6\" width=\"7.8\" height=\"6\" rx=\"1.6\" fill=\"#86979a\"/><path d=\"M4.6 5.6V4.2a1.9 1.9 0 0 1 3.8 0v1.4\" stroke=\"#86979a\" stroke-width=\"1.3\"/></svg>\n              <span class=\"t-meta\">\n                <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\"><path d=\"M5.6 8.4 8.4 5.6M4.4 9.6a2.3 2.3 0 0 1 0-3.2l1.3-1.3M9.6 4.4a2.3 2.3 0 0 1 0 3.2L8.3 8.9\" stroke=\"#97a4a7\" stroke-width=\"1.3\" stroke-linecap=\"round\"/></svg>5</span>\n              <span class=\"t-meta\" style=\"color:#c05a5a\">\n                <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\"><circle cx=\"7\" cy=\"7\" r=\"5.6\" fill=\"#e5b3b3\"/><path d=\"M4.4 7h5.2\" stroke=\"#fff\" stroke-width=\"1.5\" stroke-linecap=\"round\"/></svg>1</span>\n              <span class=\"t-right\"><img class=\"t-av\" src=\"https://images.pexels.com/photos/11357048/pexels-photo-11357048.jpeg?auto=compress&cs=tinysrgb&fit=crop&crop=faces&w=400&h=400\" alt=\"Team member portrait by Foto Sushi on Pexels\" onerror=\"__crawlAsset&&__crawlAsset(this)\"></span>\n            </div>\n          </div>\n        </div>\n        <div class=\"mock-fade\"></div>\n      </div>\n\n      <div class=\"hero-copy\">\n        <h1>Where the plan, the work, and the people finally agree.</h1>\n        <p class=\"hero-sub\">Briefs, boards, notes, approvals, and the automations that carry them between your teams — plus every teammate and every agent, on one surface.</p>\n\n        <div class=\"cta-row\">\n          <a class=\"cta\" href=\"#\">Start free. Right now.</a>\n          <p class=\"cta-note\">Free for good.<br>No card needed.</p>\n        </div>\n\n        <p class=\"eyebrow\">Ship 2.7&times; more per cycle &nbsp;&bull;&nbsp; Build your workspace</p>\n\n        <div class=\"chips\">\n          <a class=\"chip is-on\" href=\"#\">Boards\n            <span class=\"chip-tick\"><svg width=\"9\" height=\"7\" viewBox=\"0 0 9 7\" fill=\"none\"><path d=\"M1 3.6 3.3 5.8 8 1.2\" stroke=\"#fff\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>\n          </a>\n          <a class=\"chip\" href=\"#\">Threads</a>\n          <a class=\"chip\" href=\"#\">Ask AI</a>\n          <a class=\"chip\" href=\"#\">AI agents</a>\n          <a class=\"chip\" href=\"#\">Iterations</a>\n          <a class=\"chip\" href=\"#\">Time logs</a>\n          <a class=\"chip\" href=\"#\">Calendar</a>\n          <a class=\"chip\" href=\"#\">Notes</a>\n          <a class=\"chip\" href=\"#\">Sketchpad</a>\n          <a class=\"chip\" href=\"#\">Automations</a>\n          <a class=\"chip\" href=\"#\">Reports</a>\n          <a class=\"chip\" href=\"#\">Scheduling</a>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- logo band -->\n  <section class=\"logos\">\n    <div class=\"wrap\">\n      <p class=\"logos-label\">Trusted by teams at</p>\n      <span class=\"logo-mk lm-1\">vardock</span>\n      <span class=\"logo-mk lm-2\">\n        <svg width=\"24\" height=\"20\" viewBox=\"0 0 24 20\" fill=\"none\" aria-hidden=\"true\"><path d=\"M6.4 2.6h6.2L17.6 10l-5 7.4H6.4L11.4 10z\" fill=\"currentColor\"/><path d=\"M0.8 6.6h4.4L7.6 10l-2.4 3.4H0.8L3.2 10z\" fill=\"currentColor\" opacity=\".5\"/></svg>\n        HALVERIN\n      </span>\n      <span class=\"logo-mk lm-3\">quilburn</span>\n      <span class=\"logo-mk lm-4\">veskin</span>\n      <span class=\"logo-mk lm-5\">\n        <svg width=\"22\" height=\"22\" viewBox=\"0 0 22 22\" fill=\"none\" aria-hidden=\"true\"><rect x=\"1.4\" y=\"1.4\" width=\"19.2\" height=\"19.2\" rx=\"5.6\" fill=\"currentColor\"/><path d=\"M5.8 6.6h10.4M11 6.6v8.8M7.4 15.4h7.2\" stroke=\"#fafbfb\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg>\n        Thelmore\n      </span>\n      <span class=\"logo-mk lm-6\">\n        <svg width=\"20\" height=\"23\" viewBox=\"0 0 20 23\" fill=\"none\" aria-hidden=\"true\"><path d=\"M2 2h16v12.4L10 21 2 14.4z\" fill=\"currentColor\"/><path d=\"M5.4 5.4h4v3.4h-4zM10.6 5.4h4v3.4h-4zM5.4 10.4h9.2v3.4H5.4z\" fill=\"#fafbfb\"/></svg>\n        <span style=\"display:block\">OSSENDALE<span>INSTITUTE</span></span>\n      </span>\n    </div>\n  </section>\n\n",
