   <button class=\"swatch\" style=\"background:#3179ad\" aria-label=\"Harbor blue\"></button>\n        <button class=\"swatch\" style=\"background:#6a61ad\" aria-label=\"Iris\"></button>\n        <button class=\"swatch\" style=\"background:#40917d\" aria-label=\"Sea glass\"></button>\n        <button class=\"swatch\" style=\"background:#7b756c\" aria-label=\"Stone\"></button>\n        <button class=\"swatch is-on\" style=\"background:#d9603a\" aria-label=\"Sundial coral\"></button>\n        <button class=\"swatch\" style=\"background:#b45478\" aria-label=\"Rosewood\"></button>\n        <button class=\"swatch\" style=\"background:#3557b8\" aria-label=\"Cobalt\"></button>\n      </div>\n\n      <p class=\"note\">Anyone can point a phone camera at this code to open your Sundial profile — no username typing required.</p>\n    </div>\n\n    <a class=\"sheet-action primary\" href=\"#\">Download QR code</a>\n    <button class=\"sheet-action quiet\">Done</button>\n  </div>\n</div>\n\n",
