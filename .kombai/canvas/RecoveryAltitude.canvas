    "d97b1f03-ba82-4e2d-bd37-d51028eef1a2": {
      "type": "variant",
      "id": "d97b1f03-ba82-4e2d-bd37-d51028eef1a2",
      "label": "chat_web_11",
      "parentId": null,
      "rect": {
        "x": 10028,
        "y": 0,
        "w": 1440,
        "h": 1000
      },
      "generation": {
        "prompt": "",
        "config": {}
      },
      "html": "<style>\n  :root{\n    --bg:#101317;\n    --topbar:#171b20;\n    --card:#1c2126;\n    --card-2:#20262c;\n    --code:#13171b;\n    --composer:#232830;\n\n    --line:rgba(233,240,247,0.075);\n    --line-2:rgba(233,240,247,0.10);\n\n    --fg:#e2e7ec;\n    --fg-2:#c6ced6;\n    --muted:#8a939d;\n    --dim:#6c757f;\n\n    --accent:#35b6a4;\n    --accent-2:#2aa392;\n    --accent-ink:#062420;\n    --good:#62b37c;\n\n    --col:987px;\n    --gutter:24px;\n    --radius:9px;\n\n    --ease:cubic-bezier(0.16,1,0.3,1);\n    --sans:-apple-system,BlinkMacSystemFont,\"Segoe UI\",Helvetica,Arial,sans-serif;\n    --mono:ui-monospace,SFMono-Regular,Menlo,Consolas,\"Liberation Mono\",monospace;\n  }\n\n  *,*::before,*::after{box-sizing:border-box}\n  html,body{height:100%}\n  body{\n    margin:0;\n    background:var(--bg);\n    color:var(--fg);\n    font-family:var(--sans);\n    font-size:14px;\n    line-height:1.5;\n    -webkit-font-smoothing:antialiased;\n    overflow:hidden;\n  }\n  p{margin:0}\n  pre{margin:0;font-family:var(--mono)}\n  button{font:inherit;color:inherit;background:none;border:0;padding:0;cursor:pointer}\n  svg{display:block;flex:0 0 auto}\n\n  ::selection{background:rgba(53,182,164,0.26);color:#f2f6f8}\n  :focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:4px}\n\n  .app{height:100vh;display:flex;flex-direction:column;min-height:0}\n\n  /* ---------- top bar ---------- */\n  .topbar{\n    flex:0 0 auto;\n    height:41px;\n    display:flex;\n    align-items:center;\n    gap:10px;\n    padding-left:18px;\n    padding-right:18px;\n    background:var(--topbar);\n    border-bottom:1px solid var(--line);\n  }\n  .mark{width:21px;height:21px;color:var(--fg-2)}\n  .session-title{\n    font-size:14px;font-weight:500;color:var(--fg);\n    letter-spacing:-0.005em;\n    white-space:nowrap;overflow:hidden;text-overflow:ellipsis;\n    min-width:0;\n  }\n  .sep-dot{width:4px;height:4px;border-radius:50%;background:#4a5259;flex:0 0 auto;margin-left:3px}\n  .agent-kind{font-size:13px;color:var(--dim);white-space:nowrap;margin-left:3px}\n  .bar-icons{display:flex;align-items:center;gap:6px;margin-left:14px}\n  .ibtn{\n    width:26px;height:26px;border-radius:6px;\n    display:flex;align-items:center;justify-content:center;\n    color:var(--dim);\n    transition:background .25s var(--ease),color .25s var(--ease);\n  }\n  .ibtn:hover{background:rgba(233,240,247,0.06);color:var(--fg-2)}\n  .ibtn:focus-visible{outline:2px solid var(--accent);outline-offset:1px}\n\n  .bar-right{margin-left:auto;display:flex;align-items:center;gap:16px;min-width:0}\n  .branch{display:flex;align-items:center;gap:7px;font-size:13px;color:var(--muted);white-space:nowrap}\n  .live{width:6px;height:6px;border-radius:50%;background:var(--good);box-shadow:0 0 0 3px rgba(98,179,124,0.14)}\n  .who{\n    display:flex;align-items:center;gap:8px;\n    padding:3px 6px 3px 3px;border-radius:7px;\n    transition:background .25s var(--ease);\n  }\n  .who:hover{background:rgba(233,240,247,0.055)}\n  .who-av{\n    width:21px;height:21px;border-radius:50%;overflow:hidden;flex:0 0 auto;\n    display:block;background:#2c333a;\n  }\n  .who-av img{display:block;width:100%;height:100%;object-fit:cover}\n  .who-name{font-size:13px;color:var(--fg-2);white-space:nowrap}\n  .who svg{color:var(--dim)}\n\n  /* ---------- main ---------- */\n  .main{flex:1 1 auto;min-height:0;display:flex;flex-direction:column;align-items:center;position:relative}\n\n  .panel-toggle{\n    position:absolute;top:27px;right:29px;\n    width:26px;height:26px;border-radius:6px;\n    display:flex;align-items:center;justify-content:center;\n    color:var(--dim);\n    transition:background .25s var(--ease),color .25s var(--ease);\n  }\n  .panel-toggle:hover{background:rgba(233,240,247,0.06);color:var(--fg-2)}\n\n  .thread{\n    flex:1 1 auto;min-height:0;width:100%;\n    display:flex;justify-content:center;\n    overflow:hidden;\n  }\n  .thread-inner{\n    width:var(--col);\n    max-width:calc(100% - var(--gutter)*2);\n    padding-top:34px;\n    min-width:0;\n  }\n\n  /* ---------- messages ---------- */\n  .row{display:flex;align-items:flex-start;gap:13px;min-width:0}\n  .av{\n    width:36px;height:36px;border-radius:50%;flex:0 0 auto;\n    display:flex;align-items:center;justify-content:center;\n    overflow:hidden;background:#2c333a;\n  }\n  .av img{display:block;width:100%;height:100%;object-fit:cover}\n  .av-agent{background:none;color:var(--fg-2)}\n\n  .bubble{\n    background:var(--composer);\n    border-radius:8px;\n    padding:9px 15px;\n    font-size:14px;\n    color:var(--fg);\n    max-width:640px;\n    letter-spacing:-0.004em;\n    box-shadow:inset 0 1px 0 rgba(233,240,247,0.045);\n  }\n\n  .reply{margin-top:49px}\n  .reply-body{min-width:0;flex:1 1 auto}\n\n  .say{\n    font-size:14px;line-height:24px;color:var(--fg-2);\n    margin-top:10px;\n    letter-spacing:-0.004em;\n  }\n\n  /* ---------- tool cards ---------- */\n  .tool{\n    background:var(--card);\n    border:1px solid var(--line-2);\n    border-radius:var(--radius);\n    overflow:hidden;\n    box-shadow:inset 0 1px 0 rgba(233,240,247,0.028);\n    transition:border-color .35s var(--ease),background-color .35s var(--ease);\n  }\n  .tool:hover{background:var(--card-2);border-color:rgba(233,240,247,0.145)}\n  .tool + .tool{margin-top:16px}\n  .say + .tool{margin-top:10px}\n  .say{margin-bottom:0}\n  .tool-head{\n    height:44px;\n    display:flex;align-items:center;gap:8px;\n    padding-left:18px;padding-right:18px;\n    min-width:0;\n  }\n  .tool-head .lead{display:flex;align-items:center;gap:10px;min-width:0}\n  .tool-head svg{color:var(--muted)}\n  .tool-label{\n    font-size:14px;color:var(--fg-2);\n    white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0;\n  }\n  .tool-tail{margin-left:auto;display:flex;align-items:center;gap:12px;color:var(--dim)}\n  .chev{\n    display:flex;align-items:center;justify-content:center;\n    color:var(--dim);\n    transition:color .25s var(--ease),transform .3s var(--ease);\n  }\n  .tool:hover .chev{color:var(--muted)}\n\n  .tool-cmd{\n    height:44px;display:flex;align-items:center;gap:10px;\n    padding-left:18px;padding-right:18px;\n    font-family:var(--mono);font-size:13px;min-width:0;\n  }\n  .cmd-path{color:var(--dim);white-space:nowrap}\n  .cmd-run{color:var(--fg-2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}\n  .cmd-run .pct{color:var(--dim)}\n  .cmd-run .lit{color:var(--accent)}\n\n  .tool-body{\n    border-top:1px solid var(--line);\n    padding:18px;\n  }\n  .listing{\n    background:var(--code);\n    border-radius:8px;\n    padding:12px 16px;\n    font-family:var(--mono);\n    font-size:13px;\n    line-height:19px;\n    color:#b3bcc5;\n    overflow-x:auto;\n    box-shadow:inset 0 0 0 1px rgba(233,240,247,0.045);\n  }\n\n  /* ---------- composer ---------- */\n  .composer-wrap{\n    flex:0 0 auto;\n    width:var(--col);\n    max-width:calc(100% - var(--gutter)*2);\n    margin-top:6px;\n    margin-bottom:32px;\n    min-width:0;\n  }\n  .composer{\n    background:var(--composer);\n    border:1px solid rgba(233,240,247,0.055);\n    border-radius:13px;\n    padding:16px 14px 12px;\n    box-shadow:0 22px 44px -26px rgba(4,8,12,0.95),inset 0 1px 0 rgba(233,240,247,0.045);\n    transition:border-color .3s var(--ease);\n  }\n  .composer:hover{border-color:rgba(233,240,247,0.10)}\n  .field{\n    font-size:15px;color:var(--dim);\n    min-height:26px;line-height:26px;\n    padding-left:4px;\n  }\n  .controls{\n    display:flex;align-items:center;gap:6px;\n    height:28px;margin-top:12px;min-width:0;\n  }\n  .cbtn{\n    width:28px;height:28px;border-radius:7px;\n    display:flex;align-items:center;justify-content:center;\n    color:var(--dim);flex:0 0 auto;\n    transition:background .25s var(--ease),color .25s var(--ease);\n  }\n  .cbtn:hover{background:rgba(233,240,247,0.06);color:var(--fg-2)}\n  .chip{\n    display:flex;align-items:center;gap:7px;\n    height:28px;padding:0 8px;border-radius:7px;\n    font-size:13px;color:var(--muted);flex:0 0 auto;\n    transition:background .25s var(--ease),color .25s var(--ease);\n  }\n  .chip:hover{background:rgba(233,240,247,0.06);color:var(--fg-2)}\n  .chip svg{color:var(--dim)}\n  .chip .cnt{color:var(--dim)}\n  .send{\n    margin-left:auto;flex:0 0 auto;\n    width:31px;height:31px;border-radius:50%;\n    display:flex;align-items:center;justify-content:center;\n    background:var(--accent);color:var(--accent-ink);\n    box-shadow:0 8px 18px -10px rgba(53,182,164,0.42);\n    transition:transform .3s var(--ease),background .3s var(--ease);\n  }\n  .send:hover{background:var(--accent-2);transform:translateY(-1px)}\n  .send:active{transform:translateY(0)}\n  .send:focus-visible{outline:2px solid var(--accent);outline-offset:2px}\n\n  @media (max-width:900px){\n    :root{--gutter:16px}\n    .agent-kind,.sep-dot,.branch{display:none}\n    .who-name{display:none}\n  }\n</style>\n\n<div class=\"app\">\n\n  <header class=\"topbar\">\n    <svg class=\"mark\" viewBox=\"0 0 24 24\" width=\"21\" height=\"21\" fill=\"none\" aria-hidden=\"true\">\n      <path d=\"M12 2.6 13.6 9 20 10.6 13.6 12.2 12 18.6 10.4 12.2 4 10.6 10.4 9Z\" fill=\"currentColor\"/>\n      <circle cx=\"12\" cy=\"18.4\" r=\"2.6\" stroke=\"currentColor\" stroke-width=\"1.4\"/>\n    </svg>\n    <span class=\"session-title\">Audit checkout flow for auth gaps</span>\n    <span class=\"sep-dot\"></span>\n    <span class=\"agent-kind\">Ephemeris Scout</span>\n    <div class=\"bar-icons\">\n      <button class=\"ibtn\" type=\"button\" aria-label=\"Share session\">\n        <svg viewBox=\"0 0 24 24\" width=\"15\" height=\"15\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M12 15V4\"/><path d=\"m8.5 7.5 3.5-3.5 3.5 3.5\"/><path d=\"M5 13v5.5A1.5 1.5 0 0 0 6.5 20h11a1.5 1.5 0 0 0 1.5-1.5V13\"/>\n        </svg>\n      </button>\n      <butto