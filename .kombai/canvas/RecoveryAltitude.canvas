      "html": "<style>\n  :root{\n    --ink:#1c1f24;\n    --ink-2:#2a2e34;\n    --ink-3:#4a4f57;\n    --muted:#71767e;\n    --muted-2:#9298a1;\n    --line:#e6e8ec;\n    --line-soft:#eef0f3;\n    --surface:#ffffff;\n    --shell:#f5f6f8;\n    --row:#eff0f3;\n    --row-mark:#f7f8f9;\n    --primary:#1f5f4f;\n    --primary-deep:#174b3f;\n    --primary-soft:#e6efeb;\n    --danger:#b3402f;\n    --radius-card:12px;\n    --radius-s:6px;\n    --shadow-card:0 1px 2px rgba(28,31,36,.05), 0 6px 18px -14px rgba(28,31,36,.30);\n    --ease:cubic-bezier(0.16,1,0.3,1);\n  }\n  *{box-sizing:border-box}\n  html,body{margin:0;padding:0}\n  body{\n    height:100vh;\n    overflow:hidden;\n    display:flex;\n    flex-direction:column;\n    background:var(--shell);\n    color:var(--ink);\n    font-family:system-ui,-apple-system,\"Segoe UI\",Roboto,\"Helvetica Neue\",Arial,sans-serif;\n    -webkit-font-smoothing:antialiased;\n  }\n  h1,h2,h3,p{margin:0}\n  button{background:none;border:0;padding:0;cursor:pointer}\n  input,select,textarea,button{font-family:inherit;font-size:inherit;color:inherit;box-sizing:border-box}\n  input,select,textarea{appearance:none;-webkit-appearance:none}\n  fieldset{border:0;margin:0;padding:0}\n  legend{padding:0}\n  svg{display:block}\n  :focus-visible{outline:2px solid var(--primary);outline-offset:2px}\n\n  /* ---------------- top bar ---------------- */\n  .topbar{\n    flex:0 0 auto;\n    height:50px;\n    background:var(--surface);\n    border-bottom:1px solid var(--line);\n    display:flex;\n    align-items:center;\n    padding-left:11px;\n    padding-right:16px;\n    z-index:4;\n  }\n  .back{\n    display:flex;align-items:center;height:28px;\n    padding-left:13px;padding-right:13px;border-radius:var(--radius-s);\n    font-size:14px;color:var(--ink-2);\n    transition:background-color .18s var(--ease);\n  }\n  .back:hover{background:#f2f3f5}\n  .crumbs{\n    display:flex;align-items:center;gap:6px;\n    margin-left:13px;font-size:14.5px;line-height:1;\n  }\n  .crumb-root{color:var(--muted)}\n  .crumb-root:hover{color:var(--ink-2)}\n  .crumb-sep{color:#c4c8ce}\n  .crumb-now{color:var(--ink-2);font-weight:500}\n  .publish{\n    margin-left:auto;\n    display:flex;align-items:center;justify-content:center;\n    height:29px;padding-left:15px;padding-right:15px;\n    border-radius:var(--radius-s);\n    background:var(--primary);color:#fff;\n    font-size:12.5px;font-weight:600;letter-spacing:.005em;\n    transition:background-color .18s var(--ease),transform .18s var(--ease);\n  }\n  .publish:hover{background:var(--primary-deep)}\n  .publish:active{transform:translateY(1px)}\n\n  /* ---------------- shell ---------------- */\n  .shell{flex:1 1 auto;display:flex;min-height:0}\n\n  /* sidebar */\n  .side{\n    flex:0 0 380px;width:380px;\n    background:var(--surface);\n    padding-left:24px;padding-right:16px;\n    position:relative;\n  }\n  .side-head{\n    display:flex;align-items:center;\n    height:36px;margin-top:11px;padding-left:5px;\n  }\n  .side-head h2{font-size:15px;font-weight:700;letter-spacing:-.01em;color:var(--ink)}\n  .side-add{\n    margin-left:auto;\n    display:flex;align-items:center;justify-content:center;\n    width:28px;height:28px;border-radius:var(--radius-s);color:var(--ink-2);\n    transition:background-color .18s var(--ease);\n  }\n  .side-add:hover{background:#f2f3f5}\n\n  .side-list{margin-top:15px;display:flex;flex-direction:column;gap:12px}\n  .item{\n    position:relative;\n    display:flex;align-items:center;\n    height:40px;padding-left:5px;padding-right:5px;\n    border-radius:8px;\n    transition:background-color .18s var(--ease);\n  }\n  .item:hover{background:#f7f8f9}\n  .item.is-on{background:#f2f4f6}\n  .item-icon{\n    display:flex;align-items:center;justify-content:center;\n    width:24px;height:24px;border-radius:6px;flex:0 0 auto;\n    background:var(--primary);color:#fff;\n  }\n  .item.is-on .item-icon{background:var(--primary);box-shadow:0 0 0 2px var(--primary-soft)}\n  .item-label{\n    margin-left:13px;min-width:0;\n    font-size:13.5px;font-weight:600;letter-spacing:-.005em;color:var(--ink);\n    white-space:nowrap;overflow:hidden;text-overflow:ellipsis;\n  }\n  .item-grip{\n    position:absolute;left:-11px;top:50%;transform:translateY(-50%);\n    display:flex;color:#b6bbc2;\n  }\n  .item-more{\n    margin-left:auto;\n    display:flex;align-items:center;justify-content:center;\n    width:24px;height:24px;border-radius:5px;color:#8d939b;flex:0 0 auto;\n    transition:background-color .18s var(--ease);\n  }\n  .item-more:hover{background:#e9ebee}\n\n  /* main pane */\n  .main{\n    flex:1 1 auto;min-width:0;\n    background:var(--shell);\n    padding-left:79px;padding-right:80px;\n    overflow:hidden;\n  }\n  .card{\n    background:var(--surface);\n    border-radius:var(--radius-card);\n    box-shadow:var(--shadow-card);\n  }\n  .card--intro{\n    margin-top:78px;\n    padding-top:54px;padding-bottom:50px;padding-left:66px;padding-right:66px;\n  }\n  .intro-title{\n    font-size:26px;font-weight:500;letter-spacing:-.02em;line-height:1.15;color:var(--ink);\n  }\n  .intro-sub{\n    margin-top:4px;\n    font-size:15px;line-height:1.45;color:var(--ink-3);\n    max-width:640px;\n  }\n\n  .card--q{\n    margin-top:24px;\n    padding-top:54px;padding-bottom:44px;padding-left:66px;padding-right:66px;\n  }\n  .q-head{display:flex;align-items:flex-start;gap:24px}\n  .q-title{\n    flex:1 1 auto;min-width:0;max-width:590px;\n    font-size:25px;font-weight:600;letter-spacing:-.022em;line-height:30px;color:var(--ink);\n  }\n  .q-meta{\n    flex:0 0 auto;display:flex;align-items:center;\n    position:relative;padding-top:22px;\n  }\n  .q-star{\n    position:absolute;left:-18px;top:0;\n    display:block;width:9px;height:9px;\n    color:var(--danger);font-size:15px;line-height:9px;\n  }\n  .q-req{font-size:13px;font-weight:500;color:var(--ink-2);margin-right:10px}\n  .toggle{\n    display:flex;align-items:center;\n    width:28px;height:16px;border-radius:8px;\n    background:var(--primary);padding-left:14px;\n    transition:background-color .2s var(--ease);\n  }\n  .toggle .knob{\n    display:block;width:12px;height:12px;border-radius:50%;\n    background:#fff;box-shadow:0 1px 2px rgba(28,31,36,.35);\n  }\n  .q-step{\n    display:flex;align-items:center;justify-content:center;\n    width:28px;height:28px;border-radius:var(--radius-s);\n    color:#b8bdc4;background:#f6f7f8;margin-left:20px;\n    transition:color .18s var(--ease),background-color .18s var(--ease);\n  }\n  .q-step + .q-step{margin-left:8px}\n  .q-step:hover{color:#7c828a;background:#eef0f2}\n\n  .opts{margin-top:47px;display:flex;flex-direction:column;gap:17px}\n  .opt-row{position:relative;width:547px;max-width:100%}\n  .opt{\n    display:flex;align-items:center;\n    width:100%;height:38px;\n    background:var(--row);border-radius:var(--radius-s);\n    overflow:hidden;\n  }\n  .opt-mark{\n    display:block;flex:0 0 auto;\n    width:28px;height:38px;\n    background:var(--row-mark);\n    border-top-left-radius:var(--radius-s);\n    border-bottom-left-radius:var(--radius-s);\n  }\n  .opt-input{\n    flex:1 1 auto;min-width:0;height:38px;\n    border:0;background:transparent;\n    padding-left:11px;padding-right:8px;\n    font-size:13.5px;font-weight:600;letter-spacing:-.005em;color:var(--ink);\n  }\n  .opt-input:focus{outline:none}\n  .opt-input::placeholder{color:#9ba1a9;font-weight:500}\n  .opt-del{\n    flex:0 0 auto;\n    display:flex;align-items:center;justify-content:center;\n    width:16px;height:16px;margin-right:10px;border-radius:4px;\n    background:#6c727a;color:#fff;\n    transition:background-color .18s var(--ease);\n  }\n  .opt-del:hover{background:var(--danger)}\n  .opt-grip{\n    position:absolute;right:-20px;top:50%;transform:translateY(-50%);\n    display:flex;color:#c0c5cb;\n  }\n  .opt-add{\n    display:flex;align-items:center;\n    width:547px;max-width:100%;height:38px;\n    background:var(--row);border-radius:var(--radius-s);\n    padding-left:15px;\n    font-size:13.5px;font-weight:500;color:#7d848c;\n    transition:background-color .18s var(--ease),color .18s var(--ease);\n  }\n  .opt-add:hover{background:#e8eaee;color:var(--ink-2)}\n  .opt-add svg{margin-right:11px}\n\n  .card--end{\n    margin-top:24px;\n    padding-top:52px;padding-bottom:52px;padding-left:66px;padding-right:66px;\n  }\n  .end-title{font-size:22px;font-weight:500;letter-spacing:-.02em;color:var(--ink)}\n  .end-sub{margin-top:10px;font-size:15px;line-height:1.45;color:var(--ink-3);max-width:62ch}\n\n  /* chat launcher */\n  .launcher{\n    position:fixed;left:22px;bottom:54px;\n    display:flex;align-items:center;justify-content:center;\n    width:47px;height:47px;border-radius:50%;\n    background:var(--primary);color:#fff;\n    box-shadow:0 8px 20px -8px rgba(31,95,79,.7);\n    transition:transform .2s var(--ease);\n    z-index:6;\n  }\n  .launcher:hover{transform:translateY(-2px)}\n</style>\n\n\n<header class=\"topbar\">\n  <button class=\"back\">Back</button>\n  <nav class=\"crumbs\">\n    <a class=\"crumb-root\" href=\"#\">Formery</a>\n    <span class=\"crumb-sep\">/</span>\n    <span class=\"crumb-now\">Onboarding check-in</span>\n  </nav>\n  <button class=\"publish\">Publish</button>\n</header>\n\n<div class=\"shell\">\n\n  <aside class=\"side\">\n    <div class=\"side-head\">\n      <h2>Content</h2>\n      <button class=\"side-add\" aria-label=\"Add block\">\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\"><path d=\"M12 5.5v13M5.5 12h13\"/></svg>\n      </button>\n    </div>\n\n    <div class=\"side-list\">\n      <div class=\"item\">\n        <span class=\"item-icon\">\n          <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linejoin=\"round\"><path d=\"M7 4.5h6.5L17 8v11.5H7z\"/><path d=\"M13.5 4.5V8H17\"/></svg>\n        </span>\n        <span class=\"item-label\">Title &amp; description</span>\n      </div>\n\n      <div class=\"item is-on\">\n        <span class=\"item-grip\">\n          <svg width=\"8\" height=\"14\" viewBox=\"0 0 8 14\" fill=\"currentColor\"><circle cx=\"1.6\" cy=\"2\" r=\"1.3\"/><circle cx=\"6.4\" cy=\"2\" r=\"1.3\"/><circle cx=\"1.6\" cy=\"7\" r=\"1.3\"/><circle cx=\"6.4\" cy=\"7\" r=\"1.3\"/><circle cx=\"1.6\" cy=\"12\" r=\"1.3\"/><circle cx=\"6.4\" cy=\"12\" r=\"1.3\"/></svg>\n        </span>\n        <span class=\"item-icon\">\n          <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linejoin=\"round\"><rect x=\"5.5\" y=\"5.5\" width=\"13\" height=\"13\" rx=\"2.2\"/><path d=\"M9.5 14.4l.4-1.7 4.4-4.4 1.3 1.3-4.4 4.4z\"/></svg>\n        </span>\n        <span class=\"item-label\">Which parts of onboarding felt clea…</span>\n        <button class=\"item-more\" aria-label=\"Block options\">\n          <svg width=\"4\" height=\"14\" viewBox=\"0 0 4 14\" fill=\"currentColor\"><circle cx=\"2\" cy=\"2\" r=\"1.4\"/><circle cx=\"2\" cy=\"7\" r=\"1.4\"/><circle cx=\"2\" cy=\"12\" r=\"1.4\"/></svg>\n        </button>\n      </div>\n\n      <div class=\"item\">\n        <span class=\"item-icon\">\n          <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linejoin=\"round\"><path d=\"M7 4.5h6.5L17 8v11.5H7z\"/><path d=\"M13.5 4.5V8H17\"/></svg>\n        </span>\n        <span class=\"item-label\">End note</span>\n      </div>\n    </div>\n  </aside>\n\n  <main class=\"main\">\n\n    <section class=\"card card--intro\">\n      <h1 class=\"intro-title\">Onboarding check-in</h1>\n      <p class=\"intro-sub\">Two minutes on how your first fortnight went. Answers stay anonymous.</p>\n    </section>\n\n    <section class=\"card card--q\">\n      <div class=\"q-head\">\n        <h2 class=\"q-title\">Which parts of onboarding felt clearest during your first two weeks?</h2>\n        <div class=\"q-meta\">\n          <span class=\"q-star\">*</span>\n          <span class=\"q-req\">Required</span>\n          <button class=\"toggle\" aria-label=\"Required, on\"><span class=\"knob\"></span></button>\n          <button class=\"q-step\" aria-label=\"Move down\">\n            <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6.5 9.5l5.5 5.5 5.5-5.5\"/></svg>\n          </button>\n          <button class=\"q-step\" aria-label=\"Move up\">\n            <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6.5 14.5l5.5-5.5 5.5 5.5\"/></svg>\n          </button>\n        </div>\n      </div>\n\n      <div class=\"opts\">\n        <div class=\"opt-row\">\n          <div class=\"opt\">\n            <span class=\"opt-mark\"></span>\n            <input class=\"opt-input\" type=\"text\" value=\"The welcome doc\" aria-label=\"Option one\">\n            <button class=\"opt-del\" aria-label=\"Remove option\">\n              <svg width=\"9\" height=\"9\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\"><path d=\"M7 7l10 10M17 7L7 17\"/></svg>\n            </button>\n          </div>\n          <span class=\"opt-grip\">\n            <svg width=\"8\" height=\"14\" viewBox=\"0 0 8 14\" fill=\"currentColor\"><circle cx=\"1.6\" cy=\"2\" r=\"1.3\"/><circle cx=\"6.4\" cy=\"2\" r=\"1.3\"/><circle cx=\"1.6\" cy=\"7\" r=\"1.3\"/><circle cx=\"6.4\" cy=\"7\" r=\"1.3\"/><circle cx=\"1.6\" cy=\"12\" r=\"1.3\"/><circle cx=\"6.4\" cy=\"12\" r=\"1.3\"/></svg>\n          </span>\n        </div>\n\n        <div class=\"opt-row\">\n          <div class=\"opt\">\n            <span class=\"opt-mark\"></span>\n            <input class=\"opt-input\" type=\"text\" value=\"Pairing with a buddy\" aria-label=\"Option two\">\n            <button class=\"opt-del\" aria-label=\"Remove option\">\n              <svg width=\"9\" height=\"9\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\"><path d=\"M7 7l10 10M17 7L7 17\"/></svg>\n            </button>\n          </div>\n          <span class=\"opt-grip\">\n            <svg width=\"8\" height=\"14\" viewBox=\"0 0 8 14\" fill=\"currentColor\"><circle cx=\"1.6\" cy=\"2\" r=\"1.3\"/><circle cx=\"6.4\" cy=\"2\" r=\"1.3\"/><circle cx=\"1.6\" cy=\"7\" r=\"1.3\"/><circle cx=\"6.4\" cy=\"7\" r=\"1.3\"/><circle cx=\"1.6\" cy=\"12\" r=\"1.3\"/><circle cx=\"6.4\" cy=\"12\" r=\"1.3\"/></svg>\n          </span>\n        </div>\n\n        <div class=\"opt-row\">\n          <div class=\"opt\">\n            <span class=\"opt-mark\"></span>\n            <input class=\"opt-input\" type=\"text\" value=\"The first-week checklist\" aria-label=\"Option three\">\n            <button class=\"opt-del\" aria-label=\"Remove option\">\n              <svg width=\"9\" height=\"9\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\"><path d=\"M7 7l10 10M17 7L7 17\"/></svg>\n            </button>\n          </div>\n          <span class=\"opt-grip\">\n            <svg width=\"8\" height=\"14\" viewBox=\"0 0 8 14\" fill=\"currentColor\"><circle cx=\"1.6\" cy=\"2\" r=\"1.3\"/><circle cx=\"6.4\" cy=\"2\" r=\"1.3\"/><circle cx=\"1.6\" cy=\"7\" r=\"1.3\"/><circle cx=\"6.4\" cy=\"7\" r=\"1.3\"/><circle cx=\"1.6\" cy=\"12\" r=\"1.3\"/><circle cx=\"6.4\" cy=\"12\" r=\"1.3\"/></svg>\n          </span>\n        </div>\n\n        <div class=\"opt-row\">\n          <div class=\"opt\">\n            <span class=\"opt-mark\"></span>\n            <input class=\"opt-input\" type=\"text\" placeholder=\"Type an option\" aria-label=\"Option four\">\n            <button class=\"opt-del\" aria-label=\"Remove option\">\n              <svg width=\"9\" height=\"9\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\"><path d=\"M7 7l10 10M17 7L7 17\"/></svg>\n            </button>\n          </div>\n          <span class=\"opt-grip\">\n            <svg width=\"8\" height=\"14\" viewBox=\"0 0 8 14\" fill=\"currentColor\"><circle cx=\"1.6\" cy=\"2\" r=\"1.3\"/><circle cx=\"6.4\" cy=\"2\" r=\"1.3\"/><circle cx=\"1.6\" cy=\"7\" r=\"1.3\"/><circle cx=\"6.4\" cy=\"7\" r=\"1.3\"/><circle cx=\"1.6\" cy=\"12\" r=\"1.3\"/><circle cx=\"6.4\" cy=\"12\" r=\"1.3\"/></svg>\n          </span>\n        </div>\n\n        <button class=\"opt-add\">\n          <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\"><path d=\"M12 5.5v13M5.5 12h13\"/></svg>\n          Add option\n        </button>\n      </div>\n    </section>\n\n    <section class=\"card card--end\">\n      <h2 class=\"end-title\">Thanks for the read on your first fortnight</h2>\n      <p class=\"end-sub\">We group answers before anyone sees them, then post what changed in the team channel by Friday.</p>\n    </section>\n\n  </main>\n</div>\n\n<button class=\"launcher\" aria-label=\"Open support chat\">\n  <svg width=\"21\" height=\"21\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"><path d=\"M19 11.4c0 3.5-3.1 6.3-7 6.3-.9 0-1.8-.15-2.6-.43L5 18.8l1.3-3.4A6 6 0 015 11.4c0-3.5 3.1-6.3 7-6.3s7 2.8 7 6.3z\"/></svg>\n</button>\n\n",
