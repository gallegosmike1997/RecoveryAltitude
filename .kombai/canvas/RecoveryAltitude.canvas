>\n\n      <button class=\"add-btn\" data-kid=\"149\">Share a contribution</button>\n\n      <div class=\"contrib-grid\" data-kid=\"150\">\n        <div class=\"card card-big swirl\" role=\"img\" aria-label=\"Contributions — misty green ridge trail, photo by chiến bá on Pexels\" style=\"background-image:linear-gradient(160deg, rgba(10,26,24,0.55), rgba(10,26,24,0.84)), url('https://images.pexels.com/photos/15355594/pexels-photo-15355594.jpeg?auto=compress&cs=tinysrgb&w=900');background-size:cover;background-position:center;\" data-kid=\"151\">\n          <span class=\"top-icon\" data-kid=\"152\">\n            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#e2ede9\" stroke-width=\"2\" data-kid=\"153\"><path d=\"M20.8 4.6a5.5 5.5 0 00-7.8 0L12 5.6l-1-1a5.5 5.5 0 10-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 000-7.8z\" data-kid=\"154\"></path></svg>\n          </span>\n          <div data-kid=\"155\">\n            <div class=\"num\" data-kid=\"156\">12</div>\n            <div class=\"cap\" data-kid=\"157\">Contributions</div>\n          </div>\n        </div>\n\n        <div class=\"card card-highlights swirl\" role=\"img\" aria-label=\"Highlights — green mountain ridge, photo by Mario Vogt on Pexels\" style=\"background-image:linear-gradient(160deg, rgba(10,26,24,0.42), rgba(10,26,24,0.78)), url('https://images.pexels.com/photos/13183202/pexels-photo-13183202.jpeg?auto=compress&cs=tinysrgb&w=600');background-size:cover;background-position:center;\" data-kid=\"158\">\n          <span class=\"top-icon\" data-kid=\"159\">\n            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"#142f2d\" data-kid=\"160\"><path d=\"M12 3l2.4 5.9 6.4.5-4.9 4.1 1.6 6.2L12 16.4l-5.5 3.3 1.6-6.2-4.9-4.1 6.4-.5z\" data-kid=\"161\"></path></svg>\n          </span>\n          <div data-kid=\"162\">\n            <div class=\"num\" data-kid=\"163\">2</div>\n            <div class=\"cap\" data-kid=\"164\">Highlights</div>\n          </div>\n        </div>\n\n        \n        <div class=\"card card-photo\" role=\"img\" aria-label=\"Cypress Ridge Overlook — forested mountain ridge view, photo by Nathaniel Villaire on Unsplash\" style=\"background-image:url('https://images.unsplash.com/photo-1664059685138-43e1eb14b833?crop=entropy&amp;cs=srgb&amp;fm=jpg&amp;q=80&amp;w=700');background-size:cover;background-position:center;\" data-kid=\"165\">\n          <div class=\"photo-caption\" data-kid=\"166\">\n            <div class=\"place\" data-kid=\"167\">Cypress Ridge Overlook</div>\n            <div class=\"likes\" data-kid=\"168\">\n              <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"#fff\" data-kid=\"169\"><path d=\"M2 21h4V9H2zM22 10a2 2 0 00-2-2h-6.3l.9-4.4V3a1.5 1.5 0 00-1.5-1.5c-.4 0-.8.2-1 .5L8 9v12h11a2 2 0 002-1.7l1-7.6z\" data-kid=\"170\"></path></svg>\n              3\n            </div>\n          </div>\n        </div>\n\n        <div class=\"card card-upvotes\" role=\"img\" aria-label=\"Upvotes — foggy mountain path, photo by Tom Swinnen on Pexels\" style=\"background-image:linear-gradient(160deg, rgba(210,230,222,0.55), rgba(150,190,180,0.9)), url('https://images.pexels.com/photos/2347454/pexels-photo-2347454.jpeg?auto=compress&cs=tinysrgb&w=600');background-size:cover;background-position:center;\" data-kid=\"171\">\n          <span class=\"top-icon\" data-kid=\"172\">\n            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"#142f2d\" data-kid=\"173\"><path d=\"M2 21h4V9H2zM22 10a2 2 0 00-2-2h-6.3l.9-4.4V3a1.5 1.5 0 00-1.5-1.5c-.4 0-.8.2-1 .5L8 9v12h11a2 2 0 002-1.7l1-7.6z\" data-kid=\"174\"></path></svg>\n          </span>\n          <div data-kid=\"175\">\n            <div class=\"num\" data-kid=\"176\">1</div>\n            <div class=\"cap\" data-kid=\"177\">Upvotes</div>\n          </div>\n        </div>\n      </div>\n    </main>\n  </div>\n\n  <footer class=\"footer-bar\" data-kid=\"178\">\n    <div class=\"footer-brand\" data-kid=\"179\">\n      <span class=\"mark\" data-kid=\"180\">\n        <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" data-kid=\"181\"><path d=\"M3 20L9 8L13 15L16 10L21 20H3Z\" fill=\"#e2ede9\" data-kid=\"182\"></path></svg>\n      </span>\n      Ridgeline\n    </div>\n    <div class=\"footer-note\" data-kid=\"183\">Design system reference</div>\n  </footer>\n\n",
