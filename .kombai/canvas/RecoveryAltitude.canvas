        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&family=Barlow+Condensed:wght@500;600;700&display=swap');\n\n.ra-condensed { font-family: 'Barlow Condensed', sans-serif; }\n.ra-readable { font-family: 'Atkinson Hyperlegible', sans-serif; }\n.ra-brand-plate { clip-path: polygon(0 0, 100% 0, 100% 78%, 93% 100%, 0 100%); }\n.ra-action-post { clip-path: polygon(0 0, 91% 0, 100% 15%, 100% 100%, 0 100%); }\n.ra-action-post:hover { background-color: #D99A32; }\n.ra-action-post .ra-arrow-compartment { background-color: #10232E; }\n.ra-action-post:hover .ra-arrow-compartment { background-color: #205F67; }\n.ra-route-link { position: relative; }\n.ra-route-link::after { content: ''; position: absolute; left: 0; right: 0; bottom: -2px; height: 2px; background: #10232E; transform: scaleX(0); transform-origin: left; transition: transform 160ms ease; }\n.ra-route-link:hover::after, .ra-route-link:focus-visible::after { transform: scaleX(1); }\n.ra-route-link[aria-current='page']::after { transform: scaleX(1); background: #F1B34C; }\n.ra-route-link:focus-visible, .ra-action-post:focus-visible, .ra-menu-button:focus-visible { outline: 2px solid #FBFAF2; outline-offset: 3px; }\n.ra-menu-button:focus-visible { outline-color: #F1B34C; }\n.ra-mobile-panel[hidden] { display: none; }\n.ra-mobile-panel { animation: ra-panel-in 160ms ease-out both; }\n@keyframes ra-panel-in { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: translateY(0); } }\n@media (max-width: 767px) {\n  .ra-desktop-shell { display: none; }\n  .ra-mobile-shell { display: grid; }\n  .ra-header-frame { height: 72px; }\n  .ra-brand-plate.ra-mobile-brand { clip-path: polygon(0 0, 100% 0, 100% 82%, 94% 100%, 0 100%); }\n  .ra-mobile-panel { display: block; }\n}\n@media (min-width: 768px) {\n  .ra-desktop-shell { display: grid; }\n  .ra-mobile-shell { display: none; }\n}\n@media (max-width: 389px) {\n  .ra-mobile-cta { display: none; }\n  .ra-panel-cta { display: flex; }\n}\n@media (min-width: 390px) and (max-width: 767px) {\n  .ra-mobile-cta { display: flex; }\n  .ra-panel-cta { display: none; }\n}\n@media (prefers-reduced-motion: reduce) {\n  .ra-route-link::after, .ra-mobile-panel { transition: none; animation: none; }\n}\n</style>\n<link data-kid=\"1\" data-name=\"google fonts stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"min-h-[420px] w-full bg-[#FBFAF2] text-[#10232E]\" data-kid=\"2\" data-name=\"site main container\">\n    <header aria-label=\"Recovery Altitude site header\" class=\"ra-header-frame relative h-[126px] w-full bg-[#10232E] text-[#FBFAF2]\" data-kid=\"2-1\" data-name=\"header frame container\">\n        <div aria-hidden=\"true\" class=\"absolute inset-x-0 top-0 z-30 h-[4px] bg-[#205F67]\" data-kid=\"2-1-1\" data-name=\"header top accent border\">\n        </div>\n        <div class=\"ra-desktop-shell relative mx-auto h-full max-w-[1240px] grid-cols-[300px_minmax(0,1fr)_194px] gap-x-7 px-5\" data-kid=\"2-1-2\" data-name=\"desktop navigation shell\">\n            <a aria-label=\"Recovery Altitude home\" class=\"ra-brand-plate relative z-20 mt-0 block h-[108px] w-[300px] overflow-hidden bg-[#FBFAF2]\" data-kid=\"2-1-2-1\" data-name=\"desktop brand logo link\" href=\"#home\">\n                <img alt=\"Recovery Altitude home\" class=\"absolute left-[64px] top-[-26px] h-[170px] w-[170px] max-w-none object-contain\" data-kid=\"2-1-2-1-1\" data-name=\"desktop logo image\" decoding=\"async\" loading=\"lazy\" onerror=\"this.hidden=true;this.nextElementSibling.hidden=false;\" src=\"/api/local/images/.kombai/canvas/assets/46e0ab9b748cbb2216d689a6ff64efa3e9c519ebdac355d9316e40df16a013c1.jpg\"/>\n                <span class=\"ra-condensed absolute inset-0 hidden items-center justify-center px-8 text-center text-[24px] font-bold uppercase tracking-[0.08em] text-[#10232E]\" data-kid=\"2-1-2-1-2\" data-name=\"desktop brand name text\" hidden=\"\">\n                    Recovery Altitude\n                </span>\n            </a>\n            <div class=\"flex min-w-0 flex-col justify-between\" data-kid=\"2-1-2-2\" data-name=\"desktop secondary header section\">\n                <p class=\"ra-readable pt-[22px] text-[13px] leading-[1.2] tracking-[0.02em] text-[#FBFAF2]\" data-kid=\"2-1-2-2-1\" data-name=\"desktop subheader slogan text\">\n                    Outdoor recovery & altitude wellness\n                </p>\n                <nav aria-label=\"Primary navigation\" class=\"h-[66px] border-b-2 border-[#4B817E]\" data-kid=\"2-1-2-2-2\" data-name=\"desktop main navigation\">\n                    <ul class=\"flex h-full items-end gap-x-[26px] whitespace-nowrap\" data-kid=\"2-1-2-2-2-1\" data-name=\"desktop navigation menu list\">\n                        <li data-kid=\"2-1-2-2-2-1-1\" data-name=\"desktop navigation item 1\">\n                            <a class=\"ra-route-link ra-condensed relative inline-flex min-h-[48px] items-center text-[16px] font-semibold tracking-[0.015em] text-[#FBFAF2] hover:text-[#F1B34C]\" data-kid=\"2-1-2-2-2-1-1-1\" data-name=\"desktop navigation link 1\" href=\"#approach\">\n                                Our approach\n                            </a>\n                        </li>\n                        <li data-kid=\"2-1-2-2-2-1-2\" data-name=\"desktop navigation item 2\">\n                            <a aria-current=\"page\" class=\"ra-route-link ra-condensed relative inline-flex min-h-[48px] items-center text-[16px] font-semibold tracking-[0.015em] text-[#F1B34C]\" data-kid=\"2-1-2-2-2-1-2-1\" data-name=\"desktop navigation link 2\" href=\"#programs\">\n                                Programs\n                                <span aria-hidden=\"true\" class=\"absolute -bottom-[8px] left-1/2 flex -translate-x-1/2 gap-1\" data-kid=\"2-1-2-2-2-1-2-1-1\" data-name=\"active page indicator wrapper\">\n                                    <span class=\"h-[5px] w-[5px] bg-[#F1B34C]\" data-kid=\"2-1-2-2-2-1-2-1-1-1\" data-name=\"active indicator dot 1\">\n                                    </span>\n                                    <span class=\"h-[5px] w-[5px] bg-[#F1B34C]\" data-kid=\"2-1-2-2-2-1-2-1-1-2\" data-name=\"active indicator dot 2\">\n                                    </span>\n                                </span>\n                            </a>\n                        </li>\n                        <li data-kid=\"2-1-2-2-2-1-3\" data-name=\"desktop navigation item 3\">\n                            <a class=\"ra-route-link ra-condensed relative inline-flex min-h-[48px] items-center text-[16px] font-semibold tracking-[0.015em] text-[#FBFAF2] hover:text-[#F1B34C]\" data-kid=\"2-1-2-2-2-1-3-1\" data-name=\"desktop navigation link 3\" href=\"#altitude-wellness\">\n                                Altitude wellness\n                            </a>\n                        </li>\n                        <li data-kid=\"2-1-2-2-2-1-4\" data-name=\"desktop navigation item 4\">\n                            <a class=\"ra-route-link ra-condensed relative inline-flex min-h-[48px] items-center text-[16px] font-semibold tracking-[0.015em] text-[#FBFAF2] hover:text-[#F1B34C]\" data-kid=\"2-1-2-2-2-1-4-1\" data-name=\"desktop navigation link 4\" href=\"#recovery-support\">\n                                Recovery support\n                            </a>\n                        </li>\n                        <li data-kid=\"2-1-2-2-2-1-5\" data-name=\"desktop navigation item 5\">\n                            <a class=\"ra-route-link ra-condensed relative inline-flex min-h-[48px] items-center text-[16px] font-semibold tracking-[0.015em] text-[#FBFAF2] hover:text-[#F1B34C]\" data-kid=\"2-1-2-2-2-1-5-1\" data-name=\"desktop navigation link 5\" href=\"#resources\">\n                                Resources\n                            </a>\n                        </li>\n                    </ul>\n                </nav>\n            </div>\n            <a aria-label=\"Book a consultation\" class=\"ra-action-post ra-condensed mb-[22px] flex h-[54px] w-[194px] items-stretch justify-between bg-[#F1B34C] text-[17px] font-semibold tracking-[0.01em] text-[#10232E]\" data-kid=\"2-1-2-3\" data-name=\"desktop book consultation cta button\" href=\"#consultation\">\n                <span class=\"flex min-w-0 flex-1 items-center justify-center px-3\" data-kid=\"2-1-2-3-1\" data-name=\"desktop cta button text\">\n                    Book a consultation\n                </span>\n                <span aria-hidden=\"true\" class=\"ra-arrow-compartment flex w-[43px] shrink-0 items-center justify-center text-[19px] text-[#FBFAF2]\" data-kid=\"2-1-2-3-2\" data-name=\"desktop cta arrow icon container\">\n                    <i class=\"ti ti-arrow-up-right\" data-kid=\"2-1-2-3-2-1\" data-name=\"desktop cta arrow icon\">\n                    </i>\n                </span>\n            </a>\n        </div>\n        <div class=\"ra-mobile-shell relative h-[72px] grid-cols-[150px_minmax(0,1fr)_44px] items-center gap-x-2 px-3 pt-[4px]\" data-kid=\"2-1-3\" data-name=\"mobile header shell\">\n            <a aria-label=\"Recovery Altitude home\" class=\"ra-brand-plate ra-mobile-brand relative z-20 block h-[68px] w-[150px] overflow-hidden bg-[#FBFAF2]\" data-kid=\"2-1-3-1\" data-name=\"mobile brand logo link\" href=\"#home\">\n                <img alt=\"Recovery Altitude home\" class=\"absolute left-[19px] top-[-18px] h-[112px] w-[112px] max-w-none object-contain\" data-kid=\"2-1-3-1-1\" data-name=\"mobile logo image\" decoding=\"async\" loading=\"lazy\" onerror=\"this.hidden=true;this.nextElementSibling.hidden=false;\" src=\"/api/local/images/.kombai/canvas/assets/46e0ab9b748cbb2216d689a6ff64efa3e9c519ebdac355d9316e40df16a013c1.jpg\"/>\n                <span class=\"ra-condensed absolute inset-0 hidden items-center justify-center px-3 text-center text-[17px] font-bold uppercase tracking-[0.06em] text-[#10232E]\" data-kid=\"2-1-3-1-2\" data-name=\"mobile brand name text\" hidden=\"\">\n                    Recovery Altitude\n                </span>\n            </a>\n            <a aria-label=\"Book a consultation\" class=\"ra-mobile-cta ra-action-post ra-condensed h-[42px] min-w-0 items-stretch justify-between bg-[#F1B34C] text-[14px] font-semibold tracking-[0.01em] text-[#10232E]\" data-kid=\"2-1-3-2\" data-name=\"mobile book consultation cta button\" href=\"#consultation\">\n                <span class=\"flex min-w-0 flex-1 items-center justify-center whitespace-nowrap px-2\" data-kid=\"2-1-3-2-1\" data-name=\"mobile cta button text\">\n                    Book a consultation\n                </span>\n                <span aria-hidden=\"true\" class=\"ra-arrow-compartment flex w-[32px] shrink-0 items-center justify-center text-[17px] text-[#FBFAF2]\" data-kid=\"2-1-3-2-2\" data-name=\"mobile cta arrow icon container\">\n                    <i class=\"ti ti-arrow-up-right\" data-kid=\"2-1-3-2-2-1\" data-name=\"mobile cta arrow icon\">\n                    </i>\n                </span>\n            </a>\n            <button aria-controls=\"ra-mobile-panel\" aria-expanded=\"false\" aria-label=\"Menu\" class=\"ra-menu-button flex h-[44px] w-[44px] items-center justify-center border border-[#4B817E] bg-[#10232E] text-[22px] text-[#FBFAF2]\" data-dynamic=\"true\" data-kid=\"2-1-3-3\" data-menu-button=\"\" data-name=\"mobile menu toggle button\" data-reason=\"aria-label, aria-expanded, and icon class replaced by interaction script\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-menu-2\" data-dynamic=\"true\" data-kid=\"2-1-3-3-1\" data-menu-icon=\"\" data-name=\"mobile menu toggle icon\" data-reason=\"icon class replaced by interaction script\">\n                </i>\n            </button>\n        </div>\n        <div class=\"ra-mobile-panel border-b-4 border-[#205F67] bg-[#10232E] px-4 pb-5 pt-4\" data-dynamic=\"true\" data-kid=\"2-1-4\" data-name=\"mobile navigation menu panel\" data-reason=\"hidden state toggled by interaction script\" hidden=\"\" id=\"ra-mobile-panel\">\n            <p class=\"ra-readable mb-4 max-w-[320px] text-[13px] leading-[1.25] tracking-[0.02em] text-[#FBFAF2]\" data-kid=\"2-1-4-1\" data-name=\"mobile subheader slogan text\">\n                Outdoor recovery & altitude wellness\n            </p>\n            <a aria-label=\"Book a consultation\" class=\"ra-panel-cta ra-action-post ra-condensed mb-5 hidden h-[52px] w-full items-stretch justify-between bg-[#F1B34C] text-[16px] font-semibold text-[#10232E]\" data-kid=\"2-1-4-2\" data-name=\"mobile panel consultation cta button\" href=\"#consultation\">\n                <span class=\"flex flex-1 items-center px-5\" data-kid=\"2-1-4-2-1\" data-name=\"mobile panel cta button text\">\n                    Book a consultation\n                </span>\n                <span aria-hidden=\"true\" class=\"ra-arrow-compartment flex w-[48px] items-center justify-center text-[19px] text-[#FBFAF2]\" data-kid=\"2-1-4-2-2\" data-name=\"mobile panel cta arrow icon container\">\n                    <i class=\"ti ti-arrow-up-right\" data-kid=\"2-1-4-2-2-1\" data-name=\"mobile panel cta arrow icon\">\n                    </i>\n                </span>\n            </a>\n            <nav aria-label=\"Mobile primary navigation\" data-kid=\"2-1-4-3\" data-name=\"mobile primary navigation\">\n                <ol class=\"m-0 list-none p-0\" data-kid=\"2-1-4-3-1\" data-name=\"mobile navigation link list\">\n                    <li class=\"border-t border-[#4B817E] border-opacity-60\" data-kid=\"2-1-4-3-1-1\" data-name=\"mobile navigation link item 1\">\n                        <a class=\"ra-readable flex min-h-[54px] items-center gap-4 text-[16px] text-[#FBFAF2] hover:text-[#F1B34C]\" data-kid=\"2-1-4-3-1-1-1\" data-name=\"mobile navigation link 1\" href=\"#approach\">\n                            <span class=\"ra-condensed w-8 text-[13px] tabular-nums text-[#4B817E]\" data-kid=\"2-1-4-3-1-1-1-1\" data-name=\"mobile navigation index 1\">\n                                01\n                            </span>\n                            <span data-kid=\"2-1-4-3-1-1-1-2\" data-name=\"mobile navigation link text 1\">\n                                Our approach\n                            </span>\n                        </a>\n                    </li>\n                    <li class=\"border-t border-[#4B817E] border-opacity-60\" data-kid=\"2-1-4-3-1-2\" data-name=\"mobile navigation link item 2\">\n                        <a aria-current=\"page\" class=\"ra-readable flex min-h-[54px] items-center gap-4 text-[16px] text-[#F1B34C]\" data-kid=\"2-1-4-3-1-2-1\" data-name=\"mobile navigation link 2\" href=\"#programs\">\n                            <span class=\"ra-condensed w-8 bg-[#F1B34C] px-1 py-0.5 text-center text-[13px] tabular-nums text-[#10232E]\" data-kid=\"2-1-4-3-1-2-1-1\" data-name=\"mobile navigation active index 2\">\n                                02\n                            </span>\n                            <span data-kid=\"2-1-4-3-1-2-1-2\" data-name=\"mobile navigation link text 2\">\n                                Programs\n                            </span>\n                        </a>\n                    </li>\n                    <li class=\"border-t border-[#4B817E] border-opacity-60\" data-kid=\"2-1-4-3-1-3\" data-name=\"mobile navigation link item 3\">\n                        <a class=\"ra-readable flex min-h-[54px] items-center gap-4 text-[16px] text-[#FBFAF2] hover:text-[#F1B34C]\" data-kid=\"2-1-4-3-1-3-1\" data-name=\"mobile navigation link 3\" href=\"#altitude-wellness\">\n                            <span class=\"ra-condensed w-8 text-[13px] tabular-nums text-[#4B817E]\" data-kid=\"2-1-4-3-1-3-1-1\" data-name=\"mobile navigation index 3\">\n                                03\n                            </span>\n                            <span data-kid=\"2-1-4-3-1-3-1-2\" data-name=\"mobile navigation link text 3\">\n                                Altitude wellness\n                            </span>\n                        </a>\n                    </li>\n                    <li class=\"border-t border-[#4B817E] border-opacity-60\" data-kid=\"2-1-4-3-1-4\" data-name=\"mobile navigation link item 4\">\n                        <a class=\"ra-readable flex min-h-[54px] items-center gap-4 text-[16px] text-[#FBFAF2] hover:text-[#F1B34C]\" data-kid=\"2-1-4-3-1-4-1\" data-name=\"mobile navigation link 4\" href=\"#recovery-support\">\n                            <span class=\"ra-condensed w-8 text-[13px] tabular-nums text-[#4B817E]\" data-kid=\"2-1-4-3-1-4-1-1\" data-name=\"mobile navigation index 4\">\n                                04\n                            </span>\n                            <span data-kid=\"2-1-4-3-1-4-1-2\" data-name=\"mobile navigation link text 4\">\n                                Recovery support\n                            </span>\n                        </a>\n                    </li>\n                    <li class=\"border-t border-[#4B817E] border-opacity-60\" data-kid=\"2-1-4-3-1-5\" data-name=\"mobile navigation link item 5\">\n                        <a class=\"ra-readable flex min-h-[54px] items-center gap-4 text-[16px] text-[#FBFAF2] hover:text-[#F1B34C]\" data-kid=\"2-1-4-3-1-5-1\" data-name=\"mobile navigation link 5\" href=\"#resources\">\n                            <span class=\"ra-condensed w-8 text-[13px] tabular-nums text-[#4B817E]\" data-kid=\"2-1-4-3-1-5-1-1\" data-name=\"mobile navigation index 5\">\n                                05\n                            </span>\n                            <span data-kid=\"2-1-4-3-1-5-1-2\" data-name=\"mobile navigation link text 5\">\n                                Resources\n                            </span>\n                        </a>\n                    </li>\n                </ol>\n            </nav>\n        </div>\n    </header>\n    <main aria-label=\"Page continuation\" class=\"h-[294px] border-t-2 border-[#205F67] bg-[#FBFAF2]\" data-kid=\"2-2\" data-name=\"main content area\">\n        <div class=\"mx-auto h-full max-w-[1240px] px-5 py-8\" data-kid=\"2-2-1\" data-name=\"content wrapper\">\n            <div aria-hidden=\"true\" class=\"h-[2px] w-[84px] bg-[#F1B34C]\" data-kid=\"2-2-1-1\" data-name=\"content decoration bar\">\n            </div>\n        </div>\n    </main>\n</div>\n<script>\n    const menuButton = document.querySelector('[data-menu-button]');\n  const mobilePanel = document.getElementById('ra-mobile-panel');\n  const menuIcon = document.querySelector('[data-menu-icon]');\n  const mobileLinks = mobilePanel ? mobilePanel.querySelectorAll('a') : [];\n\n  function setMenuState(isOpen) {\n    if (!menuButton || !mobilePanel || !menuIcon) return;\n    mobilePanel.hidden = !isOpen;\n    menuButton.setAttribute('aria-expanded', String(isOpen));\n    menuButton.setAttribute('aria-label', isOpen ? 'Close menu' : 'Menu');\n    menuIcon.className = isOpen ? 'ti ti-x' : 'ti ti-menu-2';\n  }\n\n  if (menuButton) {\n    menuButton.addEventListener('click', function () {\n      setMenuState(mobilePanel.hidden);\n    });\n    document.addEventListener('keydown', function (event) {\n      if (event.key === 'Escape' && mobilePanel && !mobilePanel.hidden) {\n        setMenuState(false);\n        menuButton.focus();\n      }\n    });\n    mobileLinks.forEach(function (link) {\n      link.addEventListener('click', function () {\n        setMenuState(false);\n      });\n    });\n  }\n</script>\n",
