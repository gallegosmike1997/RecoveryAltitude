      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500&family=Atkinson+Hyperlegible:wght@400;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n</style>\n<div class=\"m-0 min-h-screen bg-[#fbfaf2] font-['Atkinson_Hyperlegible',sans-serif] text-[#10232e]\" data-kid=\"1\" data-name=\"page layout container\">\n    <header aria-label=\"Recovery Altitude site header\" class=\"relative z-20 bg-[#fbfaf2]\" data-kid=\"1-1\" data-name=\"site header\">\n        <div aria-hidden=\"true\" class=\"h-1 w-full bg-[#10232e]\" data-kid=\"1-1-1\" data-name=\"header top decorative bar\">\n        </div>\n        <div class=\"relative border-b border-[#10232e]/20 bg-[#fbfaf2]\" data-kid=\"1-1-2\" data-name=\"header main row container\">\n            <div class=\"relative mx-auto min-h-[74px] max-w-[1216px] px-6 sm:px-8 lg:px-10\" data-kid=\"1-1-2-1\" data-name=\"header content wrapper\">\n                <div class=\"absolute left-6 top-1/2 z-10 hidden -translate-y-1/2 sm:block lg:left-10\" data-kid=\"1-1-2-1-1\" data-name=\"header tagline container\">\n                    <p class=\"max-w-[190px] text-[13px] leading-[1.15] tracking-[0.02em] text-[#10232e]\" data-kid=\"1-1-2-1-1-1\" data-name=\"header tagline text\">\n                        Outdoor recovery\n                        <br class=\"hidden lg:block\" data-kid=\"1-1-2-1-1-1-1\"/>\n                        & altitude wellness\n                    </p>\n                </div>\n                <a aria-label=\"Recovery Altitude home\" class=\"group absolute left-1/2 top-[10px] z-30 flex h-[116px] w-[252px] -translate-x-1/2 items-center justify-center overflow-hidden border-2 border-[#10232e] bg-[#fbfaf2] [clip-path:polygon(0_6%,6%_0,94%_0,100%_6%,100%_92%,94%_100%,6%_100%,0_94%)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#f1b34c]\" data-kid=\"1-1-2-1-2\" data-name=\"home link wrapper\" href=\"#top\">\n                    <span aria-hidden=\"true\" class=\"pointer-events-none absolute inset-[7px] z-10 border border-dashed border-[#205f67]/70 [clip-path:polygon(0_5%,5%_0,95%_0,100%_5%,100%_95%,95%_100%,5%_100%,0_95%)]\" data-kid=\"1-1-2-1-2-1\" data-name=\"home link dashed border decorative element\">\n                    </span>\n                    <span aria-hidden=\"true\" class=\"pointer-events-none absolute inset-[9px] opacity-20 [background-image:linear-gradient(90deg,transparent_0,transparent_48%,#205f67_49%,transparent_50%,transparent_100%),linear-gradient(0deg,transparent_0,transparent_48%,#205f67_49%,transparent_50%,transparent_100%)] [background-size:9px_9px]\" data-kid=\"1-1-2-1-2-2\" data-name=\"home link crosshatch pattern decorative element\">\n                    </span>\n                    <img alt=\"Recovery Altitude home\" class=\"relative z-20 block h-[210px] w-[210px] max-w-none object-contain [transform:translateY(-34px)] transition-transform duration-300 group-hover:scale-[1.02]\" data-kid=\"1-1-2-1-2-3\" data-name=\"home logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/.kombai/canvas/assets/46e0ab9b748cbb2216d689a6ff64efa3e9c519ebdac355d9316e40df16a013c1.jpg\"/>\n                    <span class=\"sr-only\" data-kid=\"1-1-2-1-2-4\" data-name=\"home link accessible name\">\n                        RECOVERY ALTITUDE\n                    </span>\n                </a>\n                <div class=\"absolute right-6 top-1/2 z-20 hidden -translate-y-1/2 items-center lg:right-10 md:flex\" data-kid=\"1-1-2-1-3\" data-name=\"desktop consultation button container\">\n                    <a class=\"group inline-flex min-h-[46px] items-center gap-4 bg-[#f1b34c] px-5 text-[15px] font-['Barlow_Condensed',sans-serif] font-semibold tracking-[0.045em] text-[#10232e] [clip-path:polygon(0_0,94%_0,100%_24%,100%_100%,0_100%)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[#10232e] hover:bg-[#d99a32]\" data-kid=\"1-1-2-1-3-1\" data-name=\"desktop book consultation button\" href=\"#consultation\">\n                        <span data-kid=\"1-1-2-1-3-1-1\">\n                            Book a consultation\n                        </span>\n                        <span class=\"inline-flex h-5 w-5 items-center justify-center border-l border-[#10232e]/50 pl-3 text-[18px] leading-none group-hover:border-[#205f67]\" data-kid=\"1-1-2-1-3-1-2\">\n                            <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right block h-[18px] w-[18px] text-[#10232e]\" data-kid=\"1-1-2-1-3-1-2-1\" data-name=\"arrow icon\">\n                            </i>\n                        </span>\n                    </a>\n                </div>\n                <div class=\"absolute right-4 top-1/2 z-30 flex -translate-y-1/2 items-center gap-2 md:hidden\" data-kid=\"1-1-2-1-4\" data-name=\"mobile menu and booking container\">\n                    <a class=\"hidden min-h-[44px] items-center bg-[#f1b34c] px-3 text-[14px] font-['Barlow_Condensed',sans-serif] font-semibold tracking-[0.02em] text-[#10232e] [clip-path:polygon(0_0,94%_0,100%_24%,100%_100%,0_100%)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[#10232e] min-[390px]:inline-flex\" data-kid=\"1-1-2-1-4-1\" data-name=\"mobile book consultation button\" href=\"#consultation\">\n                        Book a consultation\n                    </a>\n                    <button aria-controls=\"mobile-route-register\" aria-expanded=\"false\" aria-label=\"Menu\" class=\"inline-flex h-11 min-h-[44px] w-11 min-w-[44px] items-center justify-center border border-[#10232e] bg-[#fbfaf2] text-[#10232e] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[#f1b34c]\" data-dynamic=\"true\" data-kid=\"1-1-2-1-4-2\" data-name=\"mobile menu toggle button\" data-reason=\"aria-expanded attribute, aria-label, and child icon visibility toggled by script\" id=\"menu-toggle\" type=\"button\">\n                        <span class=\"inline-flex h-[20px] w-[20px] items-center justify-center text-[20px] leading-none\" data-dynamic=\"true\" data-kid=\"1-1-2-1-4-2-1\" data-name=\"menu icon container\" data-reason=\"visibility and display class toggled by script\" id=\"menu-icon\">\n                            <i aria-hidden=\"true\" class=\"ti ti-menu-2 block h-[20px] w-[20px] text-[#10232e]\" data-kid=\"1-1-2-1-4-2-1-1\" data-name=\"menu hamburger icon\">\n                            </i>\n                        </span>\n                        <span class=\"hidden h-[20px] w-[20px] items-center justify-center text-[20px] leading-none\" data-dynamic=\"true\" data-kid=\"1-1-2-1-4-2-2\" data-name=\"close icon container\" data-reason=\"visibility and display class toggled by script\" id=\"close-icon\">\n                            <i aria-hidden=\"true\" class=\"ti ti-x block h-[20px] w-[20px] text-[#10232e]\" data-kid=\"1-1-2-1-4-2-2-1\" data-name=\"close x icon\">\n                            </i>\n                        </span>\n                        <span class=\"sr-only\" data-dynamic=\"true\" data-kid=\"1-1-2-1-4-2-3\" data-name=\"mobile menu accessible label\" data-reason=\"text content updated by script\" id=\"menu-label\">\n                            Menu\n                        </span>\n                    </button>\n                </div>\n            </div>\n        </div>\n        <div class=\"hidden h-11 bg-[#205f67] md:block\" data-kid=\"1-1-3\" data-name=\"desktop navigation container\">\n            <nav aria-label=\"Primary navigation\" class=\"mx-auto h-full max-w-[1216px] px-6 sm:px-8 lg:px-10\" data-kid=\"1-1-3-1\" data-name=\"desktop primary navigation\">\n                <ul class=\"flex h-full items-stretch gap-5 lg:gap-7\" data-kid=\"1-1-3-1-1\" data-name=\"desktop navigation list\">\n                    <li class=\"h-full\" data-kid=\"1-1-3-1-1-1\">\n                        <a aria-current=\"page\" class=\"group flex h-full min-h-[44px] items-center gap-2 border-b-[3px] border-[#f1b34c] px-1 text-[15px] font-['Barlow_Condensed',sans-serif] font-semibold tracking-[0.045em] text-[#10232e] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-4px] focus-visible:outline-[#fbfaf2]\" data-kid=\"1-1-3-1-1-1-1\" href=\"#programs\">\n                            <span class=\"inline-flex min-w-[25px] items-center justify-center bg-[#f1b34c] px-1 font-['IBM_Plex_Mono',monospace] text-[10px] leading-4 text-[#10232e]\" data-kid=\"1-1-3-1-1-1-1-1\">\n                                01\n                            </span>\n                            <span data-kid=\"1-1-3-1-1-1-1-2\">\n                                Programs\n                            </span>\n                        </a>\n                    </li>\n                    <li class=\"h-full\" data-kid=\"1-1-3-1-1-2\">\n                        <a class=\"group flex h-full min-h-[44px] items-center gap-2 border-b-[3px] border-transparent px-1 text-[15px] font-['Barlow_Condensed',sans-serif] font-medium tracking-[0.045em] text-[#fbfaf2] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-4px] focus-visible:outline-[#fbfaf2] hover:border-[#f1b34c] hover:text-[#f1b34c]\" data-kid=\"1-1-3-1-1-2-1\" href=\"#altitude-wellness\">\n                            <span class=\"font-['IBM_Plex_Mono',monospace] text-[10px] text-[#fbfaf2]/70\" data-kid=\"1-1-3-1-1-2-1-1\">\n                                02\n                            </span>\n                            <span data-kid=\"1-1-3-1-1-2-1-2\">\n                                Altitude wellness\n                            </span>\n                        </a>\n                    </li>\n                    <li class=\"h-full\" data-kid=\"1-1-3-1-1-3\">\n                        <a class=\"group flex h-full min-h-[44px] items-center gap-2 border-b-[3px] border-transparent px-1 text-[15px] font-['Barlow_Condensed',sans-serif] font-medium tracking-[0.045em] text-[#fbfaf2] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-4px] focus-visible:outline-[#fbfaf2] hover:border-[#f1b34c] hover:text-[#f1b34c]\" data-kid=\"1-1-3-1-1-3-1\" href=\"#recovery-support\">\n                            <span class=\"font-['IBM_Plex_Mono',monospace] text-[10px] text-[#fbfaf2]/70\" data-kid=\"1-1-3-1-1-3-1-1\">\n                                03\n                            </span>\n                            <span data-kid=\"1-1-3-1-1-3-1-2\">\n                                Recovery support\n                            </span>\n                        </a>\n                    </li>\n                    <li class=\"ml-2 h-full border-l border-[#4b817e] pl-5 lg:ml-4 lg:pl-7\" data-kid=\"1-1-3-1-1-4\">\n                        <a class=\"group flex h-full min-h-[44px] items-center gap-2 border-b-[3px] border-transparent px-1 text-[15px] font-['Barlow_Condensed',sans-serif] font-medium tracking-[0.045em] text-[#fbfaf2] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-4px] focus-visible:outline-[#fbfaf2] hover:border-[#f1b34c] hover:text-[#f1b34c]\" data-kid=\"1-1-3-1-1-4-1\" href=\"#approach\">\n                            <span class=\"font-['IBM_Plex_Mono',monospace] text-[10px] text-[#fbfaf2]/70\" data-kid=\"1-1-3-1-1-4-1-1\">\n                                04\n                            </span>\n                            <span data-kid=\"1-1-3-1-1-4-1-2\">\n                                Our approach\n                            </span>\n                        </a>\n                    </li>\n                    <li class=\"h-full\" data-kid=\"1-1-3-1-1-5\">\n                        <a class=\"group flex h-full min-h-[44px] items-center gap-2 border-b-[3px] border-transparent px-1 text-[15px] font-['Barlow_Condensed',sans-serif] font-medium tracking-[0.045em] text-[#fbfaf2] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-4px] focus-visible:outline-[#fbfaf2] hover:border-[#f1b34c] hover:text-[#f1b34c]\" data-kid=\"1-1-3-1-1-5-1\" href=\"#resources\">\n                            <span class=\"font-['IBM_Plex_Mono',monospace] text-[10px] text-[#fbfaf2]/70\" data-kid=\"1-1-3-1-1-5-1-1\">\n                                05\n                            </span>\n                            <span data-kid=\"1-1-3-1-1-5-1-2\">\n                                Resources\n                            </span>\n                        </a>\n                    </li>\n                    <li class=\"h-full\" data-kid=\"1-1-3-1-1-6\">\n                        <a class=\"group flex h-full min-h-[44px] items-center gap-2 border-b-[3px] border-transparent px-1 text-[15px] font-['Barlow_Condensed',sans-serif] font-medium tracking-[0.045em] text-[#fbfaf2] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-4px] focus-visible:outline-[#fbfaf2] hover:border-[#f1b34c] hover:text-[#f1b34c]\" data-kid=\"1-1-3-1-1-6-1\" href=\"#about\">\n                            <span class=\"font-['IBM_Plex_Mono',monospace] text-[10px] text-[#fbfaf2]/70\" data-kid=\"1-1-3-1-1-6-1-1\">\n                                06\n                            </span>\n                            <span data-kid=\"1-1-3-1-1-6-1-2\">\n                                About\n                            </span>\n                        </a>\n                    </li>\n                </ul>\n            </nav>\n        </div>\n        <div aria-hidden=\"true\" class=\"hidden border-b-4 border-[#10232e] bg-[#10232e] text-[#fbfaf2] md:hidden\" data-dynamic=\"true\" data-kid=\"1-1-4\" data-name=\"mobile menu drawer container\" data-reason=\"visibility (hidden class) and aria-hidden attribute toggled by script\" id=\"mobile-route-register\">\n            <div class=\"px-5 pb-6 pt-5\" data-kid=\"1-1-4-1\" data-name=\"mobile menu inner container\">\n                <p class=\"mb-4 max-w-[230px] text-[13px] leading-[1.2] text-[#fbfaf2]\" data-kid=\"1-1-4-1-1\" data-name=\"mobile menu tagline text\">\n                    Outdoor recovery & altitude wellness\n                </p>\n                <a class=\"mb-5 flex min-h-[50px] items-center justify-between bg-[#f1b34c] px-4 text-[16px] font-['Barlow_Condensed',sans-serif] font-semibold tracking-[0.04em] text-[#10232e] [clip-path:polygon(0_0,96%_0,100%_18%,100%_100%,0_100%)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[#fbfaf2]\" data-kid=\"1-1-4-1-2\" data-name=\"mobile book consultation button\" href=\"#consultation\">\n                    Book a consultation\n                    <span class=\"inline-flex h-5 w-5 items-center justify-center text-[18px]\" data-kid=\"1-1-4-1-2-1\">\n                        <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right block h-[18px] w-[18px] text-[#10232e]\" data-kid=\"1-1-4-1-2-1-1\">\n                        </i>\n                    </span>\n                </a>\n                <nav aria-label=\"Mobile primary navigation\" data-kid=\"1-1-4-1-3\" data-name=\"mobile primary navigation\">\n                    <ol class=\"m-0 list-none p-0\" data-kid=\"1-1-4-1-3-1\">\n                        <li data-kid=\"1-1-4-1-3-1-1\">\n                            <a aria-current=\"page\" class=\"flex min-h-[54px] items-center gap-4 border-t border-[#4b817e] text-[17px] font-['Barlow_Condensed',sans-serif] font-semibold tracking-[0.04em] text-[#f1b34c] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-3px] focus-visible:outline-[#fbfaf2]\" data-kid=\"1-1-4-1-3-1-1-1\" href=\"#programs\">\n                                <span class=\"inline-flex w-8 font-['IBM_Plex_Mono',monospace] text-[11px]\" data-kid=\"1-1-4-1-3-1-1-1-1\">\n                                    01\n                                </span>\n                                <span data-kid=\"1-1-4-1-3-1-1-1-2\">\n                                    Programs\n                                </span>\n                            </a>\n                        </li>\n                        <li data-kid=\"1-1-4-1-3-1-2\">\n                            <a class=\"flex min-h-[54px] items-center gap-4 border-t border-[#4b817e] text-[17px] font-['Barlow_Condensed',sans-serif] font-medium tracking-[0.04em] text-[#fbfaf2] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-3px] focus-visible:outline-[#fbfaf2]\" data-kid=\"1-1-4-1-3-1-2-1\" href=\"#altitude-wellness\">\n                                <span class=\"inline-flex w-8 font-['IBM_Plex_Mono',monospace] text-[11px] text-[#4b817e]\" data-kid=\"1-1-4-1-3-1-2-1-1\">\n                                    02\n                                </span>\n                                <span data-kid=\"1-1-4-1-3-1-2-1-2\">\n                                    Altitude wellness\n                                </span>\n                            </a>\n                        </li>\n                        <li data-kid=\"1-1-4-1-3-1-3\">\n                            <a class=\"flex min-h-[54px] items-center gap-4 border-t border-[#4b817e] text-[17px] font-['Barlow_Condensed',sans-serif] font-medium tracking-[0.04em] text-[#fbfaf2] focus-visible:outline focus-visible:outline-2px focus-visible:outline-offset-[-3px] focus-visible:outline-[#fbfaf2]\" data-kid=\"1-1-4-1-3-1-3-1\" href=\"#recovery-support\">\n                                <span class=\"inline-flex w-8 font-['IBM_Plex_Mono',monospace] text-[11px] text-[#4b817e]\" data-kid=\"1-1-4-1-3-1-3-1-1\">\n                                    03\n                                </span>\n                                <span data-kid=\"1-1-4-1-3-1-3-1-2\">\n                                    Recovery support\n                                </span>\n                            </a>\n                        </li>\n                        <li data-kid=\"1-1-4-1-3-1-4\">\n                            <a class=\"flex min-h-[54px] items-center gap-4 border-t border-[#4b817e] text-[17px] font-['Barlow_Condensed',sans-serif] font-medium tracking-[0.04em] text-[#fbfaf2] focus-visible:outline focus-visible:outline-2px focus-visible:outline-offset-[-3px] focus-visible:outline-[#fbfaf2]\" data-kid=\"1-1-4-1-3-1-4-1\" href=\"#approach\">\n                                <span class=\"inline-flex w-8 font-['IBM_Plex_Mono',monospace] text-[11px] text-[#4b817e]\" data-kid=\"1-1-4-1-3-1-4-1-1\">\n                                    04\n                                </span>\n                                <span data-kid=\"1-1-4-1-3-1-4-1-2\">\n                                    Our approach\n                                </span>\n                            </a>\n                        </li>\n                        <li data-kid=\"1-1-4-1-3-1-5\">\n                            <a class=\"flex min-h-[54px] items-center gap-4 border-t border-[#4b817e] text-[17px] font-['Barlow_Condensed',sans-serif] font-medium tracking-[0.04em] text-[#fbfaf2] focus-visible:outline focus-visible:outline-2px focus-visible:outline-offset-[-3px] focus-visible:outline-[#fbfaf2]\" data-kid=\"1-1-4-1-3-1-5-1\" href=\"#resources\">\n                                <span class=\"inline-flex w-8 font-['IBM_Plex_Mono',monospace] text-[11px] text-[#4b817e]\" data-kid=\"1-1-4-1-3-1-5-1-1\">\n                                    05\n                                </span>\n                                <span data-kid=\"1-1-4-1-3-1-5-1-2\">\n                                    Resources\n                                </span>\n                            </a>\n                        </li>\n                        <li data-kid=\"1-1-4-1-3-1-6\">\n                            <a class=\"flex min-h-[54px] items-center gap-4 border-t border-[#4b817e] text-[17px] font-['Barlow_Condensed',sans-serif] font-medium tracking-[0.04em] text-[#fbfaf2] focus-visible:outline focus-visible:outline-2px focus-visible:outline-offset-[-3px] focus-visible:outline-[#fbfaf2]\" data-kid=\"1-1-4-1-3-1-6-1\" href=\"#about\">\n                                <span class=\"inline-flex w-8 font-['IBM_Plex_Mono',monospace] text-[11px] text-[#4b817e]\" data-kid=\"1-1-4-1-3-1-6-1-1\">\n                                    06\n                                </span>\n                                <span data-kid=\"1-1-4-1-3-1-6-1-2\">\n                                    About\n                                </span>\n                            </a>\n                        </li>\n                    </ol>\n                </nav>\n            </div>\n        </div>\n    </header>\n    <main aria-label=\"Header continuation preview\" class=\"min-h-[350px] border-t border-[#10232e]/10 bg-[#fbfaf2]\" data-kid=\"1-2\" data-name=\"main content placeholder\" id=\"top\">\n    </main>\n    <script>\n        const menuToggle = document.getElementById('menu-toggle');\n    const mobileRouteRegister = document.getElementById('mobile-route-register');\n    const menuIcon = document.getElementById('menu-icon');\n    const closeIcon = document.getElementById('close-icon');\n    const menuLabel = document.getElementById('menu-label');\n    const mobileLinks = mobileRouteRegister ? mobileRouteRegister.querySelectorAll('a') : [];\n\n    function setMenuState(open) {\n      if (!menuToggle || !mobileRouteRegister) return;\n      menuToggle.setAttribute('aria-expanded', String(open));\n      menuToggle.setAttribute('aria-label', open ? 'Close menu' : 'Menu');\n      menuLabel.textContent = open ? 'Close menu' : 'Menu';\n      mobileRouteRegister.classList.toggle('hidden', !open);\n      mobileRouteRegister.setAttribute('aria-hidden', String(!open));\n      menuIcon.classList.toggle('hidden', open);\n      menuIcon.classList.toggle('inline-flex', !open);\n      closeIcon.classList.toggle('hidden', !open);\n      closeIcon.classList.toggle('inline-flex', open);\n    }\n\n    if (menuToggle) {\n      menuToggle.addEventListener('click', () => setMenuState(menuToggle.getAttribute('aria-expanded') !== 'true'));\n      document.addEventListener('keydown', (event) => {\n        if (event.key === 'Escape' && menuToggle.getAttribute('aria-expanded') === 'true') {\n          setMenuState(false);\n          menuToggle.focus();\n        }\n      });\n      mobileLinks.forEach((link) => link.addEventListener('click', () => {\n        if (window.innerWidth < 768) setMenuState(false);\n      }));\n      window.addEventListener('resize', () => {\n        if (window.innerWidth >= 768) setMenuState(false);\n      });\n    }\n    </script>\n</div>\n",
